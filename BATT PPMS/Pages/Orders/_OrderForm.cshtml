@model BATT_PPMS.Pages.Orders.OrderFormPageModel
@{
    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Where(m => !string.IsNullOrWhiteSpace(m)).ToList();
}

@if (errors.Count > 0)
{
    <div class="alert alert-danger" style="border-radius:12px;">
        <i class="bi bi-exclamation-triangle-fill" style="margin-right:8px;"></i>
        <strong>Không thể lưu đơn hàng:</strong>
        <ul style="margin:6px 0 0 18px;padding:0;">
            @foreach (var m in errors)
            {
                <li>@m</li>
            }
        </ul>
    </div>
}

<div class="card">
    <div class="card-body">
        <form method="post" id="orderForm" novalidate>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="sel-customer">Khách hàng <span class="required-star">*</span></label>
                    <select class="form-control" name="Input.CustomerId" id="sel-customer" required>
                        <option value="">-- Chọn khách hàng --</option>
                        @foreach (var c in Model.Customers)
                        {
                            <option value="@c.CustomerId" selected="@(Model.Input.CustomerId == c.CustomerId)">@c.CustomerName</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="sel-item">Sản phẩm / Hàng hoá <span class="required-star">*</span></label>
                    <select class="form-control" name="Input.InventoryId" id="sel-item" required>
                        <option value="">-- Chọn sản phẩm --</option>
                        @foreach (var i in Model.Items)
                        {
                            <option value="@i.InventoryId" data-stock="@i.Quantity" data-unit="@i.Unit"
                                    selected="@(Model.Input.InventoryId == i.InventoryId)">@i.ItemName (@i.ItemCode)</option>
                        }
                    </select>
                    <span class="form-hint" id="stock-hint">Chọn sản phẩm để xem tồn kho hiện tại.</span>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-quantity">Số lượng <span class="required-star">*</span></label>
                    <input class="form-control" type="number" name="Input.Quantity" id="inp-quantity" min="1" step="1" required
                           value="@Model.Input.Quantity" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-price">Đơn giá (₫) <span class="required-star">*</span></label>
                    <input class="form-control" type="number" name="Input.UnitPrice" id="inp-price" min="0.01" step="0.01" required
                           value="@(Model.Input.UnitPrice?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-date">Ngày đặt hàng <span class="required-star">*</span></label>
                    <input class="form-control" type="datetime-local" name="Input.OrderDate" id="inp-date" required
                           value="@(Model.Input.OrderDate?.ToString("yyyy-MM-ddTHH:mm"))" />
                </div>

                <div class="form-group">
                    <label class="form-label">Tổng tiền (tự động tính)</label>
                    <div class="info-box" style="font-size:16px;font-weight:700;" id="total-preview">0 ₫</div>
                </div>
            </div>

            <div class="form-actions" style="display:flex;gap:8px;margin-top:20px;">
                <button type="submit" class="btn btn-primary" id="btn-submit-order">
                    <i class="bi bi-check-lg"></i> @(Model.IsEdit ? "Lưu thay đổi" : "Tạo đơn hàng")
                </button>
                <a href="@(Model.IsEdit ? ViewData["CancelUrl"] : "/Orders/Index")" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        var item = document.getElementById('sel-item');
        var qty = document.getElementById('inp-quantity');
        var price = document.getElementById('inp-price');
        var hint = document.getElementById('stock-hint');
        var total = document.getElementById('total-preview');

        function fmt(n) { return n.toLocaleString('vi-VN', { maximumFractionDigits: 0 }); }

        function refresh() {
            var opt = item.options[item.selectedIndex];
            var stock = opt && opt.dataset.stock !== undefined ? parseInt(opt.dataset.stock, 10) : null;
            if (stock !== null && !isNaN(stock)) {
                hint.textContent = 'Tồn kho hiện tại: ' + fmt(stock) + ' ' + (opt.dataset.unit || '');
                qty.max = stock;
            } else {
                hint.textContent = 'Chọn sản phẩm để xem tồn kho hiện tại.';
                qty.removeAttribute('max');
            }
            var q = parseFloat(qty.value), p = parseFloat(price.value);
            total.textContent = (isNaN(q) || isNaN(p)) ? '0 ₫' : fmt(q * p) + ' ₫';
        }

        [item, qty, price].forEach(function (el) { el.addEventListener('input', refresh); el.addEventListener('change', refresh); });
        refresh();
    })();
</script>
