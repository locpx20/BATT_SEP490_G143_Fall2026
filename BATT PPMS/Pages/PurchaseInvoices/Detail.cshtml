@page
@model BATT_PPMS.Pages.PurchaseInvoices.DetailModel
@using System.Globalization
@{
    ViewData["Title"] = $"Yêu cầu thu mua {Model.InvoiceCode}";
    ViewData["ActivePage"] = "PurchaseInvoice";
    var vi = new CultureInfo("vi-VN");

    string BadgeStyle(string type) => type switch
    {
        "pending" or "wait_approval" => "background: #fffbeb; color: #b45309; border: 1px solid #fef3c7;",
        "warehouse" or "procuring" => "background: #ebf5ff; color: #1e40af; border: 1px solid #dbeafe;",
        "received" or "completed" => "background: #f0fdf4; color: #15803d; border: 1px solid #dcfce7;",
        "expired" => "background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1;",
        _ => "background: #fef2f2; color: #b91c1c; border: 1px solid #fee2e2;"
    };
    var labelStyle = "font-size: 12px; color: #64748b; margin-bottom: 2px;";
    var valueStyle = "font-size: 14px; font-weight: 700; color: #1e293b;";
    var cardStyle = "background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; margin-bottom: 16px;";
    var thStyle = "padding: 10px 12px; font-size: 12px; font-weight: 600; color: #475569; border-bottom: 1px solid #e2e8f0; background: #f8fafc; white-space: nowrap; text-align: left;";
    var tdStyle = "padding: 12px 12px; font-size: 12.5px; color: #1e293b; border-bottom: 1px solid #f1f5f9; vertical-align: middle;";
}

<div style="max-width: 1400px; margin: 0 auto;">
    <div style="font-size: 13px; color: #718096; margin-bottom: 8px;">
        <span style="color: #a0aec0;">BATT PPMS</span>
        <span style="margin: 0 6px; color: #cbd5e1;">/</span>
        <a href="/PurchaseInvoices/Index" style="color: #718096; text-decoration: none;">Danh sách yêu cầu thu mua</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" style="border-radius: 10px; font-size: 13px;">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" style="border-radius: 10px; font-size: 13px;">@Model.ErrorMessage</div>
    }

    <h1 style="font-size: 24px; font-weight: 700; color: #1a202c; margin-bottom: 20px;">Yêu cầu thu mua @Model.InvoiceCode</h1>

    <div style="display: grid; grid-template-columns: minmax(0, 3fr) minmax(250px, 1fr); gap: 16px; align-items: start;">
        <!-- Cột trái -->
        <div>
            <!-- Thông tin yêu cầu thu mua -->
            <div style="@cardStyle">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                    <h2 style="font-size: 16px; font-weight: 600; margin: 0;">Yêu cầu thu mua @Model.InvoiceCode</h2>
                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 9999px; font-size: 12px; font-weight: 500; @BadgeStyle(Model.StatusType)">
                        <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span>@Model.StatusText
                    </span>
                </div>
                <div class="pm-grid">
                    <div><div style="@labelStyle">Khối lượng cần mua</div><div style="@valueStyle">@Model.PlannedQuantity.ToString("N0", vi) kg</div></div>
                    <div><div style="@labelStyle">Giá trần</div><div style="@valueStyle">@Model.CeilingPrice.ToString("N0", vi) VNĐ / kg</div></div>
                    <div><div style="@labelStyle">Đã lập Phiếu mua hàng (PO)</div><div style="@valueStyle">@Model.WeighedTotal.ToString("N0", vi) kg (@Model.Receipts.Count PO)</div></div>
                    <div><div style="@labelStyle">Đã tạo Yêu cầu nhập kho (IR)</div><div style="@valueStyle; color: #1e40af;">@Model.InboundRequestedTotal.ToString("N0", vi) kg (@Model.InboundRequests.Count IR)</div></div>
                    <div><div style="@labelStyle">Đã nhập kho hoàn tất</div><div style="@valueStyle; color: #15803d;">@Model.InboundReceivedTotal.ToString("N0", vi) kg</div></div>
                    <div><div style="@labelStyle">Người tạo &amp; Thời điểm</div><div style="@valueStyle">@Model.CreatorName · @Model.CreatedAt.ToString("HH:mm dd/MM/yyyy")</div></div>
                    <div class="pm-full">
                        <div style="@labelStyle">Nhân viên được phân công &amp; Ghi chú thu mua</div>
                        @if (Model.StaffAssignments.Any())
                        {
                            <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 4px;">
                                @foreach (var sa in Model.StaffAssignments)
                                {
                                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px 10px;">
                                        <span style="font-size: 13.5px; font-weight: 700; color: #1e293b;">@sa.FullName</span>
                                        @if (!string.IsNullOrWhiteSpace(sa.Note))
                                        {
                                            <span style="font-size: 12px; color: #166534; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px; padding: 2px 8px;">
                                                Ghi chú: @sa.Note
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="font-size: 12px; color: #94a3b8;">(Không có ghi chú riêng)</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="@valueStyle">@Model.AssignedName</div>
                        }
                    </div>
                    <div class="pm-full">
                        <div style="@labelStyle">Hạn hiệu lực yêu cầu thu mua (hết ngày lập phiếu)</div>
                        <div style="font-size: 13px; font-weight: 700; color: @(Model.IsExpired ? "#b91c1c" : "#15803d");">
                            23:59 @Model.ExpiresAt.ToString("dd/MM/yyyy") @(Model.IsExpired ? "— Đã hết hạn" : "— Còn hiệu lực trong ngày")
                        </div>
                    </div>
                </div>
            </div>

            <!-- =========================================================================
                 BẢNG 1: DANH SÁCH PHIẾU MUA HÀNG (PURCHASE ORDER — PM-26xxx)
                 ========================================================================= -->
            <div style="@cardStyle">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 12px;">
                    <div>
                        <h2 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 3px 0;">
                            1. Bảng Phiếu mua hàng (Purchase Order — PM-26xxx)
                        </h2>
                        <div style="font-size: 12px; color: #64748b;">
                            Tổng @Model.WeighedTotal.ToString("N0", vi) kg qua @Model.Receipts.Count phiếu mua hàng. Sau khi Manager duyệt, một Phiếu mua hàng có thể tạo <strong>nhiều Yêu cầu nhập kho (IR-26xxx)</strong> theo từng đợt xe giao hàng.
                        </div>
                    </div>
                    @if (Model.CanCreateReceipt && Model.RemainingQuantity > 0)
                    {
                        <button type="button" onclick="openCreateNewReceiptModal()"
                                style="background: #1a4332; color: #fff; border: none; border-radius: 8px; font-size: 12.5px; font-weight: 600; padding: 8px 14px; cursor: pointer;">
                            + Tạo phiếu mua hàng (PO)
                        </button>
                    }
                </div>

                <div style="overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 10px;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr>
                                <th style="@thStyle">Mã PO</th>
                                <th style="@thStyle">Nhà cung cấp</th>
                                <th style="@thStyle">KL đặt mua</th>
                                <th style="@thStyle">Đã tạo IR / Còn lại</th>
                                <th style="@thStyle">Đơn giá &amp; Thành tiền</th>
                                <th style="@thStyle">Người tạo</th>
                                <th style="@thStyle">Trạng thái PO</th>
                                <th style="@thStyle">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Receipts.Any())
                            {
                                <tr>
                                    <td colspan="8" style="text-align: center; padding: 28px 16px; color: #94a3b8; font-size: 13px;">
                                        Chưa có phiếu mua hàng (Purchase Order) nào.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in Model.Receipts)
                                {
                                    <tr>
                                        <td style="@tdStyle">
                                            <span style="display: inline-flex; align-items: center; background: #faf4e8; border: 1px solid #ecdcc0; border-left: 4px solid #c88a2e; border-radius: 4px; padding: 3px 8px; font-family: ui-monospace, Consolas, monospace; font-size: 12px; font-weight: 700; color: #6d4d12;">
                                                @r.Code
                                            </span>
                                        </td>
                                        <td style="@tdStyle; font-weight: 600;">@r.SupplierName</td>
                                        <td style="@tdStyle; font-family: ui-monospace, Consolas, monospace; font-weight: 700;">
                                            @r.Quantity.ToString("N0", vi) kg
                                        </td>
                                        <td style="@tdStyle">
                                            <div style="font-size: 12px; font-weight: 600; color: #1e40af;">
                                                Đã tạo: @r.RequestedInboundQuantity.ToString("N0", vi) kg (@r.InboundRequestCount IR)
                                            </div>
                                            <div style="font-size: 11.5px; color: @(r.RemainingToRequestQuantity > 0 ? "#b45309" : "#15803d");">
                                                @(r.RemainingToRequestQuantity > 0
                                                    ? $"Còn lại: {r.RemainingToRequestQuantity.ToString("N0", vi)} kg"
                                                    : "Đã tạo đủ 100% IR")
                                            </div>
                                        </td>
                                        <td style="@tdStyle">
                                            <div style="font-family: ui-monospace, Consolas, monospace; font-weight: 600;">@r.Price.ToString("N0", vi) VNĐ/kg</div>
                                            <div style="font-size: 11.5px; color: #64748b;">Tổng: @r.Total.ToString("N0", vi) VNĐ</div>
                                        </td>
                                        <td style="@tdStyle">
                                            <div style="font-weight: 600;">@r.CreatedByName</div>
                                            <div style="font-size: 11.5px; color: #94a3b8;">@r.CreatedAt.ToString("HH:mm dd/MM/yyyy")</div>
                                        </td>
                                        <td style="@tdStyle">
                                            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 9999px; font-size: 12px; font-weight: 500; @BadgeStyle(r.StatusType)">
                                                <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span>@r.StatusText
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(r.RejectionReason))
                                            {
                                                <div style="margin-top: 4px; font-size: 11.5px; color: #b91c1c; max-width: 200px;">
                                                    <strong>Lý do:</strong> @r.RejectionReason
                                                </div>
                                            }
                                        </td>
                                        <td style="@tdStyle; white-space: nowrap;">
                                            <div style="display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                                                <a href="javascript:void(0)" class="po-detail-link"
                                                   data-code="@r.Code"
                                                   data-supplier="@r.SupplierName"
                                                   data-qty="@r.Quantity.ToString("N0", vi)"
                                                   data-req-ir="@r.RequestedInboundQuantity.ToString("N0", vi)"
                                                   data-rec-ir="@r.ReceivedInboundQuantity.ToString("N0", vi)"
                                                   data-ir-count="@r.InboundRequestCount"
                                                   data-ir-codes="@r.InboundCodesSummary"
                                                   data-price="@r.Price.ToString("N0", vi)"
                                                   data-total="@r.Total.ToString("N0", vi)"
                                                   data-by="@r.CreatedByName"
                                                   data-at="@r.CreatedAt.ToString("HH:mm dd/MM/yyyy")"
                                                   data-status="@r.StatusText"
                                                   data-rejection="@(r.RejectionReason ?? "")"
                                                   data-scale="@r.ScalePhoto"
                                                   data-invoice="@(r.InvoicePhoto ?? "")"
                                                   title="Xem chi tiết phiếu mua hàng @r.Code"
                                                   style="display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #1e293b; font-size: 14px; text-decoration: none;">
                                                    <i class="bi bi-eye"></i>
                                                </a>

                                                @if (Model.CanManagerReviewOrder && r.RawStatus == "PendingOrderApproval")
                                                {
                                                    <form method="post" asp-page-handler="ApproveOrder" style="display: inline; margin: 0;">
                                                        <input type="hidden" name="receiptId" value="@r.ReceiptId" />
                                                        <button type="submit" style="background: #15803d; color: #fff; border: none; border-radius: 6px; padding: 5px 10px; font-size: 12px; font-weight: 600; cursor: pointer;">
                                                            Duyệt
                                                        </button>
                                                    </form>
                                                    <button type="button"
                                                            onclick="openRejectOrderModal(@r.ReceiptId, '@r.Code')"
                                                            style="background: #fff; color: #b91c1c; border: 1px solid #fecaca; border-radius: 6px; padding: 4px 10px; font-size: 12px; font-weight: 600; cursor: pointer;">
                                                        Từ chối
                                                    </button>
                                                }

                                                @if (Model.CanCreateReceipt && r.RawStatus == "OrderRejected")
                                                {
                                                    <button type="button"
                                                            onclick="openEditReceiptModal(@r.ReceiptId, '@r.Code', @r.SupplierId, '@r.Quantity.ToString("0.##", CultureInfo.InvariantCulture)', '@r.Price.ToString("0.##", CultureInfo.InvariantCulture)')"
                                                            style="background: #1a4332; color: #fff; border: none; border-radius: 6px; padding: 5px 10px; font-size: 12px; font-weight: 600; cursor: pointer;">
                                                        Sửa &amp; gửi lại
                                                    </button>
                                                }

                                                @if (Model.CanCreateInboundRequest && r.CanCreateMoreInbound)
                                                {
                                                    <button type="button"
                                                            onclick="openCreateInboundRequestModal(@r.ReceiptId, '@r.Code', '@Html.Raw(r.SupplierName.Replace("'", "\\'"))', '@r.RemainingToRequestQuantity.ToString("0.##", CultureInfo.InvariantCulture)', '@r.Quantity.ToString("N0", vi)', '@r.Price.ToString("0.##", CultureInfo.InvariantCulture)', '@r.Price.ToString("N0", vi)')"
                                                            style="background: #1e40af; color: #fff; border: none; border-radius: 6px; padding: 5px 10px; font-size: 12px; font-weight: 600; cursor: pointer;">
                                                        + Tạo yêu cầu nhập kho
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- =========================================================================
                 BẢNG 2: DANH SÁCH YÊU CẦU NHẬP KHO (INBOUND REQUEST — IR-26xxx)
                 ========================================================================= -->
            <div style="@cardStyle">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 12px;">
                    <div>
                        <h2 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 3px 0;">
                            2. Bảng Yêu cầu nhập kho (Inbound Request — IR-26xxx)
                        </h2>
                        <div style="font-size: 12px; color: #64748b;">
                            Danh sách các đợt giao hàng / chuyến xe gửi sang Kho (@Model.InboundRequests.Count phiếu IR · Tổng @Model.InboundRequestedTotal.ToString("N0", vi) kg). Mỗi IR tương ứng với một chuyến xe vận chuyển từ một Phiếu mua hàng (PO).
                        </div>
                    </div>
                </div>

                <div style="overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 10px;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr>
                                <th style="@thStyle">Mã IR</th>
                                <th style="@thStyle">Thuộc PO</th>
                                <th style="@thStyle">Phiếu nhập kho (PNK)</th>
                                <th style="@thStyle">Nhà cung cấp</th>
                                <th style="@thStyle">KL giao / KL cân kho</th>
                                <th style="@thStyle">Phương tiện &amp; Thời gian giao</th>
                                <th style="@thStyle">Trạng thái IR</th>
                                <th style="@thStyle">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.InboundRequests.Any())
                            {
                                <tr>
                                    <td colspan="8" style="text-align: center; padding: 28px 16px; color: #94a3b8; font-size: 13px;">
                                        Chưa có Yêu cầu nhập kho (IR-26xxx) nào. Sau khi Manager duyệt Phiếu mua hàng (PM-26xxx), Nhân viên thu mua bấm <strong>"+ Tạo yêu cầu nhập kho"</strong> trên dòng PO để tạo các đợt giao hàng.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var ir in Model.InboundRequests)
                                {
                                    <tr>
                                        <td style="@tdStyle">
                                            <span style="display: inline-flex; align-items: center; background: #eff6ff; border: 1px solid #bfdbfe; border-left: 4px solid #1e40af; border-radius: 4px; padding: 3px 8px; font-family: ui-monospace, Consolas, monospace; font-size: 12px; font-weight: 700; color: #1e3a8a;">
                                                @ir.RequestCode
                                            </span>
                                        </td>
                                        <td style="@tdStyle">
                                            <span style="display: inline-flex; align-items: center; background: #faf4e8; border: 1px solid #ecdcc0; border-left: 3px solid #c88a2e; border-radius: 4px; padding: 2px 7px; font-family: ui-monospace, Consolas, monospace; font-size: 11.5px; font-weight: 700; color: #6d4d12;">
                                                @ir.ReceiptCode
                                            </span>
                                        </td>
                                        <td style="@tdStyle">
                                            @if (!string.IsNullOrEmpty(ir.ImportCode))
                                            {
                                                <a href="@Url.Page("/Inventory/Index", new { Tab = "raw", ViewMode = "imports", SearchTerm = ir.ImportCode })"
                                                   style="display: inline-flex; align-items: center; gap: 4px; background: #eef6f0; border: 1px solid #cde2d3; border-left: 4px solid #1a4332; border-radius: 4px; padding: 3px 8px; font-family: ui-monospace, Consolas, monospace; font-size: 12px; font-weight: 700; color: #1a4332; text-decoration: none;"
                                                   title="Mở Phiếu nhập kho nguyên liệu @ir.ImportCode">
                                                    <span>@ir.ImportCode</span>
                                                    <i class="bi bi-box-arrow-up-right" style="font-size: 10px;"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span style="color: #94a3b8; font-size: 12px;">Chưa lập</span>
                                            }
                                        </td>
                                        <td style="@tdStyle; font-weight: 600;">@ir.SupplierName</td>
                                        <td style="@tdStyle">
                                            <div style="font-family: ui-monospace, Consolas, monospace; font-weight: 700;">
                                                Giao: @ir.DeliveryQuantity.ToString("N0", vi) kg
                                            </div>
                                            @if (ir.ImportedQuantity.HasValue)
                                            {
                                                <div style="font-size: 11.5px; color: #15803d; font-weight: 600;">
                                                    Cân kho: @ir.ImportedQuantity.Value.ToString("N0", vi) kg
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="font-size: 11.5px; color: #64748b;">
                                                    Đơn giá: @ir.UnitPrice.ToString("N0", vi) VNĐ/kg
                                                </div>
                                            }
                                        </td>
                                        <td style="@tdStyle">
                                            <div style="font-size: 12px; font-weight: 700; color: #1e40af;">
                                                <i class="bi bi-truck"></i> @ir.LicensePlate · @ir.DriverName
                                            </div>
                                            <div style="font-size: 11.5px; color: #64748b;">
                                                Giao lúc: @ir.DeliveryTime
                                            </div>
                                        </td>
                                        <td style="@tdStyle">
                                            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 9999px; font-size: 12px; font-weight: 500; @BadgeStyle(ir.StatusType)">
                                                <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span>@ir.StatusText
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(ir.RejectionReason))
                                            {
                                                <div style="margin-top: 4px; font-size: 11.5px; color: #b91c1c; max-width: 200px;">
                                                    <strong>Lý do:</strong> @ir.RejectionReason
                                                </div>
                                            }
                                        </td>
                                        <td style="@tdStyle; white-space: nowrap;">
                                            <a href="javascript:void(0)" class="ir-detail-link"
                                               data-ir-code="@ir.RequestCode"
                                               data-po-code="@ir.ReceiptCode"
                                               data-supplier="@ir.SupplierName"
                                               data-delivery-qty="@ir.DeliveryQuantity.ToString("N0", vi)"
                                               data-imported-qty="@(ir.ImportedQuantity?.ToString("N0", vi) ?? "")"
                                               data-price="@ir.UnitPrice.ToString("N0", vi)"
                                               data-total="@ir.Total.ToString("N0", vi)"
                                               data-by="@ir.CreatedByName"
                                               data-at="@ir.CreatedAt.ToString("HH:mm dd/MM/yyyy")"
                                               data-status="@ir.StatusText"
                                               data-rejection="@(ir.RejectionReason ?? "")"
                                               data-license-plate="@ir.LicensePlate"
                                               data-driver-name="@ir.DriverName"
                                               data-delivery-time="@ir.DeliveryTime"
                                               data-note="@(ir.Note ?? "")"
                                               data-import-id="@(ir.ImportId?.ToString() ?? "")"
                                               data-import-code="@(ir.ImportCode ?? "Chưa lập")"
                                               data-import-by="@(ir.ImportedByName ?? "—")"
                                               data-approved-by="@(ir.ApprovedByName ?? "—")"
                                               data-scale="@ir.ScalePhoto"
                                               data-invoice="@(ir.InvoicePhoto ?? "")"
                                               title="Xem chi tiết yêu cầu nhập kho @ir.RequestCode"
                                               style="display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #1e293b; font-size: 14px; text-decoration: none;">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Lịch sử thao tác -->
            <div style="@cardStyle">
                <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 14px;">Lịch sử thao tác</h2>
                @foreach (var t in Model.Timeline)
                {
                    <div style="display: flex; gap: 10px; align-items: flex-start; margin-bottom: 10px; font-size: 13px; color: #475569;">
                        <span style="width: 8px; height: 8px; border: 1px solid #94a3b8; border-radius: 50%; margin-top: 6px; flex-shrink: 0;"></span>
                        <span>@t.At.ToString("HH:mm dd/MM/yyyy") · @t.Text</span>
                    </div>
                }
            </div>
        </div>

        <!-- Cột phải: Thao tác -->
        <div style="@cardStyle background: #f8faf8;">
            <h2 style="font-size: 15px; font-weight: 600; margin-bottom: 14px;">Thao tác</h2>
            @if (Model.CanCreateReceipt)
            {
                @if (Model.RemainingQuantity > 0)
                {
                    <button type="button" onclick="openCreateNewReceiptModal()"
                            style="width: 100%; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 13px; font-weight: 600; padding: 10px; cursor: pointer; margin-bottom: 10px;">
                        + Tạo phiếu mua hàng (PO)
                    </button>
                }
                else
                {
                    <div style="font-size: 12px; color: #166534; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 10px 12px; margin-bottom: 10px;">
                        Đã tạo đủ 100% khối lượng cần mua của yêu cầu thu mua (@Model.PlannedQuantity.ToString("N0", vi) kg).
                    </div>
                }
                <div style="font-size: 12px; color: #475569; line-height: 1.55;">
                    • Sau khi <strong>Phiếu mua hàng (PM-26xxx)</strong> được Manager duyệt, bạn có thể bấm <strong>"+ Tạo yêu cầu nhập kho"</strong> trên dòng PO đó để chia thành 1 hoặc nhiều đợt xe giao hàng (<strong>IR-26xxx</strong>).
                </div>
            }
            else if (Model.IsExpired)
            {
                <div style="font-size: 12px; color: #b91c1c; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 10px 12px;">
                    Yêu cầu thu mua này đã hết hạn vào cuối ngày @Model.ExpiresAt.ToString("dd/MM/yyyy"), không thể tạo thêm phiếu mua hàng.
                </div>
            }
            else if (Model.CanManagerReviewOrder)
            {
                <div style="font-size: 12px; color: #475569; line-height: 1.6;">
                    <strong>Vai trò Quản lý (Manager):</strong><br />
                    • <strong>Bảng 1 (Purchase Order):</strong> Phê duyệt hoặc từ chối các Phiếu mua hàng (<code>PM-26xxx</code>) do Nhân viên thu mua lập.<br />
                    • <strong>Bảng 2 (Inbound Request):</strong> Theo dõi các đợt giao hàng (<code>IR-26xxx</code>) được tách ra từ từng PO và bấm vào mã <code>PNK-26xxx</code> để duyệt phiếu nhập kho.
                </div>
            }
            else if (Model.IsOwnerView)
            {
                <div style="font-size: 12px; color: #475569; line-height: 1.6;">
                    <strong>Vai trò Chủ doanh nghiệp (Owner):</strong><br />
                    • Theo dõi tiến độ Yêu cầu thu mua, Bảng Phiếu mua hàng (PO) và Bảng Yêu cầu nhập kho (IR).<br />
                    • Việc phê duyệt thuộc thẩm quyền của <strong>Manager</strong>.
                </div>
            }
            else
            {
                <div style="font-size: 12px; color: #94a3b8;">Chỉ nhân viên thu mua được giao mới tạo phiếu mua hàng và yêu cầu nhập kho.</div>
            }
        </div>
    </div>
</div>

<!-- POPUP: TẠO / SỬA PHIẾU MUA HÀNG (PURCHASE ORDER - PM-26xxx) -->
@if (Model.CanCreateReceipt)
{
    <div class="pm-overlay" id="createReceiptModal" onclick="if (event.target === this) closePmModal('createReceiptModal')">
        <div class="pm-dialog pm-lg" role="dialog" aria-modal="true">
            <form method="post" asp-page-handler="CreateReceipt" asp-route-id="@Model.InvoiceId" enctype="multipart/form-data">
                <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />
                <input type="hidden" name="editReceiptId" id="editReceiptIdInput" value="" />
                <div class="pm-head">
                    <h5 class="pm-title" id="createReceiptModalTitle">Tạo phiếu mua hàng (Purchase Order)</h5>
                    <button type="button" class="pm-close" aria-label="Đóng" onclick="closePmModal('createReceiptModal')">&times;</button>
                </div>
                <div class="pm-body">
                    <div class="pm-grid">
                        <div>
                            <label class="pm-label">Yêu cầu thu mua được giao <span style="color: #e53e3e;">*</span></label>
                            <input type="text" class="pm-input" value="@Model.InvoiceCode" readonly tabindex="-1" />
                        </div>
                        <div>
                            <label class="pm-label">Nhà cung cấp <span style="color: #e53e3e;">*</span></label>
                            <select name="supplierId" id="supplierIdSelect" class="pm-input" required>
                                <option value="">Chọn...</option>
                                @foreach (var s in Model.Suppliers)
                                {
                                    <option value="@s.SupplierId">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="pm-label">Tổng khối lượng đặt mua (kg) <span style="color: #e53e3e;">*</span></label>
                            <input type="number" name="weighedQuantity" id="weighedQuantityInput" min="1" max="@Model.RemainingQuantity.ToString("0.##", CultureInfo.InvariantCulture)" step="any" placeholder="Vd: 10000" required class="pm-input" />
                            <span class="pm-hint" id="weighedQuantityHint">kg (Còn lại tối đa: @Model.RemainingQuantity.ToString("N0", vi) / @Model.PlannedQuantity.ToString("N0", vi) kg)</span>
                        </div>
                        <div>
                            <label class="pm-label">Giá mua thực tế <span style="color: #e53e3e;">*</span></label>
                            <input type="number" name="actualPrice" id="actualPriceInput" min="1" max="@Model.CeilingPrice.ToString("0.##", CultureInfo.InvariantCulture)" step="any" value="@Model.CeilingPrice.ToString("0.##", CultureInfo.InvariantCulture)" required class="pm-input" />
                            <span class="pm-hint">VNĐ / kg (tối đa giá trần @Model.CeilingPrice.ToString("N0", vi))</span>
                        </div>
                        <div class="pm-full">
                            <label class="pm-label">Ảnh minh chứng / hàng hóa <span id="scalePhotoReqStar" style="color: #e53e3e;">*</span></label>
                            <input type="file" name="scalePhoto" id="scalePhotoInput" accept="image/*" required class="pm-input" />
                            <span class="pm-hint">Có thể chọn tệp, kéo-thả ảnh vào ô này hoặc bấm Ctrl+V để dán ảnh</span>
                        </div>
                    </div>
                </div>
                <div class="pm-foot">
                    <button type="button" class="pm-btn-cancel" onclick="closePmModal('createReceiptModal')">Hủy</button>
                    <button type="submit" class="pm-btn-primary" id="createReceiptSubmitBtn">Gửi đơn mua chờ Manager duyệt</button>
                </div>
            </form>
        </div>
    </div>
}

