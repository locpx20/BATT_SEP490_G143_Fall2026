@page
@model BATT_PPMS.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Quản trị Tài khoản & Phân quyền";
    ViewData["ActivePage"] = "Users";
}

<div class="space-y-6">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Quản trị Tài khoản &amp; Phân quyền</h1>
            <p class="page-subtitle">Quản lý tài khoản người dùng, vai trò và trạng thái hoạt động trong hệ thống nội bộ BATT PPMS</p>
        </div>
        <div class="page-actions">
            <button type="button" class="btn btn-primary" onclick="showModal('createUserModal')">
                <i class="bi bi-plus-lg"></i> Cấp Tài khoản Mới
            </button>
        </div>
    </div>

    <!-- Admin Isolation Banner -->
    <div style="background: linear-gradient(135deg,#eff6ff,#f0fdf4); border: 1px solid #bfdbfe; border-left: 4px solid #4f46e5; border-radius: 10px; padding: 14px 18px; display: flex; gap: 12px; align-items: flex-start;">
        <i class="bi bi-shield-check" style="font-size: 20px; color: #4f46e5; flex-shrink: 0; margin-top: 1px;"></i>
        <div>
            <p style="font-size: 13px; font-weight: 700; color: #1e40af; margin: 0 0 3px;">Chính sách Cách ly Quản trị (Admin Isolation)</p>
            <p style="font-size: 12px; color: #475569; margin: 0; line-height: 1.6;">
                Admin chỉ quản trị tài khoản người dùng và kiểm tra tính toàn vẹn hệ thống. Quyền Admin <strong>không bao gồm</strong> xem dữ liệu tài chính, doanh thu, giá bán hoặc thao tác phê duyệt nghiệp vụ sản xuất.
            </p>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i> @Model.SuccessMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i> @Model.ErrorMessage
        </div>
    }

    <!-- Stat Cards -->
    <div class="stat-grid" style="grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));">
        <div class="stat-card">
            <div class="stat-icon indigo"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="stat-number">@Model.Users.Count</div>
                <div class="stat-label">Tổng tài khoản</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-person-check-fill"></i></div>
            <div>
                <div class="stat-number">@Model.Users.Count(u => u.IsActive)</div>
                <div class="stat-label">Đang hoạt động</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon red"><i class="bi bi-person-lock"></i></div>
            <div>
                <div class="stat-number">@Model.Users.Count(u => !u.IsActive)</div>
                <div class="stat-label">Đã khóa</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon violet"><i class="bi bi-person-badge-fill"></i></div>
            <div>
                <div class="stat-number">@Model.Users.Select(u => u.RoleName).Distinct().Count()</div>
                <div class="stat-label">Vai trò được cấp</div>
            </div>
        </div>
    </div>

    <!-- Filter + Search -->
    <div class="card" style="overflow: visible;">
        <div class="card-body" style="padding: 14px 18px;">
            <form method="get" class="filter-bar">
                <div class="search-wrapper">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@Model.SearchTerm"
                           class="form-control" style="padding-left: 34px;"
                           placeholder="Tên, username, email..." />
                </div>
                <select name="roleFilter" class="form-control" style="width: auto; min-width: 180px;">
                    <option value="">Tất cả vai trò</option>
                    <option value="Admin" selected="@(Model.RoleFilter=="Admin")">Admin System</option>
                    <option value="Owner" selected="@(Model.RoleFilter=="Owner")">Owner (Chủ nhà máy)</option>
                    <option value="Manager" selected="@(Model.RoleFilter=="Manager")">Manager (Quản lý)</option>
                    <option value="Purchasing Staff" selected="@(Model.RoleFilter=="Purchasing Staff")">Purchasing Staff (Thu mua)</option>
                    <option value="Warehouse Staff" selected="@(Model.RoleFilter=="Warehouse Staff")">Warehouse Staff (Thủ kho)</option>
                    <option value="Staff" selected="@(Model.RoleFilter=="Staff")">Production Staff (Sản xuất)</option>
                    <option value="QC Staff" selected="@(Model.RoleFilter=="QC Staff")">QC Staff (KCS)</option>
                    <option value="Maintenance Staff" selected="@(Model.RoleFilter=="Maintenance Staff")">Maintenance Staff (Bảo trì)</option>
                </select>
                <select name="statusFilter" class="form-control" style="width: auto; min-width: 150px;">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active" selected="@(Model.StatusFilter=="active")">Đang hoạt động</option>
                    <option value="inactive" selected="@(Model.StatusFilter=="inactive")">Đã khóa</option>
                </select>
                <button type="submit" class="btn btn-secondary">
                    <i class="bi bi-funnel"></i> Lọc
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.RoleFilter) || !string.IsNullOrEmpty(Model.StatusFilter))
                {
                    <a href="/Admin/Users/Index" class="btn btn-outline btn-sm">
                        <i class="bi bi-x"></i> Xóa lọc
                    </a>
                }
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title" style="font-size: 14px;">
                <i class="bi bi-people" style="color: #4f46e5; margin-right: 6px;"></i>
                Danh sách tài khoản
                <span style="font-size: 11px; font-weight: 600; background: #eef2ff; color: #4f46e5; padding: 2px 8px; border-radius: 20px; margin-left: 8px;">
                    @Model.Users.Count tài khoản
                </span>
            </h2>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Người dùng</th>
                        <th>Tên đăng nhập</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th style="text-align: center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="8" class="empty-state">
                                <i class="bi bi-people"></i>
                                <p style="font-size: 14px; font-weight: 600; color: #475569; margin-top: 8px;">Không tìm thấy tài khoản nào</p>
                                <p style="font-size: 12px; color: #94a3b8;">Thử thay đổi bộ lọc hoặc tạo tài khoản mới</p>
                            </td>
                        </tr>
                    }
                    @{ int idx = 1; }
                    @foreach (var user in Model.Users)
                    {
                        var roleColor = user.RoleName switch {
                            "Admin" => "#7c3aed",
                            "Owner" => "#b45309",
                            "Manager" => "#1d4ed8",
                            "Staff" => "#0f766e",
                            "QC Staff" => "#0e7490",
                            "Maintenance Staff" => "#9a3412",
                            "Purchasing Staff" => "#6d28d9",
                            "Warehouse Staff" => "#065f46",
                            _ => "#475569"
                        };
                        var roleCode = user.RoleName switch {
                            "Admin" => "A",
                            "Owner" => "O",
                            "Manager" => "M",
                            "Staff" => "S",
                            "QC Staff" => "QC",
                            "Maintenance Staff" => "MS",
                            "Purchasing Staff" => "PS",
                            "Warehouse Staff" => "WS",
                            _ => "?"
                        };
                        <tr>
                            <td style="color: #94a3b8; font-size: 12px; font-weight: 600;">@(idx++)</td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#4f46e5,#6366f1);color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0;">
                                        @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")
                                    </div>
                                    <div>
                                        <div style="font-weight: 700; font-size: 13px; color: #0f172a;">@user.FullName</div>
                                        @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                        {
                                            <div style="font-size: 11px; color: #94a3b8;">@user.PhoneNumber</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <code style="font-size: 12px; font-weight: 700; color: #0f172a; background: #f1f5f9; padding: 2px 7px; border-radius: 5px;">@user.Username</code>
                            </td>
                            <td style="font-size: 12px; color: #475569;">@user.Email</td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 1px;">
                                    <span style="font-size: 12px; font-weight: 700; color: @roleColor;">@user.RoleName</span>
                                    <span style="font-size: 10px; font-family: monospace; color: #94a3b8; font-weight: 600;">[@roleCode]</span>
                                </div>
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge badge-active">
                                        <i class="bi bi-circle-fill" style="font-size: 7px; margin-right: 4px;"></i> Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive">
                                        <i class="bi bi-lock-fill" style="font-size: 9px; margin-right: 4px;"></i> Đã khóa
                                    </span>
                                }
                            </td>
                            <td style="font-size: 12px; color: #94a3b8;">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td style="text-align: center;">
                                @if (user.RoleName != "Owner")
                                {
                                    <div style="display: flex; gap: 6px; justify-content: center; align-items: center;">
                                        <!-- Toggle Lock Button -->
                                        <form method="post" asp-page-handler="ToggleStatus" style="margin: 0;">
                                            <input type="hidden" name="userId" value="@user.UserId" />
                                            @Html.AntiForgeryToken()
                                            @if (user.IsActive)
                                            {
                                                <button type="submit" class="btn btn-xs"
                                                        style="background:#fff0f0;color:#dc2626;border:1px solid #fecaca;"
                                                        onclick="return confirm('Khóa tài khoản @user.FullName?')"
                                                        title="Khóa tài khoản">
                                                    <i class="bi bi-lock-fill"></i> Khóa
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-xs"
                                                        style="background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;"
                                                        title="Mở khóa tài khoản">
                                                    <i class="bi bi-unlock-fill"></i> Mở khóa
                                                </button>
                                            }
                                        </form>

                                        <!-- Reset Password Button -->
                                        <button type="button" class="btn btn-xs"
                                                style="background:#f8fafc;color:#475569;border:1px solid #e2e8f0;"
                                                onclick="openResetModal(@user.UserId, '@user.FullName')"
                                                title="Đặt lại mật khẩu">
                                            <i class="bi bi-key"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span style="font-size: 11px; color: #94a3b8; font-style: italic;">Bảo vệ</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ===== MODAL: TẠO TÀI KHOẢN ===== -->
<div class="modal-overlay" id="createUserModal">
    <div class="modal-box">
        <div class="modal-header">
            <h3 class="modal-title"><i class="bi bi-person-plus" style="color:#4f46e5;margin-right:6px;"></i>Cấp Tài khoản Người dùng Mới</h3>
            <button class="modal-close" onclick="hideModal('createUserModal')" type="button">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <form method="post" asp-page-handler="CreateUser">
            @Html.AntiForgeryToken()
            <div class="modal-body" style="display: flex; flex-direction: column; gap: 14px;">
                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label">Tên đăng nhập <span class="required-star">*</span></label>
                        <input type="text" name="Username" class="form-control"
                               placeholder="nguyenvana" required style="font-family: monospace; font-weight: 700;" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Vai trò được cấp <span class="required-star">*</span></label>
                        <select name="RoleName" class="form-control" required>
                            <option value="Manager">Manager (Quản lý Vận hành)</option>
                            <option value="Purchasing Staff">Purchasing Staff (Thu mua)</option>
                            <option value="Warehouse Staff">Warehouse Staff (Thủ kho)</option>
                            <option value="Staff">Production Staff (Sản xuất)</option>
                            <option value="QC Staff">QC Staff (Kiểm tra KCS)</option>
                            <option value="Maintenance Staff">Maintenance Staff (Bảo trì)</option>
                            <option value="Admin">Admin System (Quản trị hệ thống)</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Họ và tên nhân viên <span class="required-star">*</span></label>
                    <input type="text" name="FullName" class="form-control"
                           placeholder="Ví dụ: Nguyễn Văn An" required />
                </div>
                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label">Email công ty <span class="required-star">*</span></label>
                        <input type="email" name="Email" class="form-control"
                               placeholder="an.nv@battenergy.vn" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" name="Phone" class="form-control"
                               placeholder="09xx.xxx.xxx" />
                    </div>
                </div>
                <div class="info-box">
                    Mật khẩu khởi tạo ban đầu là <code>123456</code>. Người dùng có thể tự thay đổi mật khẩu trong mục <strong>Hồ sơ cá nhân</strong> sau khi đăng nhập.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="hideModal('createUserModal')">Hủy</button>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Xác nhận Tạo tài khoản
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ===== MODAL: ĐẶT LẠI MẬT KHẨU ===== -->
<div class="modal-overlay" id="resetPasswordModal">
    <div class="modal-box" style="max-width: 400px;">
        <div class="modal-header">
            <h3 class="modal-title"><i class="bi bi-key" style="color:#d97706;margin-right:6px;"></i>Đặt lại Mật khẩu</h3>
            <button class="modal-close" onclick="hideModal('resetPasswordModal')" type="button">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <form method="post" asp-page-handler="ResetPassword">
            @Html.AntiForgeryToken()
            <input type="hidden" name="UserId" id="resetUserId" />
            <div class="modal-body" style="display: flex; flex-direction: column; gap: 14px;">
                <p style="font-size: 13px; color: #475569;">
                    Bạn đang đặt lại mật khẩu cho tài khoản: <strong id="resetUserName" style="color:#0f172a;"></strong>
                </p>
                <div class="form-group">
                    <label class="form-label">Mật khẩu mới <span class="required-star">*</span></label>
                    <input type="password" name="NewPassword" class="form-control"
                           placeholder="Nhập mật khẩu mới..." required minlength="6" />
                    <span class="form-hint">Tối thiểu 6 ký tự</span>
                </div>
                <div class="info-box" style="border-color: #fde68a; background: #fffbeb;">
                    <i class="bi bi-exclamation-triangle" style="color: #d97706; margin-right: 6px;"></i>
                    Người dùng sẽ cần sử dụng mật khẩu mới này trong lần đăng nhập tiếp theo.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="hideModal('resetPasswordModal')">Hủy</button>
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-key"></i> Đặt lại mật khẩu
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function showModal(id) {
        document.getElementById(id).classList.add('show');
    }
    function hideModal(id) {
        document.getElementById(id).classList.remove('show');
    }
    function openResetModal(userId, userName) {
        document.getElementById('resetUserId').value = userId;
        document.getElementById('resetUserName').textContent = userName;
        showModal('resetPasswordModal');
    }
    // Close modal on backdrop click
    document.querySelectorAll('.modal-overlay').forEach(el => {
        el.addEventListener('click', function(e) {
            if (e.target === this) hideModal(this.id);
        });
    });
</script>
}
