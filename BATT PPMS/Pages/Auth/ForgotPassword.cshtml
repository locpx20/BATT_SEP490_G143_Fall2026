@page
@model BATT_PPMS.Pages.Auth.ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu - BATT PPMS";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-entry.css" asp-append-version="true" />
</head>
<body class="auth-entry">
    <main class="login-wrapper">
        <div class="login-card">
            <div class="login-logo">
                <span class="login-brand-mark" aria-label="BATT">BATT</span>
                <p class="auth-brand-name">BATT PPMS</p>
                <h1>Quên mật khẩu</h1>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle alert-icon" aria-hidden="true"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form method="post">
                <div class="form-group">
                    <label for="AccountIdentifier">Số điện thoại hoặc email</label>
                    <input type="text" id="AccountIdentifier" name="AccountIdentifier" class="form-control"
                           value="@Model.AccountIdentifier"
                           placeholder="Nhập số điện thoại hoặc email" autocomplete="username" required autofocus />
                </div>

                <button type="submit" class="btn-login">
                    <span>Gửi mã xác thực</span>
                </button>
            </form>

            <div class="auth-footer-action">
                <a asp-page="/Auth/Login" class="auth-back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Quay lại đăng nhập</a>
            </div>
        </div>
    </main>
</body>
</html>
