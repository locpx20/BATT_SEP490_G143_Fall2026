@using BATT_PPMS.Helpers
@using System.Text.Json
@model BATT_PPMS.Pages.Orders.OrderFormPageModel
@{
    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Where(m => !string.IsNullOrWhiteSpace(m)).ToList();
    var lotJson = JsonSerializer.Serialize(Model.LotsByGrade.ToDictionary(
        kv => kv.Key,
        kv => kv.Value.Select(l => new { id = l.BatchId, lot = l.Lot, date = l.ProductionDate.ToString("dd/MM/yyyy"), bags = l.AvailableBags })));
}

@if (errors.Count > 0)
{
    <div class="alert alert-danger" style="border-radius:12px;">
        <i class="bi bi-exclamation-triangle-fill" style="margin-right:8px;"></i>
        <strong>Không thể lưu yêu cầu bán:</strong>
        <ul style="margin:6px 0 0 18px;padding:0;">
            @foreach (var m in errors)
            {
                <li>@m</li>
            }
        </ul>
    </div>
}

<div class="card" style="margin-bottom:20px;">
    <div class="card-body">
        <form method="post" id="orderForm" novalidate>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="sel-grade">Loại thành phẩm <span class="required-star">*</span></label>
                    <select class="form-control" name="Input.Grade" id="sel-grade" required>
                        <option value="">-- Chọn loại --</option>
                        @foreach (var g in SalesFlow.Grades)
                        {
                            var total = Model.LotsByGrade.TryGetValue(g, out var gl) ? gl.Sum(l => l.AvailableBags) : 0;
                            <option value="@g" selected="@(Model.Input.Grade == g)">@SalesFlow.GradeLabel(g) (còn @total.ToString("N0") bao khả dụng)</option>
                        }
                    </select>
                    <span class="form-hint" id="stock-hint">Chọn loại để xem số bao còn bán được.</span>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inp-bags">Số bao cần bán <span class="required-star">*</span></label>
                    <input class="form-control" type="number" name="Input.Bags" id="inp-bags" min="1" max="@OrderWorkflow.MaxBagsPerOrder" step="1" required
                           value="@Model.Input.Bags" />
                    <span class="form-hint">1 bao = @SalesFlow.KgPerBag.ToString("N0") kg. Tổng: <strong id="kg-preview">0 kg</strong></span>
                </div>

                <div class="form-group" style="grid-column:1/-1;">
                    <label class="form-label" for="inp-note">Ghi chú</label>
                    <textarea class="form-control" name="Input.Note" id="inp-note" rows="2" maxlength="500">@Model.Input.Note</textarea>
                </div>
            </div>

            <div class="form-actions" style="display:flex;gap:8px;margin-top:20px;">
                <button type="submit" class="btn btn-primary" id="btn-submit-order">
                    <i class="bi bi-check-lg"></i> @(Model.IsEdit ? "Lưu và gửi Owner duyệt" : "Tạo yêu cầu bán")
                </button>
                <a href="@(Model.IsEdit ? ViewData["CancelUrl"] : "/Orders/Index")" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Lô sẽ được lấy (FIFO – lô sản xuất cũ nhất trước)</h3>
    </div>
    <div class="table-wrapper">
        <table class="data-table">
            <thead><tr><th>Mã lot</th><th>Ngày sản xuất</th><th>Lấy (bao)</th><th>Lấy (kg)</th><th>Còn khả dụng (bao)</th></tr></thead>
            <tbody id="alloc-body">
                <tr><td colspan="5"><div class="empty-state" style="padding:24px;"><p>Chọn loại và số bao để xem lô được phân bổ.</p></div></td></tr>
            </tbody>
        </table>
    </div>
</div>

<script>
    (function () {
        var lots = @Html.Raw(lotJson);
        var KG = @SalesFlow.KgPerBag;
        var grade = document.getElementById('sel-grade');
        var bags = document.getElementById('inp-bags');
        var hint = document.getElementById('stock-hint');
        var kg = document.getElementById('kg-preview');
        var body = document.getElementById('alloc-body');

        function fmt(n) { return n.toLocaleString('vi-VN', { maximumFractionDigits: 0 }); }
        function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
        function msg(text) { body.innerHTML = '<tr><td colspan="5"><div class="empty-state" style="padding:24px;"><p>' + esc(text) + '</p></div></td></tr>'; }

        function refresh() {
            var list = lots[grade.value] || [];
            var available = list.reduce(function (s, l) { return s + l.bags; }, 0);
            var need = parseInt(bags.value, 10);
            hint.textContent = grade.value ? 'Còn ' + fmt(available) + ' bao loại ' + grade.value + ' khả dụng (đã trừ phần đang giữ chỗ).' : 'Chọn loại để xem số bao còn bán được.';
            kg.textContent = isNaN(need) ? '0 kg' : fmt(need * KG) + ' kg';
            if (!grade.value || isNaN(need) || need < 1) { msg('Chọn loại và số bao để xem lô được phân bổ.'); return; }
            if (need > available) { msg('Không đủ hàng: cần ' + fmt(need) + ' bao nhưng chỉ còn ' + fmt(available) + ' bao.'); return; }
            var left = need, rows = '';
            list.forEach(function (l) {
                if (left <= 0) return;
                var take = Math.min(left, l.bags); left -= take;
                rows += '<tr><td><strong>' + esc(l.lot) + '</strong></td><td>' + esc(l.date) + '</td><td>' + fmt(take) + '</td><td>' + fmt(take * KG) + '</td><td>' + fmt(l.bags) + '</td></tr>';
            });
            body.innerHTML = rows;
        }

        [grade, bags].forEach(function (el) { el.addEventListener('input', refresh); el.addEventListener('change', refresh); });
        refresh();
    })();
</script>
