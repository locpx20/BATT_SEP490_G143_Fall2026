@page
@model BATT_PPMS.Pages.Personnel.IndexModel
@using BATT_PPMS.Pages.Personnel
@using System.Globalization
@{
    ViewData["Title"] = Model.IsStaffView ? "Lịch phân công lao động"
        : Model.IsEditingPlan ? "Chỉnh sửa phân công công việc"
        : Model.CanCreatePlan ? "Phân công công việc" : "Phân công lao động";
    ViewData["ActivePage"] = "Personnel";
}

@section Styles {
    @if (Model.IsStaffView) {
        <link rel="stylesheet" href="~/css/shift-closeout.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/warehouse-plans.css" asp-append-version="true" />
    } else {
        <link rel="stylesheet" href="~/css/production-plan.css" asp-append-version="true" />
    }
}

@section Scripts {
    @if (Model.CanCreatePlan) {
        <script src="~/js/production-plan.js" asp-append-version="true"></script>
    }
}

@if (Model.IsStaffView && Model.StaffSchedule is { } schedule) {
    <div class="closeout">
        <header class="closeout-header">
            <h1><i class="bi bi-calendar-week" aria-hidden="true"></i> @ViewData["Title"]</h1>
        </header>
        @if (Model.ShowingLatestPlanDate) {
            <div class="closeout-message" role="status">Hôm nay (@Model.Today.ToString("dd/MM/yyyy")) chưa có phân công. Đang hiển thị lịch ngày @Model.DisplayDate?.ToString("dd/MM/yyyy").</div>
        }
        <partial name="~/Pages/Shared/_ProductionSchedule.cshtml" model="schedule" />
    </div>
    return;
}

<div class="labor-page">
    <header class="labor-header">
        <div>
            @if (Model.IsEditingPlan) {
                <a class="labor-back" asp-page="./Index" asp-route-PlanDate="@Model.NewPlanDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                   asp-route-ShiftFilter="@Model.EditShift">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> Lịch phân công
                </a>
            }
            <h1>@ViewData["Title"]</h1>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage)) {
        <p class="labor-message" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i> @Model.SuccessMessage</p>
    }
    @if (!Model.Create && !string.IsNullOrEmpty(Model.ErrorMessage)) {
        <p class="labor-message labor-message-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> @Model.ErrorMessage</p>
    }

    @if (Model.IsEditingPlan && Model.CanCreatePlan) {
        <partial name="_CreateDayPlan" model="Model" />
    } else if (Model.DisplayDate is { } day) {
        var dateValue = day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        var vi = CultureInfo.GetCultureInfo("vi-VN");
        var allShifts = string.IsNullOrEmpty(Model.ShiftFilter) || Model.ShiftFilter == "ALL";
        <section class="labor-day" aria-labelledby="labor-day-title">
            <header class="labor-day-head">
                <div>
                    <h2 id="labor-day-title"><time datetime="@dateValue">@day.ToString("dd/MM/yyyy")</time></h2>
                    <span>@vi.DateTimeFormat.GetDayName(day.DayOfWeek)@(day == Model.Today ? " (Hôm nay)" : "")</span>
                </div>
                @if (Model.CanCreatePlan) {
                    <button class="labor-button labor-primary labor-create-button" type="button"
                            aria-haspopup="dialog" aria-controls="labor-create-dialog" data-plan-open>
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> Tạo phân công công việc
                    </button>
                }
            </header>
            <form method="get" asp-page="./Index" class="labor-filters">
                <div>
                    <label for="PlanDate">Xem ngày</label>
                    <input id="PlanDate" name="PlanDate" type="date" value="@dateValue" required />
                </div>
                <div>
                    <label asp-for="ShiftFilter">Ca sản xuất</label>
                    <select asp-for="ShiftFilter">
                        <option value="">Tất cả ca</option>
                        @foreach (var shift in IndexModel.ProductionShifts) {
                            <option value="@shift">@shift</option>
                        }
                    </select>
                </div>
                <div>
                    <label asp-for="StatusFilter">Trạng thái</label>
                    <select asp-for="StatusFilter">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Assigned">Chờ thực hiện</option>
                        <option value="InProgress">Đang thực hiện</option>
                        <option value="Completed">Hoàn thành</option>
                        <option value="Cancelled">Đã hủy</option>
                        <option value="Off">Nghỉ</option>
                    </select>
                </div>
                <button class="labor-button" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Tìm kiếm</button>
            </form>
            <nav class="labor-shift-index" aria-label="Chọn ca sản xuất">
                <a asp-page="./Index" asp-route-PlanDate="@dateValue" asp-route-StatusFilter="@Model.StatusFilter"
                   asp-route-SearchTerm="@Model.SearchTerm" aria-current="@(allShifts ? "page" : null)">Tất cả ca</a>
                @foreach (var shift in IndexModel.ProductionShifts) {
                    <a asp-page="./Index" asp-route-PlanDate="@dateValue" asp-route-ShiftFilter="@shift"
                       asp-route-StatusFilter="@Model.StatusFilter" asp-route-SearchTerm="@Model.SearchTerm"
                       aria-current="@(Model.ShiftFilter == shift ? "page" : null)">
                        @shift <span>@IndexModel.ShiftHours(shift)</span>
                    </a>
                }
            </nav>
        </section>

        @if (Model.Plans.Count == 0) {
            <div class="labor-empty" role="status">
                <i class="bi bi-calendar-x" aria-hidden="true"></i>
                <p>@(allShifts && string.IsNullOrEmpty(Model.SearchTerm) && string.IsNullOrEmpty(Model.StatusFilter)
                    ? "Chưa có phân công cho ngày này." : "Không có phân công phù hợp với bộ lọc.")</p>
            </div>
        }
        @foreach (var plan in Model.Plans) {
            var projection = plan.Shift == null ? null : Model.ShiftPlans.GetValueOrDefault(plan.Shift);
            var hours = IndexModel.ShiftHours(plan.Shift);
            var isDayOff = plan.Status == "Off";
            <section id="labor-shift-@plan.PlanId" class="labor-shift" aria-labelledby="labor-shift-title-@plan.PlanId">
                <header class="labor-shift-head">
                    <div class="labor-shift-name">
                        <div>
                            <h2 id="labor-shift-title-@plan.PlanId">@(plan.Shift ?? "Chưa ghi nhận ca")</h2>
                            @if (hours.Length > 0) { <span><i class="bi bi-clock" aria-hidden="true"></i> @hours</span> }
                        </div>
                        <span class="labor-status" data-status="@plan.Status">@IndexModel.AssignmentStatusLabel(plan.Status)</span>
                        @if (Model.CanCreatePlan && day == Model.Today && plan.Shift is { } shift
                            && IndexModel.ProductionShifts.Contains(shift) && plan.Status != "Cancelled") {
                            <a class="labor-button" asp-page="./Index" asp-route-PlanDate="@dateValue" asp-route-EditShift="@shift"
                               aria-label="Chỉnh sửa @shift"><i class="bi bi-pencil" aria-hidden="true"></i> Chỉnh sửa</a>
                        }
                    </div>
                    @if (!isDayOff) {
                        <dl class="labor-estimates">
                        <div>
                            <dt>Nguyên liệu tiêu thụ dự kiến</dt>
                            <dd>@(projection is null ? "Chưa cập nhật" : projection.ExpectedMaterialKg.ToString("N2", vi) + " kg")</dd>
                        </div>
                        <div>
                            <dt>Thành phẩm dự kiến</dt>
                            <dd>@(projection is null ? "Chưa cập nhật" : projection.ExpectedFinishedKg.ToString("N2", vi) + " kg")</dd>
                        </div>
                        </dl>
                    }
                </header>
                @if (!isDayOff) {
                <table class="labor-table" aria-labelledby="labor-shift-title-@plan.PlanId">
                    <thead><tr><th scope="col">Công đoạn</th><th scope="col">Nhân viên</th><th scope="col">Người phân công</th></tr></thead>
                    <tbody>
                        @foreach (var stage in IndexModel.GetStageGroupsForPlan(plan)) {
                            var assigners = stage.Assignments.Select(a => a.AssignedByNavigation?.FullName).Where(name => !string.IsNullOrWhiteSpace(name)).Distinct().ToList();
                            <tr>
                                <th scope="row">@stage.TaskDescription</th>
                                <td><ul>@foreach (var worker in stage.Assignments) {
                                    <li>@(worker.Staff?.FullName ?? "Tài khoản đã xóa")</li>
                                }</ul></td>
                                <td>@(assigners.Count > 0 ? string.Join(", ", assigners) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                }
                @if (!isDayOff || !string.IsNullOrWhiteSpace(projection?.Note)) {
                    <footer class="labor-shift-foot">
                        @if (!isDayOff) { <span>@string.Join(", ", plan.Codes)</span> }
                        @if (!string.IsNullOrWhiteSpace(projection?.Note)) { <p>@projection.Note</p> }
                    </footer>
                }
            </section>
        }

        @if (Model.CanCreatePlan) {
            <dialog class="labor-create-dialog" id="labor-create-dialog" aria-labelledby="labor-create-title"
                    data-open-on-load="@(Model.Create ? "true" : "false")">
                <header class="labor-dialog-head">
                    <h2 id="labor-create-title">
                        <i class="bi bi-calendar-plus" aria-hidden="true"></i> Tạo phân công công việc
                    </h2>
                    <button class="labor-dialog-close" type="button" aria-label="Đóng" data-plan-close>
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </header>
                <partial name="_CreateDayPlan" model="Model" />
            </dialog>
        }
    }
</div>
