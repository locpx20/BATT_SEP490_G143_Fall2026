<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="BATT PPMS - Hệ thống Quản lý Sản xuất Nhà máy Viên nén Gỗ" />
    <title>@ViewData["Title"] - BATT PPMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/topbar-menus.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-pagination.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/theme-colors.css" asp-append-version="true" />
    @if (Context.Session.GetString("RoleName") is "Owner" or "Manager")
    {
        <link rel="stylesheet" href="~/css/owner-workspace.css" asp-append-version="true" />
    }
</head>
<body class="@(Context.Session.GetString("RoleName") is "Owner" or "Manager" ? "owner-workspace" : "") @ViewData["PageClass"]">

@{
    var roleName        = Context.Session.GetString("RoleName") ?? "";
    var fullName        = Context.Session.GetString("FullName") ?? "User";
    bool isAdmin        = roleName == "Admin System" || roleName == "Admin";
    bool isWorkspace    = roleName == "Owner" || roleName == "Manager"; // Owner & Manager dùng chung khung giao diện workspace
    string ap           = ViewData["ActivePage"]?.ToString() ?? "";

    // Initials for avatar
    var nameParts = fullName.Trim().Split(' ');
    var initials = nameParts.Length >= 2
        ? $"{nameParts[0][0]}{nameParts[^1][0]}"
        : fullName.Length > 0 ? fullName[0].ToString() : "U";
    initials = initials.ToUpper();

    // Role display
    string roleDisplay = roleName switch {
        "Admin System"             => "Quản trị viên",
        "Owner"             => "Chủ nhà máy",
        "Manager"           => "Quản lý Vận hành",
        "Staff"             => "Nhân viên Sản xuất",
        "Maintenance Staff" => "Bảo trì Cơ điện",
        "QC Staff"          => "Kiểm tra KCS",
        "Purchasing Staff"  => "Thu mua",
        "Warehouse Staff"   => "Thủ kho",
        _                   => roleName
    };
}

<!-- Mobile backdrop -->
<div class="mobile-backdrop" id="mobileBackdrop" onclick="closeSidebar()"></div>

<!-- ===== SIDEBAR ===== -->
<aside class="sidebar" id="sidebar">
    <!-- Brand Header -->
    <div class="sidebar-header">
        <div class="sidebar-logo-box" aria-label="BATT">BATT</div>
        <div class="sidebar-brand-info">
            <div class="sidebar-brand-row">
                <span class="brand-name">BATT PPMS</span>
            </div>
        </div>
        <button class="sidebar-close-btn d-lg-none" onclick="closeSidebar()">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- Navigation -->
    <nav class="sidebar-nav" id="sidebarNav">

        @if (BATT_PPMS.Helpers.RoleViews.Folder(roleName) is string roleFolder)
        {
            <partial name="@($"~/Pages/Shared/Roles/{roleFolder}/_Navigation.cshtml")" model="ap" />
        }
    </nav>

    <!-- Sidebar Footer -->
    <div class="sidebar-footer">
        @if (isAdmin)
        {
            <partial name="~/Pages/Shared/Roles/Admin/_AccountMenu.cshtml"
                     model="new BATT_PPMS.Helpers.RoleHeaderViewModel(fullName, initials, roleDisplay)" />
        }
        else if (roleName == "Owner")
        {
            <partial name="~/Pages/Shared/Roles/Owner/_AccountMenu.cshtml"
                     model="new BATT_PPMS.Helpers.RoleHeaderViewModel(fullName, initials, roleDisplay)" />
        }
        else if (roleName == "Manager")
        {
            <partial name="~/Pages/Shared/Roles/Manager/_AccountMenu.cshtml"
                     model="new BATT_PPMS.Helpers.RoleHeaderViewModel(fullName, initials, roleDisplay)" />
        }
        else
        {
        <div class="sidebar-factory-card">
            <p class="factory-name">Nhà máy Viên nén Gỗ BATT</p>
            <p class="factory-loc">Hàm Kiệm, Bình Thuận</p>
        </div>
        }
    </div>
</aside>

<!-- ===== MAIN WRAPPER ===== -->
<div class="main-wrapper" id="mainWrapper">

    <!-- Topbar -->
    @if (!isAdmin && !isWorkspace)
    {
    <header class="topbar">
        <div class="topbar-left">
            <button class="sidebar-toggle" id="sidebarToggle" onclick="openSidebar()" title="Mở menu">
                <i class="bi bi-list"></i>
            </button>
            @if (roleName == "Owner")
            {
                <span class="owner-breadcrumb">BATT PPMS / @ViewData["Title"]</span>
            }
            else if (!isAdmin && ap != "Profile" && ap != "ChangePassword")
            {
                <span class="topbar-page-title">@ViewData["Title"]</span>
            }
        </div>

        <div class="topbar-right">
            @if (BATT_PPMS.Helpers.RoleViews.Folder(roleName) is string headerFolder)
            {
                <partial name="@($"~/Pages/Shared/Roles/{headerFolder}/_Topbar.cshtml")"
                         model="new BATT_PPMS.Helpers.RoleHeaderViewModel(fullName, initials, roleDisplay)" />
            }
        </div>
    </header>
    }

    <!-- Page Content -->
    <main class="page-content">
        @if (isAdmin || isWorkspace)
        {
            <button type="button" class="admin-mobile-menu" onclick="openSidebar()" aria-label="Mở menu điều hướng">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
        }
        @RenderBody()
    </main>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/topbar-menus.js" asp-append-version="true"></script>
<script>
    // ===== Accordion sidebar =====
    function toggleGroup(key) {
        const items = document.getElementById('items-' + key);
        const chevron = document.getElementById('chevron-' + key);
        const header = chevron ? chevron.closest('.nav-group-header') : null;
        if (!items) return;

        const isOpen = items.classList.contains('open');

        // Close all groups first (accordion behavior)
        document.querySelectorAll('.nav-group-items.open').forEach(el => {
            el.classList.remove('open');
        });
        document.querySelectorAll('.nav-chevron.rotated').forEach(el => {
            el.classList.remove('rotated');
        });

        // Open the clicked one if it was closed
        if (!isOpen) {
            items.classList.add('open');
            if (chevron) chevron.classList.add('rotated');
        }
    }

    // Auto-open the group that has an active nav item
    window.addEventListener('DOMContentLoaded', () => {
        const activeItem = document.querySelector('.nav-item.active');
        if (activeItem) {
            const group = activeItem.closest('.nav-group-items');
            if (group) {
                group.classList.add('open');
                const chevron = group.previousElementSibling?.querySelector('.nav-chevron');
                if (chevron) chevron.classList.add('rotated');
            }
        } else {
            // Open the first group by default
            const firstItems = document.querySelector('.nav-group-items');
            if (firstItems) {
                firstItems.classList.add('open');
                const chevron = firstItems.previousElementSibling?.querySelector('.nav-chevron');
                if (chevron) chevron.classList.add('rotated');
            }
        }
    });

    // ===== Mobile sidebar =====
    function openSidebar() {
        document.getElementById('sidebar').classList.add('open');
        document.getElementById('mobileBackdrop').classList.add('show');
    }
    function closeSidebar() {
        document.getElementById('sidebar').classList.remove('open');
        document.getElementById('mobileBackdrop').classList.remove('show');

    }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
