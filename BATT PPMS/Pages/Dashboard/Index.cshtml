@page
@model BATT_PPMS.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = Model.IsAdminRole || HttpContext.Session.GetString("RoleName") == "Warehouse Staff" ? "Tổng quan vận hành" : "Tổng quan Điều hành";
    ViewData["ActivePage"] = "Dashboard";
    if (Model.IsAdminRole)
    {
        ViewData["PageClass"] = "admin-overview-page";
    }
}

@section Styles {
    @if (HttpContext.Session.GetString("RoleName") == "Warehouse Staff")
    {
        <link rel="stylesheet" href="~/css/warehouse-overview.css" asp-append-version="true" />
    }
    @if (Model.IsAdminRole)
    {
        <link rel="stylesheet" href="~/css/admin-overview.css" asp-append-version="true" />
    }
}

@if (BATT_PPMS.Helpers.RoleViews.Folder(HttpContext.Session.GetString("RoleName")) is string roleFolder)
{
    <partial name="@($"~/Pages/Shared/Roles/{roleFolder}/_Dashboard.cshtml")" model="Model" />
}
