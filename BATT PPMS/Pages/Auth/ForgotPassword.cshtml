@page
@model BATT_PPMS.Pages.Auth.ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu - BATT PPMS";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-logo">
                <span class="logo-icon">🔑</span>
                <h1>Quên mật khẩu</h1>
                <p>Khôi phục mật khẩu qua Email xác thực</p>
                <div class="zalo-service-pill">
                    <span class="zalo-badge-icon">✉️</span>
                    <span>Mã OTP sẽ được gửi đến Email của bạn</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    <span class="alert-icon">⚠</span>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form method="post">
                <div class="form-group">
                    <label for="AccountIdentifier">Tên đăng nhập hoặc địa chỉ Email</label>
                    <input type="text" id="AccountIdentifier" name="AccountIdentifier" class="form-control"
                           value="@Model.AccountIdentifier"
                           placeholder="vd: admin hoặc email@example.com" required autofocus />
                    <small class="form-hint">Nhập tên đăng nhập hoặc địa chỉ email đã liên kết với tài khoản</small>
                </div>

                <button type="submit" class="btn-login btn-zalo-primary">
                    <span>Gửi mã xác thực qua Email</span>
                    <span class="btn-arrow">→</span>
                </button>
            </form>

            <div class="auth-divider">
                <span>quay lại</span>
            </div>

            <div class="auth-footer-action">
                <p><a asp-page="/Auth/Login" class="link-register">← Trở về màn hình Đăng nhập</a></p>
            </div>
        </div>
    </div>
</body>
</html>
