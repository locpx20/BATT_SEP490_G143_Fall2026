@page
@model BATT_PPMS.Pages.Maintenance.IndexModel
@using BATT_PPMS.Helpers
@{
    ViewData["Title"] = "Yêu cầu sửa chữa máy móc";
    ViewData["ActivePage"] = "Maintenance";

    var filters = new Dictionary<string, string?>
    {
        ["SearchTerm"] = Model.SearchTerm,
        ["PriorityFilter"] = Model.PriorityFilter,
        ["StatusFilter"] = Model.StatusFilter
    };

    var currentStatus = string.IsNullOrEmpty(Model.StatusFilter) ? "ALL" : Model.StatusFilter;
    var tabs = new[]
    {
        (Label: "Tất cả", Value: (int?)null, Filter: "ALL", Css: ""),
        (Label: "Chờ duyệt", Value: (int?)Model.PendingCount, Filter: RepairStatus.Pending, Css: Model.PendingCount > 0 ? "alert" : ""),
        (Label: "Bị từ chối", Value: (int?)Model.RejectedCount, Filter: RepairStatus.Rejected, Css: ""),
        (Label: "Chờ xác nhận", Value: (int?)Model.AssignedCount, Filter: RepairStatus.Assigned, Css: ""),
        (Label: "Đang sửa chữa", Value: (int?)Model.InProgressCount, Filter: RepairStatus.InProgress, Css: ""),
        (Label: "Chờ vật tư", Value: (int?)Model.WaitingMaterialCount, Filter: RepairStatus.WaitingMaterial, Css: Model.WaitingMaterialCount > 0 ? "hot" : ""),
        (Label: "Hoàn thành", Value: (int?)Model.CompletedCount, Filter: RepairStatus.Completed, Css: "")
    };
    string TabHref(string status)
    {
        var q = new List<string> { "StatusFilter=" + Uri.EscapeDataString(status) };
        if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) q.Add("SearchTerm=" + Uri.EscapeDataString(Model.SearchTerm));
        if (!string.IsNullOrWhiteSpace(Model.PriorityFilter) && Model.PriorityFilter != "ALL") q.Add("PriorityFilter=" + Uri.EscapeDataString(Model.PriorityFilter));
        return "/Maintenance/Index?" + string.Join("&", q);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/repair-flow.css" asp-append-version="true" />
}

<div class="space-y-6 rf">

    <partial name="_NotificationBanner" model="Model.Notices" />

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="rf-callout ok"><i class="bi bi-check-circle-fill"></i><div>@Model.SuccessMessage</div></div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="rf-callout danger"><i class="bi bi-exclamation-triangle-fill"></i><div>@Model.ErrorMessage</div></div>
    }

    <div class="page-header" style="margin-bottom: 18px;">
        <div>
            <h1 class="page-title" style="font-size: 20px; font-weight: 800; color: #243d35; margin-bottom: 4px;">Yêu cầu sửa chữa máy móc</h1>
            <p class="page-subtitle" style="font-size: 12px; color: #7a887f; margin: 0;">@Model.ScopeHint</p>
        </div>
        @if (Model.CanCreate)
        {
            <a href="/Maintenance/Create" class="btn btn-success btn-sm" style="border-radius: 8px; font-size: 12px; font-weight: 700;">
                <i class="bi bi-plus-circle"></i> Tạo yêu cầu sửa chữa
            </a>
        }
    </div>

    <!-- Tab trạng thái -->
    <nav class="rf-tabs" aria-label="Lọc theo trạng thái">
        @foreach (var t in tabs)
        {
            <a href="@TabHref(t.Filter)" class="rf-tab @(currentStatus == t.Filter ? "active" : "") @t.Css">
                @t.Label
                @if (t.Value.HasValue)
                {
                    <span class="n">@t.Value.Value</span>
                }
            </a>
        }
    </nav>

    <!-- Bộ lọc -->
    <form method="get" class="rf-toolbar">
        <input type="hidden" name="StatusFilter" value="@currentStatus" />
        <div class="rf-search">
            <i class="bi bi-search"></i>
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Tìm theo mã, máy, vị trí, tiêu đề, người tạo..." />
        </div>
        <select name="PriorityFilter" class="form-select" aria-label="Mức độ">
            <option value="ALL" selected="@(string.IsNullOrEmpty(Model.PriorityFilter) || Model.PriorityFilter == "ALL")">Mọi mức độ</option>
            @foreach (var p in RepairStatus.PriorityLevels)
            {
                <option value="@p" selected="@(Model.PriorityFilter == p)">@RepairStatus.PriorityLabel(p)</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-secondary btn-sm rf-btn-sm"><i class="bi bi-funnel"></i> Lọc</button>
        <a href="/Maintenance/Index" class="btn btn-link btn-sm" style="font-size: 12px;">Xóa lọc</a>
    </form>

    <!-- Danh sách -->
    <div class="rf-card">
        <div class="table-responsive">
            <table class="table rf-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Máy &amp; vị trí</th>
                        <th>Hiện tượng</th>
                        <th>Mức độ</th>
                        <th class="d-none d-xl-table-cell">Người tạo</th>
                        <th class="d-none d-lg-table-cell">Phụ trách</th>
                        <th class="d-none d-xl-table-cell">Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th style="text-align: right;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="9" class="rf-empty">
                                <i class="bi bi-tools"></i>
                                Không có yêu cầu sửa chữa nào.
                            </td>
                        </tr>
                    }
                    @foreach (var r in Model.Rows)
                    {
                        var sb = RepairStatus.Badge(r.Status);
                        var pb = RepairStatus.PriorityBadge(r.Priority);
                        var rowCss = r.Status == RepairStatus.WaitingMaterial ? "rf-row-purple" : (r.Status == RepairStatus.Pending ? "rf-row-attn" : "");
                        <tr class="@rowCss">
                            <td><a class="rf-code" href="/Maintenance/Details?id=@r.RequestId">@r.Code</a></td>
                            <td>
                                <div style="font-weight: 700; color: #30483f;">@r.MachineName</div>
                                <div class="rf-sub">@r.MachineCode · <i class="bi bi-geo-alt"></i> @(string.IsNullOrWhiteSpace(r.Location) ? "Chưa ghi vị trí" : r.Location)</div>
                            </td>
                            <td style="max-width: 280px;">
                                <div class="rf-clamp">@r.Title</div>
                                @if (r.MachineStopped)
                                {
                                    <span class="rf-badge rf-plain" style="background: #f1d9d4; color: #8e2f24; border-color: #e2b9b1; font-size: 10.5px; margin-top: 4px;"><i class="bi bi-stop-circle"></i> Máy đang dừng</span>
                                }
                                @if (r.Status == RepairStatus.Rejected && !string.IsNullOrWhiteSpace(r.RejectionReason))
                                {
                                    <div class="rf-sub" style="color: #94473e;"><i class="bi bi-reply-fill"></i> Lý do: @r.RejectionReason</div>
                                }
                            </td>
                            <td><span class="rf-badge" style="background: @pb.Bg; color: @pb.Fg; border-color: @pb.Border;">@RepairStatus.PriorityLabel(r.Priority)</span></td>
                            <td class="d-none d-xl-table-cell">@r.RequestedByName</td>
                            <td class="d-none d-lg-table-cell">
                                @if (!string.IsNullOrEmpty(r.AssignedToName))
                                {
                                    <div>@r.AssignedToName</div>
                                    @if (r.DueDate.HasValue)
                                    {
                                        <div class="rf-sub">Hạn: @r.DueDate.Value.ToString("dd/MM/yyyy")</div>
                                    }
                                }
                                else
                                {
                                    <span style="color: #96a298;">—</span>
                                }
                            </td>
                            <td class="d-none d-xl-table-cell" style="white-space: nowrap;">@r.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="rf-badge" style="background: @sb.Bg; color: @sb.Fg; border-color: @sb.Border;">@RepairStatus.Label(r.Status)</span></td>
                            <td style="text-align: right; white-space: nowrap;">
                                <a href="/Maintenance/Details?id=@r.RequestId" class="btn btn-sm btn-outline-success rf-btn-sm">Chi tiết <i class="bi bi-chevron-right"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="~/Pages/Shared/_AdminPagination.cshtml"
                 model='new BATT_PPMS.Helpers.AdminPaginationViewModel(Model.Pagination, "/Maintenance/Index", filters)' />
    </div>
</div>
