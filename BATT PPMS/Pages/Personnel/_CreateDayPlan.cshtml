@model BATT_PPMS.Pages.Personnel.IndexModel
@using BATT_PPMS.Pages.Personnel
@using System.Globalization

<form method="post" asp-page-handler="CreatePlan" class="labor-form">
    <div class="labor-form-date">
        <div>
            <label asp-for="NewPlanDate">Ngày sản xuất</label>
            <input asp-for="NewPlanDate" type="date" asp-format="{0:yyyy-MM-dd}" min="2000-01-01" max="2100-12-31" required />
        </div>
        <nav class="labor-shift-index" aria-label="Đến ca cần phân công">
            @for (var i = 0; i < IndexModel.ProductionShifts.Count; i++) {
                <a href="#labor-form-shift-@i">@IndexModel.ProductionShifts[i]</a>
            }
        </nav>
    </div>

    @for (var i = 0; i < IndexModel.ProductionShifts.Count; i++) {
        var shift = IndexModel.ProductionShifts[i];
        var shiftInput = Model.ShiftInputs[i];
        var workersByStage = shiftInput.StaffByStage;
        <section class="labor-form-shift" aria-labelledby="labor-form-shift-@i" data-plan-shift>
            <header>
                <div>
                    <h2 id="labor-form-shift-@i">@shift</h2>
                    <span><i class="bi bi-clock" aria-hidden="true"></i> @IndexModel.ShiftHours(shift)</span>
                </div>
                <label class="labor-shift-choice">
                    <input asp-for="ShiftInputs[i].Included" class="labor-shift-toggle" data-plan-include />
                    <span>Phân công @shift.ToLowerInvariant()</span>
                </label>
            </header>
            <fieldset class="labor-form-fields" data-plan-fields aria-labelledby="labor-form-shift-@i">
                <div class="labor-form-quantities">
                    <div>
                        <label asp-for="ShiftInputs[i].ExpectedMaterialKg">Nguyên liệu tiêu thụ dự kiến cho 1 ca (kg)</label>
                        <input asp-for="ShiftInputs[i].ExpectedMaterialKg" type="number" min="0.01" max="9999999999.99" step="0.01" data-plan-quantity />
                    </div>
                    <div>
                        <label asp-for="ShiftInputs[i].ExpectedFinishedKg">Thành phẩm dự kiến (kg)</label>
                        <input asp-for="ShiftInputs[i].ExpectedFinishedKg" type="number" min="0.01" max="9999999999.99" step="0.01" data-plan-quantity />
                    </div>
                </div>
                <div class="labor-form-stages">
                    @for (var stageIndex = 0; stageIndex < IndexModel.ProductionStages.Count; stageIndex++) {
                        var stage = IndexModel.ProductionStages[stageIndex];
                        var fieldName = $"ShiftInputs[{i}].Stage{stageIndex + 1}StaffIds";
                        <div class="labor-stage-row">
                            <strong>@stage.Name</strong>
                            <details class="plan-staff-picker" data-staff-picker>
                                <summary>
                                    <span data-staff-caption>Chọn công nhân</span>
                                    <span class="plan-staff-count" data-staff-count hidden></span>
                                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                </summary>
                                <div class="plan-staff-options" role="group" aria-label="@stage.Name, @shift">
                                    @foreach (var worker in Model.AvailableStaff) {
                                        <label class="plan-staff-option">
                                            <input type="checkbox" name="@fieldName" value="@worker.UserId"
                                                   checked="@workersByStage[stageIndex].Contains(worker.UserId)" data-worker-name="@worker.FullName" />
                                            <span>@worker.FullName <small>@worker.Username</small></span>
                                        </label>
                                    }
                                    @if (Model.AvailableStaff.Count == 0) { <p>Chưa có công nhân đang hoạt động.</p> }
                                </div>
                            </details>
                        </div>
                    }
                </div>
                <div>
                    <label asp-for="ShiftInputs[i].Note">Ghi chú phân công</label>
                    <textarea asp-for="ShiftInputs[i].Note" maxlength="1000" rows="2"></textarea>
                </div>
            </fieldset>
        </section>
    }

    <footer class="labor-form-footer">
        <a class="labor-button" asp-page="./Index" asp-route-PlanDate="@Model.NewPlanDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">Hủy</a>
        <button class="labor-button labor-primary" type="submit" disabled="@(Model.AvailableStaff.Count == 0)">
            <i class="bi bi-check2-circle" aria-hidden="true"></i> Lưu phân công cả ngày
        </button>
    </footer>
</form>
