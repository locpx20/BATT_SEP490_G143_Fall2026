@page
@using BATT_PPMS.Helpers
@using BATT_PPMS.Pages.Orders
@model BATT_PPMS.Pages.Orders.DetailModel
@{
    ViewData["Title"] = "Chi tiết yêu cầu bán hàng";
    ViewData["ActivePage"] = "OrderList";
    var o = Model.Order;
    var d = Model.ActiveDelivery;
    var stage = OrderWorkflow.Stage(o);
    var hasSlip = d != null && d.ExportSlips.Count > 0;

    // Tiến độ luồng: 0 tạo yêu cầu, 1 Owner duyệt, 2 yêu cầu xuất kho, 3 thủ kho kiểm tra, 4 phiếu xuất kho, 5 hoàn thành
    var step = o.Status switch
    {
        StatusConstants.Pending => 1,
        StatusConstants.Rejected => 1,
        StatusConstants.Completed => 5,
        StatusConstants.Approved => d == null ? 2 : (hasSlip ? 4 : (d.DeliveryStatus == "Returned" ? 2 : 3)),
        _ => 0
    };
    var steps = new[] { "Tạo yêu cầu", "Owner duyệt", "Yêu cầu xuất kho", "Thủ kho kiểm tra", "Phiếu xuất kho", "Hoàn thành" };
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success" style="border-radius:12px;">
        <i class="bi bi-check-circle-fill" style="margin-right:8px;"></i><span>@Model.SuccessMessage</span>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" style="border-radius:12px;">
        <i class="bi bi-exclamation-triangle-fill" style="margin-right:8px;"></i><span>@Model.ErrorMessage</span>
    </div>
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            Yêu cầu bán @o.OrderCode
            <span class="badge @stage.Badge" style="vertical-align:middle;margin-left:8px;">@stage.Label</span>
        </h1>
        <p class="page-subtitle">Ngày tạo: @o.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="page-actions">
        <a href="/Orders/Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
        @if (Model.CanModify)
        {
            <a href="/Orders/Edit?id=@o.OrderId" class="btn btn-primary" id="btn-edit-order"><i class="bi bi-pencil"></i> @(o.Status == StatusConstants.Rejected ? "Sửa và gửi lại" : "Chỉnh sửa")</a>
            <a href="/Orders/Delete?id=@o.OrderId" class="btn btn-danger" id="btn-delete-order"><i class="bi bi-x-circle"></i> Hủy yêu cầu</a>
        }
        @if (Model.CanCreateDelivery)
        {
            <a href="/Deliveries/Edit?orderId=@o.OrderId" class="btn btn-primary" id="btn-create-delivery"><i class="bi bi-truck"></i> Thêm xe lấy hàng</a>
        }
    </div>
</div>

@if (o.Status is StatusConstants.Pending or StatusConstants.Approved or StatusConstants.Completed)
{
    <div class="card" style="margin-bottom:20px;">
        <div class="card-body" style="display:flex;flex-wrap:wrap;gap:8px;">
            @for (var i = 0; i < steps.Length; i++)
            {
                var cls = i < step || step == 5 ? "badge-completed" : (i == step ? "badge-pending" : "badge-inactive");
                <span class="badge @cls">@(i + 1). @steps[i]</span>
            }
        </div>
    </div>
}

@if (o.Status == StatusConstants.Rejected && !string.IsNullOrWhiteSpace(o.RejectionReason))
{
    <div class="alert alert-danger" style="border-radius:12px;">
        <i class="bi bi-x-octagon-fill" style="margin-right:8px;"></i>
        <strong>Lý do Owner từ chối:</strong> @o.RejectionReason
    </div>
}

@if (Model.CanDecide)
{
    <div class="card" style="margin-bottom:20px;">
        <div class="card-header"><h3 class="card-title">Quyết định của Owner</h3></div>
        <div class="card-body">
            <div class="form-grid">
                <form method="post" asp-page-handler="Approve" asp-route-id="@o.OrderId" id="approveForm" style="grid-column:1/-1;">
                    <h4 style="margin:0 0 12px;">Đồng ý – cập nhật người mua và giá bán</h4>
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label" for="sel-customer">Người mua <span class="required-star">*</span></label>
                            <select class="form-control" name="customerId" id="sel-customer" required>
                                <option value="">-- Chọn khách hàng --</option>
                                @foreach (var c in Model.Customers)
                                {
                                    <option value="@c.CustomerId">@c.CustomerName@(string.IsNullOrWhiteSpace(c.Phone) ? "" : " · " + c.Phone)</option>
                                }
                            </select>
                            <span class="form-hint">Chưa có khách hàng? <a href="/Suppliers/Index?tab=customers">Thêm khách hàng</a> rồi quay lại.</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="inp-price">Giá bán (₫/kg) <span class="required-star">*</span></label>
                            <input class="form-control" type="number" name="unitPrice" id="inp-price" min="0.01" step="0.01" required />
                            <span class="form-hint">Số lượng: @o.Quantity.ToString("N0") kg (@SalesFlow.Bags(o.Quantity) bao).</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Tổng tiền (tự động tính)</label>
                            <div class="info-box" style="font-size:16px;font-weight:700;" id="total-preview">0 ₫</div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success" id="btn-approve-order"><i class="bi bi-check-lg"></i> Duyệt và gửi Manager</button>
                </form>
                <form method="post" asp-page-handler="Reject" asp-route-id="@o.OrderId" id="rejectForm" style="grid-column:1/-1;border-top:1px solid var(--border);padding-top:16px;">
                    <h4 style="margin:0 0 12px;">Không đồng ý – ghi lý do</h4>
                    <div class="form-group">
                        <label class="form-label" for="inp-reason">Lý do từ chối <span class="required-star">*</span></label>
                        <textarea class="form-control" name="reason" id="inp-reason" rows="2" maxlength="1000" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger" id="btn-reject-order"><i class="bi bi-x-lg"></i> Từ chối yêu cầu</button>
                </form>
            </div>
        </div>
    </div>
    <script>
        (function () {
            var price = document.getElementById('inp-price');
            var total = document.getElementById('total-preview');
            var kg = @o.Quantity;
            price.addEventListener('input', function () {
                var p = parseFloat(price.value);
                total.textContent = isNaN(p) ? '0 ₫' : (kg * p).toLocaleString('vi-VN', { maximumFractionDigits: 0 }) + ' ₫';
            });
        })();
    </script>
}

<div class="card" style="margin-bottom:20px;">
    <div class="card-header"><h3 class="card-title">Thông tin yêu cầu</h3></div>
    <div class="card-body">
        <div class="form-grid">
            <div class="form-group"><span class="form-label">Loại thành phẩm</span><div>@SalesFlow.GradeLabel(o.Grade)</div></div>
            <div class="form-group"><span class="form-label">Số lượng</span><div>@SalesFlow.Bags(o.Quantity) bao</div><span class="form-hint">@o.Quantity.ToString("N0") kg</span></div>
            <div class="form-group"><span class="form-label">Giá bán</span><div>@(o.UnitPrice.HasValue ? o.UnitPrice.Value.ToString("N0") + " ₫/kg" : "Chưa có (chờ Owner)")</div></div>
            <div class="form-group"><span class="form-label">Tổng tiền</span><div style="font-size:18px;font-weight:700;">@(o.UnitPrice.HasValue ? o.TotalAmount.ToString("N0") + " ₫" : "—")</div></div>
            <div class="form-group"><span class="form-label">Người tạo</span><div>@(o.CreatedByNavigation?.FullName ?? "Tài khoản đã xóa")</div></div>
            <div class="form-group"><span class="form-label">Người xử lý (Owner)</span><div>@(o.ApprovedByNavigation?.FullName ?? "Chưa có")</div>
                @if (o.ApprovedAt.HasValue) { <span class="form-hint">@o.ApprovedAt.Value.ToString("dd/MM/yyyy HH:mm")</span> }
            </div>
            @if (!string.IsNullOrWhiteSpace(o.Note))
            {
                <div class="form-group" style="grid-column:1/-1;"><span class="form-label">Ghi chú</span><div>@o.Note</div></div>
            }
        </div>
    </div>
</div>

@if (o.Customer != null)
{
    <div class="card" style="margin-bottom:20px;">
        <div class="card-header"><h3 class="card-title">Thông tin người mua</h3></div>
        <div class="card-body">
            <div class="form-grid">
                <div class="form-group"><span class="form-label">Khách hàng</span><div>@o.Customer.CustomerName</div></div>
                <div class="form-group"><span class="form-label">Người liên hệ</span><div>@(o.Customer.ContactPerson ?? "—")</div></div>
                <div class="form-group"><span class="form-label">Số điện thoại</span><div>@(o.Customer.Phone ?? "—")</div></div>
                <div class="form-group"><span class="form-label">Email</span><div>@(o.Customer.Email ?? "—")</div></div>
                <div class="form-group" style="grid-column:1/-1;"><span class="form-label">Địa chỉ</span><div>@(o.Customer.Address ?? "—")</div></div>
            </div>
        </div>
    </div>
}

<div class="card" style="margin-bottom:20px;">
    <div class="card-header"><h3 class="card-title">Lô thành phẩm sẽ xuất (FIFO)</h3></div>
    <div class="table-wrapper">
        <table class="data-table">
            <thead><tr><th>Mã lot</th><th>Loại</th><th>Ngày sản xuất</th><th>Số bao</th><th>Số lượng (kg)</th></tr></thead>
            <tbody>
                @if (!o.OrderDetails.Any())
                {
                    <tr><td colspan="5"><div class="empty-state" style="padding:24px;"><p>Chưa phân bổ lô thành phẩm cho yêu cầu này.</p></div></td></tr>
                }
                @foreach (var line in o.OrderDetails.OrderBy(x => x.Batch.ProductionDate).ThenBy(x => x.BatchId))
                {
                    <tr>
                        <td><strong>@line.Batch.BagNumber</strong></td>
                        <td>@SalesFlow.GradeLabel(o.Grade)</td>
                        <td>@line.Batch.ProductionDate.ToString("dd/MM/yyyy")</td>
                        <td>@SalesFlow.Bags(line.Quantity)</td>
                        <td>@line.Quantity.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
        <div>
            <h3 class="card-title" style="margin-bottom:4px;"><i class="bi bi-truck"></i> Danh sách xe đến lấy hàng (@o.Deliveries.Count xe)</h3>
            <p class="form-hint" style="margin:0;">
                Đặt hàng: <strong>@Model.TotalBags bao</strong> (@o.Quantity.ToString("N0") kg)
                · Đã xuất: <strong style="color:var(--primary);">@Model.ExportedBags bao</strong> (@Model.ExportedKg.ToString("N0") kg)
                · Còn lại: <strong style="color:var(--text-secondary);">@Model.RemainingBags bao</strong> (@Model.RemainingKg.ToString("N0") kg)
            </p>
        </div>
        @if (Model.CanCreateDelivery)
        {
            <a href="/Deliveries/Edit?orderId=@o.OrderId" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg"></i> Thêm xe lấy hàng
            </a>
        }
    </div>
    <div class="card-body" style="padding:0;">
        @if (!o.Deliveries.Any())
        {
            <div class="empty-state" style="padding:28px;">
                <i class="bi bi-truck" style="font-size:32px;color:var(--text-secondary);"></i>
                <h4 style="margin:8px 0 4px;">Chưa có xe nào được đăng ký</h4>
                <p style="margin:0;color:var(--text-secondary);">@(o.Status == StatusConstants.Approved ? "Bấm 'Thêm xe lấy hàng' để nhập thông tin tài xế và biển số xe." : "Chỉ đăng ký xe lấy hàng sau khi Owner duyệt yêu cầu.")</p>
            </div>
        }
        else
        {
            <div class="table-wrapper" style="border:none;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Biển số xe</th>
                            <th>Tài xế</th>
                            <th>Số điện thoại</th>
                            <th>Ngày lấy hàng</th>
                            <th>Hàng trên xe</th>
                            <th>Trạng thái xe</th>
                            <th>Phiếu xuất kho</th>
                            <th>Ghi chú</th>
                            <th style="text-align:right;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var idx = 1; }
                        @foreach (var del in o.Deliveries.OrderBy(d => d.PickupDate).ThenBy(d => d.DeliveryId))
                        {
                            var delStage = DeliveryWorkflow.Stage(del, o);
                            var delSlips = del.ExportSlips.OrderBy(x => x.CreatedAt).ThenBy(x => x.SlipId).ToList();
                            var bagsOnVehicle = delSlips.Sum(x => x.Lines.Sum(l => l.Bags));
                            var kgOnVehicle = delSlips.Sum(x => x.Lines.Sum(l => l.Quantity));
                            <tr>
                                <td>@(idx++)</td>
                                <td><strong>@del.LicensePlate</strong></td>
                                <td>@del.DriverName</td>
                                <td>@(del.DriverPhone ?? "—")</td>
                                <td>@del.PickupDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (delSlips.Count > 0)
                                    {
                                        <span><strong>@bagsOnVehicle bao</strong> (@kgOnVehicle.ToString("N0") kg)</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--text-secondary);">Chờ bốc hàng</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @delStage.Badge">@delStage.Label</span>
                                    @if (del.DeliveryStatus == "Returned" && !string.IsNullOrWhiteSpace(del.ReturnReason))
                                    {
                                        <div style="font-size:12px;color:var(--danger);margin-top:2px;">
                                            <i class="bi bi-exclamation-circle"></i> @del.ReturnReason
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (delSlips.Count > 0)
                                    {
                                        @foreach (var delSlip in delSlips)
                                        {
                                            <div>
                                                <a href="/ExportSlips/Detail?id=@delSlip.SlipId" style="font-weight:600;">@delSlip.SlipCode</a>
                                                <span style="font-size:12px;color:var(--text-secondary);">· @DeliveryWorkflow.SlipLabel(delSlip.Status)</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td style="max-width:180px;white-space:normal;">@(string.IsNullOrWhiteSpace(del.Note) ? "—" : del.Note)</td>
                                <td style="text-align:right;white-space:nowrap;">
                                    <a href="/Deliveries/Detail?id=@del.DeliveryId" class="btn btn-sm btn-outline" title="Chi tiết xe">
                                        <i class="bi bi-eye"></i> Chi tiết
                                    </a>
                                    @if (Model.CanManage && DeliveryWorkflow.CanEdit(del))
                                    {
                                        <a href="/Deliveries/Edit?id=@del.DeliveryId" class="btn btn-sm btn-primary" title="Sửa thông tin xe">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" asp-page-handler="DeleteDelivery" asp-route-deliveryId="@del.DeliveryId" asp-route-orderId="@o.OrderId" style="display:inline;"
                                              data-admin-confirm data-confirm-title="Xóa xe lấy hàng"
                                              data-confirm-message="Xóa xe biển số @del.LicensePlate khỏi yêu cầu xuất kho này?"
                                              data-confirm-label="Xóa xe" data-confirm-danger="true">
                                            <button type="submit" class="btn btn-sm btn-danger" title="Xóa xe"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
