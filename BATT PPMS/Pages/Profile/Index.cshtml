@page
@model BATT_PPMS.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Ho so ca nhan";
    ViewData["ActivePage"] = "Profile";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Hồ sơ cá nhân</h1>
        <p class="page-subtitle">Xem và cập nhật thông tin cá nhân</p>
    </div>
</div>

<div class="card" style="max-width:600px;">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">@Model.SuccessMessage</div>
        }
        @if (Model.User != null)
        {
            <div style="display:flex; align-items:center; gap:20px; margin-bottom:24px;">
                <div style="width:70px;height:70px;border-radius:50%;background:#eff6ff;display:flex;align-items:center;justify-content:center;font-size:32px;">
                    <i class="bi bi-person-circle" style="color:#2563eb;"></i>
                </div>
                <div>
                    <h2 style="font-size:20px;font-weight:700;margin:0;">@Model.User.FullName</h2>
                    <span class="badge badge-approved" style="margin-top:4px;">@Model.User.Role?.RoleName</span>
                </div>
            </div>

            <form method="post">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Tên đăng nhập</label>
                        <input class="form-control" type="text" value="@Model.User.Username" readonly
                               style="background:#f8fafc; cursor:not-allowed;" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Họ và tên</label>
                        <input class="form-control" type="text" name="FullName"
                               value="@Model.User.FullName" required id="inp-fullname" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Số điện thoại</label>
                        <input class="form-control" type="tel" name="Phone"
                               value="@Model.User.Phone" id="inp-phone" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input class="form-control" type="email" name="Email"
                               value="@Model.User.Email" id="inp-email" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" id="btn-save-profile">
                        <i class="bi bi-check-lg"></i> Lưu thay đổi
                    </button>
                    <a href="/Profile/ChangePassword" class="btn btn-secondary">
                        <i class="bi bi-shield-lock"></i> Đổi mật khẩu
                    </a>
                </div>
            </form>
        }
    </div>
</div>
