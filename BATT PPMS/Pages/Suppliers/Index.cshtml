@page
@model BATT_PPMS.Pages.Suppliers.IndexModel
@{
    ViewData["Title"] = "Đối tác Cung ứng & Khách hàng";
    ViewData["ActivePage"] = "Suppliers";
    var isSuppliersTab = Model.Tab == "suppliers";
}

<div class="space-y-6">

    <!-- Alerts / Messages -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" style="border-radius: 12px; margin-bottom: 20px;">
            <i class="bi bi-check-circle-fill" style="font-size: 16px; margin-right: 8px;"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" style="border-radius: 12px; margin-bottom: 20px;">
            <i class="bi bi-exclamation-triangle-fill" style="font-size: 16px; margin-right: 8px;"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <!-- Header Section -->
    <div class="page-header" style="margin-bottom: 20px;">
        <div>
            <h1 class="page-title" style="font-size: 20px; font-weight: 800; color: #0f172a; margin-bottom: 4px;">
                Đối tác Cung ứng &amp; Khách hàng
            </h1>
            <p class="page-subtitle" style="font-size: 12px; color: #64748b;">
                Quản lý nhà cung cấp nguyên vật liệu và khách hàng tiêu thụ viên nén gỗ (Chỉ Giám đốc toàn quyền tạo/sửa)
            </p>
        </div>

        @if (Model.CanManage)
        {
            <div class="page-actions">
                @if (isSuppliersTab)
                {
                    <button type="button" class="btn btn-primary" onclick="openAddSupplierModal()" id="btn-add-supplier">
                        <i class="bi bi-plus-lg"></i> Thêm Nhà cung cấp
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-primary" onclick="openAddCustomerModal()" id="btn-add-customer">
                        <i class="bi bi-plus-lg"></i> Thêm Khách hàng
                    </button>
                }
            </div>
        }
    </div>

    <!-- Tabs & Search Toolbar -->
    <div class="partner-tabs-wrapper">
        <div class="partner-tabs">
            <a href="?tab=suppliers@(string.IsNullOrEmpty(Model.SearchTerm) ? "" : $"&SearchTerm={Uri.EscapeDataString(Model.SearchTerm)}")"
               class="partner-tab-btn @(isSuppliersTab ? "active" : "")">
                <i class="bi bi-truck"></i>
                Nhà cung cấp NVL (@Model.Suppliers.Count)
            </a>
            <a href="?tab=customers@(string.IsNullOrEmpty(Model.SearchTerm) ? "" : $"&SearchTerm={Uri.EscapeDataString(Model.SearchTerm)}")"
               class="partner-tab-btn @(!isSuppliersTab ? "active" : "")">
                <i class="bi bi-building-check"></i>
                Khách hàng thu mua (@Model.Customers.Count)
            </a>
        </div>

        <form method="get" class="search-wrapper" style="margin: 0; min-width: 280px;">
            <input type="hidden" name="tab" value="@Model.Tab" />
            <i class="bi bi-search"></i>
            <input type="text"
                   name="SearchTerm"
                   value="@Model.SearchTerm"
                   placeholder="Tìm theo tên, mã, người liên hệ..."
                   class="form-control" />
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a href="?tab=@Model.Tab" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); color: #94a3b8;">
                    <i class="bi bi-x-circle-fill"></i>
                </a>
            }
        </form>
    </div>

    <!-- TAB 1: SUPPLIERS LIST -->
    @if (isSuppliersTab)
    {
        @if (!Model.Suppliers.Any())
        {
            <div class="card">
                <div class="card-body">
                    <div class="empty-state">
                        <i class="bi bi-truck"></i>
                        <h3 style="font-size: 15px; font-weight: 700; color: #334155;">Không tìm thấy nhà cung cấp nào</h3>
                        <p style="font-size: 12px; color: #94a3b8; margin-top: 4px;">
                            @(string.IsNullOrEmpty(Model.SearchTerm) ? "Chưa có nhà cung cấp nào trong hệ thống." : "Không có kết quả khớp với từ khóa tìm kiếm.")
                        </p>
                        @if (Model.CanManage && string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <button type="button" class="btn btn-primary btn-sm" onclick="openAddSupplierModal()" style="margin-top: 12px;">
                                <i class="bi bi-plus-lg"></i> Thêm NCC đầu tiên
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="partner-grid">
                @foreach (var sup in Model.Suppliers)
                {
                    var isActive = sup.Status == "Active";
                    <div class="partner-card">
                        <div>
                            <!-- Header: Code & Status -->
                            <div style="display: flex; align-items: center; justify-content: space-between;">
                                <span class="partner-badge-sup">@sup.Code</span>
                                @if (isActive)
                                {
                                    <span class="badge" style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; font-size: 11px; padding: 2px 8px; border-radius: 20px; font-weight: 600;">
                                        ● Đang hợp tác
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; font-size: 11px; padding: 2px 8px; border-radius: 20px; font-weight: 600;">
                                        ○ Ngừng hợp tác
                                    </span>
                                }
                            </div>

                            <!-- Name -->
                            <h3 class="partner-card-title" title="@sup.Name">@sup.Name</h3>

                            <!-- Details -->
                            <div class="partner-details">
                                <div class="partner-detail-row">
                                    <i class="bi bi-person"></i>
                                    <span style="font-weight: 600; color: #1e293b;">@sup.ContactPerson</span>
                                </div>
                                <div class="partner-detail-row">
                                    <i class="bi bi-telephone"></i>
                                    <span>@sup.Phone</span>
                                </div>
                                @if (!string.IsNullOrEmpty(sup.Email) && sup.Email != "—")
                                {
                                    <div class="partner-detail-row">
                                        <i class="bi bi-envelope"></i>
                                        <span style="word-break: break-all;">@sup.Email</span>
                                    </div>
                                }
                                <div class="partner-detail-row">
                                    <i class="bi bi-geo-alt"></i>
                                    <span style="color: #64748b; line-height: 1.3;">@sup.Address</span>
                                </div>
                            </div>

                            <!-- Stats Box -->
                            <div class="partner-stat-box">
                                <div class="partner-stat-row">
                                    <span>Mặt hàng cung cấp:</span>
                                    <span style="font-weight: 600; color: #0f172a;">Nguyên vật liệu</span>
                                </div>
                                <div class="partner-stat-row">
                                    <span>Đơn thu mua:</span>
                                    <span style="font-weight: 700; color: #4f46e5;">@sup.TotalPurchasesCount đơn</span>
                                </div>
                                <div class="partner-stat-row">
                                    <span>Tổng khối lượng:</span>
                                    <span style="font-weight: 700; color: #4338ca;">@sup.TotalPurchasesKg.ToString("N0") kg</span>
                                </div>
                                <div class="partner-stat-row">
                                    <span>Tổng giá trị giao dịch:</span>
                                    <span style="font-weight: 800; color: #0f172a;">@sup.TotalPaidVnd.ToString("N0") đ</span>
                                </div>
                            </div>
                        </div>

                        <!-- Footer Actions -->
                        <div class="partner-card-footer">
                            <button type="button"
                                    class="btn btn-outline btn-xs"
                                    onclick="viewSupplierHistory(@sup.SupplierId, '@Html.Raw(JavaScriptEncoder.Default.Encode(sup.Code))', '@Html.Raw(JavaScriptEncoder.Default.Encode(sup.Name))')">
                                <i class="bi bi-clock-history"></i> Lịch sử thu mua
                            </button>

                            @if (Model.CanManage)
                            {
                                <div style="display: flex; align-items: center; gap: 4px;">
                                    <button type="button"
                                            class="btn btn-outline btn-xs"
                                            title="Chỉnh sửa thông tin"
                                            onclick="openEditSupplierModal(@sup.SupplierId, '@Html.Raw(JavaScriptEncoder.Default.Encode(sup.Name))', '@Html.Raw(JavaScriptEncoder.Default.Encode(sup.ContactPerson ?? ""))', '@Html.Raw(JavaScriptEncoder.Default.Encode(sup.Phone ?? ""))', '@Html.Raw(JavaScriptEncoder.Default.Encode(sup.Email ?? ""))', '@Html.Raw(JavaScriptEncoder.Default.Encode(sup.Address ?? ""))', '@sup.Status')">
                                        <i class="bi bi-pencil-square" style="color: #4f46e5;"></i>
                                    </button>

                                    <form method="post" asp-page-handler="ToggleSupplierStatus" style="display: inline; margin: 0;">
                                        <input type="hidden" name="SupplierId" value="@sup.SupplierId" />
                                        <button type="submit"
                                                class="btn btn-xs @(isActive ? "btn-outline" : "btn-success")"
                                                title="@(isActive ? "Ngừng hợp tác" : "Kích hoạt lại")"
                                                onclick="return confirm('Bạn có chắc muốn @(isActive ? "ngừng hợp tác với" : "kích hoạt lại") NCC \'@sup.Name\'?');">
                                            <i class="bi bi-power" style="@(isActive ? "color: #dc2626;" : "")"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <!-- TAB 2: CUSTOMERS LIST -->
        @if (!Model.Customers.Any())
        {
            <div class="card">
                <div class="card-body">
                    <div class="empty-state">
                        <i class="bi bi-building-check"></i>
                        <h3 style="font-size: 15px; font-weight: 700; color: #334155;">Không tìm thấy khách hàng nào</h3>
                        <p style="font-size: 12px; color: #94a3b8; margin-top: 4px;">
                            @(string.IsNullOrEmpty(Model.SearchTerm) ? "Chưa có khách hàng nào trong hệ thống." : "Không có kết quả khớp với từ khóa tìm kiếm.")
                        </p>
                        @if (Model.CanManage && string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <button type="button" class="btn btn-primary btn-sm" onclick="openAddCustomerModal()" style="margin-top: 12px;">
                                <i class="bi bi-plus-lg"></i> Thêm Khách hàng đầu tiên
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="partner-grid">
                @foreach (var cus in Model.Customers)
                {
                    var isActive = cus.Status == "Active";
                    <div class="partner-card">
                        <div>
                            <!-- Header: Code & Status -->
                            <div style="display: flex; align-items: center; justify-content: space-between;">
                                <span class="partner-badge-cus">@cus.Code</span>
                                @if (isActive)
                                {
                                    <span class="badge" style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; font-size: 11px; padding: 2px 8px; border-radius: 20px; font-weight: 600;">
                                        ● Đang hợp tác
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; font-size: 11px; padding: 2px 8px; border-radius: 20px; font-weight: 600;">
                                        ○ Ngừng hợp tác
                                    </span>
                                }
                            </div>

                            <!-- Name -->
                            <h3 class="partner-card-title" title="@cus.Name">@cus.Name</h3>

                            <!-- Details -->
                            <div class="partner-details">
                                <div class="partner-detail-row">
                                    <i class="bi bi-person"></i>
                                    <span style="font-weight: 600; color: #1e293b;">@cus.ContactPerson</span>
                                </div>
                                <div class="partner-detail-row">
                                    <i class="bi bi-telephone"></i>
                                    <span>@cus.Phone</span>
                                </div>
                                @if (!string.IsNullOrEmpty(cus.Email) && cus.Email != "—")
                                {
                                    <div class="partner-detail-row">
                                        <i class="bi bi-envelope"></i>
                                        <span style="word-break: break-all;">@cus.Email</span>
                                    </div>
                                }
                                <div class="partner-detail-row">
                                    <i class="bi bi-geo-alt"></i>
                                    <span style="color: #64748b; line-height: 1.3;">@cus.Address</span>
                                </div>
                            </div>

                            <!-- Stats Box -->
                            <div class="partner-stat-box">
                                <div class="partner-stat-row">
                                    <span>Điều khoản thanh toán:</span>
                                    <span style="font-weight: 600; color: #0f172a;">Chuyển khoản / Hợp đồng</span>
                                </div>
                                <div class="partner-stat-row">
                                    <span>Đơn đặt hàng:</span>
                                    <span style="font-weight: 700; color: #059669;">@cus.TotalOrdersCount đơn</span>
                                </div>
                                <div class="partner-stat-row">
                                    <span>Tổng khối lượng mua:</span>
                                    <span style="font-weight: 700; color: #047857;">@cus.TotalOrderedKg.ToString("N0") kg</span>
                                </div>
                                <div class="partner-stat-row">
                                    <span>Tổng giá trị đơn hàng:</span>
                                    <span style="font-weight: 800; color: #0f172a;">@cus.TotalRevenueVnd.ToString("N0") đ</span>
                                </div>
                            </div>
                        </div>

                        <!-- Footer Actions -->
                        <div class="partner-card-footer">
                            <button type="button"
                                    class="btn btn-outline btn-xs"
                                    onclick="viewCustomerHistory(@cus.CustomerId, '@Html.Raw(JavaScriptEncoder.Default.Encode(cus.Code))', '@Html.Raw(JavaScriptEncoder.Default.Encode(cus.Name))')">
                                <i class="bi bi-clock-history"></i> Lịch sử đơn hàng
                            </button>

                            @if (Model.CanManage)
                            {
                                <div style="display: flex; align-items: center; gap: 4px;">
                                    <button type="button"
                                            class="btn btn-outline btn-xs"
                                            title="Chỉnh sửa thông tin"
                                            onclick="openEditCustomerModal(@cus.CustomerId, '@Html.Raw(JavaScriptEncoder.Default.Encode(cus.Name))', '@Html.Raw(JavaScriptEncoder.Default.Encode(cus.ContactPerson ?? ""))', '@Html.Raw(JavaScriptEncoder.Default.Encode(cus.Phone ?? ""))', '@Html.Raw(JavaScriptEncoder.Default.Encode(cus.Email ?? ""))', '@Html.Raw(JavaScriptEncoder.Default.Encode(cus.Address ?? ""))', '@cus.Status')">
                                        <i class="bi bi-pencil-square" style="color: #4f46e5;"></i>
                                    </button>

                                    <form method="post" asp-page-handler="ToggleCustomerStatus" style="display: inline; margin: 0;">
                                        <input type="hidden" name="CustomerId" value="@cus.CustomerId" />
                                        <button type="submit"
                                                class="btn btn-xs @(isActive ? "btn-outline" : "btn-success")"
                                                title="@(isActive ? "Ngừng hợp tác" : "Kích hoạt lại")"
                                                onclick="return confirm('Bạn có chắc muốn @(isActive ? "ngừng hợp tác với" : "kích hoạt lại") Khách hàng \'@cus.Name\'?');">
                                            <i class="bi bi-power" style="@(isActive ? "color: #dc2626;" : "")"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }

</div>

<!-- =====================================================
     MODAL: TẠO MỚI NHÀ CUNG CẤP (CREATE SUPPLIER)
     ===================================================== -->
<div class="modal-overlay" id="modalAddSupplier">
    <div class="modal-box" style="max-width: 560px;">
        <div class="modal-header">
            <h3 class="modal-title">
                <i class="bi bi-truck" style="color: #4f46e5; margin-right: 6px;"></i>
                Thêm Nhà cung cấp Nguyên vật liệu
            </h3>
            <button type="button" class="modal-close" onclick="closeModal('modalAddSupplier')">
                <i class="bi bi-x"></i>
            </button>
        </div>
        <form method="post" asp-page-handler="CreateSupplier">
            <div class="modal-body">
                <div class="info-box" style="margin-bottom: 16px;">
                    <i class="bi bi-info-circle" style="color: #4f46e5; margin-right: 6px;"></i>
                    Mã NCC sẽ được hệ thống tự động sinh tiếp theo (ví dụ: <code>NCC-0@(Model.Suppliers.Count + 1)</code>).
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label class="form-label">Tên Nhà cung cấp <span class="required-star">*</span></label>
                    <input type="text" name="SupplierName" class="form-control" placeholder="Ví dụ: Công ty TNHH Lâm Nghiệp Hàm Thuận" required />
                </div>

                <div class="form-grid-2" style="margin-bottom: 14px;">
                    <div class="form-group">
                        <label class="form-label">Người đại diện / liên hệ</label>
                        <input type="text" name="ContactPerson" class="form-control" placeholder="Ví dụ: Ông Nguyễn Đức Thắng" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" name="Phone" class="form-control" placeholder="Ví dụ: 0252.386.1111" />
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label class="form-label">Email liên hệ</label>
                    <input type="email" name="Email" class="form-control" placeholder="thang.nd@hamthuanwood.vn" />
                </div>

                <div class="form-group">
                    <label class="form-label">Địa chỉ kho / Trụ sở</label>
                    <textarea name="Address" class="form-control" rows="2" placeholder="Ví dụ: KCN Hàm Kiệm, Huyện Hàm Thuận Nam, Bình Thuận"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('modalAddSupplier')">Hủy bỏ</button>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check2"></i> Lưu Nhà cung cấp
                </button>
            </div>
        </form>
    </div>
</div>

<!-- =====================================================
     MODAL: CẬP NHẬT NHÀ CUNG CẤP (UPDATE SUPPLIER)
     ===================================================== -->
<div class="modal-overlay" id="modalEditSupplier">
    <div class="modal-box" style="max-width: 560px;">
        <div class="modal-header">
            <h3 class="modal-title">
                <i class="bi bi-pencil-square" style="color: #4f46e5; margin-right: 6px;"></i>
                Cập nhật thông tin Nhà cung cấp
            </h3>
            <button type="button" class="modal-close" onclick="closeModal('modalEditSupplier')">
                <i class="bi bi-x"></i>
            </button>
        </div>
        <form method="post" asp-page-handler="UpdateSupplier">
            <input type="hidden" name="SupplierId" id="editSupplierId" />
            <div class="modal-body">
                <div class="form-group" style="margin-bottom: 14px;">
                    <label class="form-label">Tên Nhà cung cấp <span class="required-star">*</span></label>
                    <input type="text" name="SupplierName" id="editSupplierName" class="form-control" required />
                </div>

                <div class="form-grid-2" style="margin-bottom: 14px;">
                    <div class="form-group">
                        <label class="form-label">Người đại diện / liên hệ</label>
                        <input type="text" name="ContactPerson" id="editSupplierContact" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" name="Phone" id="editSupplierPhone" class="form-control" />
                    </div>
                </div>

                <div class="form-grid-2" style="margin-bottom: 14px;">
                    <div class="form-group">
                        <label class="form-label">Email liên hệ</label>
                        <input type="email" name="Email" id="editSupplierEmail" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Trạng thái hợp tác</label>
                        <select name="Status" id="editSupplierStatus" class="form-control">
                            <option value="Active">Đang hợp tác (Active)</option>
                            <option value="Inactive">Ngừng hợp tác (Inactive)</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Địa chỉ kho / Trụ sở</label>
                    <textarea name="Address" id="editSupplierAddress" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('modalEditSupplier')">Hủy bỏ</button>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check2"></i> Cập nhật thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

<!-- =====================================================
     MODAL: TẠO MỚI KHÁCH HÀNG (CREATE CUSTOMER)
     ===================================================== -->
<div class="modal-overlay" id="modalAddCustomer">
    <div class="modal-box" style="max-width: 560px;">
        <div class="modal-header">
            <h3 class="modal-title">
                <i class="bi bi-building-check" style="color: #059669; margin-right: 6px;"></i>
                Thêm Khách hàng Doanh nghiệp
            </h3>
            <button type="button" class="modal-close" onclick="closeModal('modalAddCustomer')">
                <i class="bi bi-x"></i>
            </button>
        </div>
        <form method="post" asp-page-handler="CreateCustomer">
            <div class="modal-body">
                <div class="info-box" style="margin-bottom: 16px;">
                    <i class="bi bi-info-circle" style="color: #059669; margin-right: 6px;"></i>
                    Mã KH sẽ được hệ thống tự động sinh tiếp theo (ví dụ: <code>KH-0@(Model.Customers.Count + 1)</code>).
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label class="form-label">Tên Doanh nghiệp / Khách hàng <span class="required-star">*</span></label>
                    <input type="text" name="CustomerName" class="form-control" placeholder="Ví dụ: Sumitomo Forestry Co., Ltd" required />
                </div>

                <div class="form-grid-2" style="margin-bottom: 14px;">
                    <div class="form-group">
                        <label class="form-label">Người đại diện / liên hệ</label>
                        <input type="text" name="ContactPerson" class="form-control" placeholder="Ví dụ: Mr. Kenji Sato / Trần Anh Tuấn" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" name="Phone" class="form-control" placeholder="Ví dụ: +81.3.3286.7000" />
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label class="form-label">Email giao dịch</label>
                    <input type="email" name="Email" class="form-control" placeholder="sales@sumitomoforestry.co.jp" />
                </div>

                <div class="form-group">
                    <label class="form-label">Địa chỉ xuất khẩu / Nhận hàng</label>
                    <textarea name="Address" class="form-control" rows="2" placeholder="Ví dụ: Chiyoda-ku, Tokyo, Japan / Chi nhánh TP.HCM"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('modalAddCustomer')">Hủy bỏ</button>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check2"></i> Lưu Khách hàng
                </button>
            </div>
        </form>
    </div>
</div>

<!-- =====================================================
     MODAL: CẬP NHẬT KHÁCH HÀNG (UPDATE CUSTOMER)
     ===================================================== -->
<div class="modal-overlay" id="modalEditCustomer">
    <div class="modal-box" style="max-width: 560px;">
        <div class="modal-header">
            <h3 class="modal-title">
                <i class="bi bi-pencil-square" style="color: #059669; margin-right: 6px;"></i>
                Cập nhật thông tin Khách hàng
            </h3>
            <button type="button" class="modal-close" onclick="closeModal('modalEditCustomer')">
                <i class="bi bi-x"></i>
            </button>
        </div>
        <form method="post" asp-page-handler="UpdateCustomer">
            <input type="hidden" name="CustomerId" id="editCustomerId" />
            <div class="modal-body">
                <div class="form-group" style="margin-bottom: 14px;">
                    <label class="form-label">Tên Doanh nghiệp / Khách hàng <span class="required-star">*</span></label>
                    <input type="text" name="CustomerName" id="editCustomerName" class="form-control" required />
                </div>

                <div class="form-grid-2" style="margin-bottom: 14px;">
                    <div class="form-group">
                        <label class="form-label">Người đại diện / liên hệ</label>
                        <input type="text" name="ContactPerson" id="editCustomerContact" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" name="Phone" id="editCustomerPhone" class="form-control" />
                    </div>
                </div>

                <div class="form-grid-2" style="margin-bottom: 14px;">
                    <div class="form-group">
                        <label class="form-label">Email giao dịch</label>
                        <input type="email" name="Email" id="editCustomerEmail" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Trạng thái hợp tác</label>
                        <select name="Status" id="editCustomerStatus" class="form-control">
                            <option value="Active">Đang hợp tác (Active)</option>
                            <option value="Inactive">Ngừng hợp tác (Inactive)</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Địa chỉ xuất khẩu / Nhận hàng</label>
                    <textarea name="Address" id="editCustomerAddress" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('modalEditCustomer')">Hủy bỏ</button>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check2"></i> Cập nhật thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

<!-- =====================================================
     MODAL: LỊCH SỬ GIAO DỊCH (HISTORY MODAL)
     ===================================================== -->
<div class="modal-overlay" id="modalHistory">
    <div class="modal-box" style="max-width: 680px;">
        <div class="modal-header">
            <h3 class="modal-title" id="historyModalTitle">Lịch sử giao dịch</h3>
            <button type="button" class="modal-close" onclick="closeModal('modalHistory')">
                <i class="bi bi-x"></i>
            </button>
        </div>
        <div class="modal-body" id="historyModalBody" style="max-height: 400px; overflow-y: auto;">
            <!-- Populated via JS -->
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline" onclick="closeModal('modalHistory')">Đóng</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Modal helpers
        function openModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.add('show');
        }

        function closeModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.remove('show');
        }

        // Add modals
        function openAddSupplierModal() {
            openModal('modalAddSupplier');
        }

        function openAddCustomerModal() {
            openModal('modalAddCustomer');
        }

        // Edit Supplier modal
        function openEditSupplierModal(id, name, contact, phone, email, address, status) {
            document.getElementById('editSupplierId').value = id;
            document.getElementById('editSupplierName').value = name;
            document.getElementById('editSupplierContact').value = contact === '—' ? '' : contact;
            document.getElementById('editSupplierPhone').value = phone === '—' ? '' : phone;
            document.getElementById('editSupplierEmail').value = email === '—' ? '' : email;
            document.getElementById('editSupplierAddress').value = address === '—' ? '' : address;
            document.getElementById('editSupplierStatus').value = status;
            openModal('modalEditSupplier');
        }

        // Edit Customer modal
        function openEditCustomerModal(id, name, contact, phone, email, address, status) {
            document.getElementById('editCustomerId').value = id;
            document.getElementById('editCustomerName').value = name;
            document.getElementById('editCustomerContact').value = contact === '—' ? '' : contact;
            document.getElementById('editCustomerPhone').value = phone === '—' ? '' : phone;
            document.getElementById('editCustomerEmail').value = email === '—' ? '' : email;
            document.getElementById('editCustomerAddress').value = address === '—' ? '' : address;
            document.getElementById('editCustomerStatus').value = status;
            openModal('modalEditCustomer');
        }

        // Data for history
        const suppliersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Suppliers));
        const customersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Customers));

        function viewSupplierHistory(id, code, name) {
            const sup = suppliersData.find(s => s.SupplierId === id);
            document.getElementById('historyModalTitle').innerHTML =
                `<i class="bi bi-clock-history" style="color: #4f46e5; margin-right: 6px;"></i> Lịch sử thu mua: <strong>${code} - ${name}</strong>`;

            let html = '';
            if (!sup || !sup.RecentPurchases || sup.RecentPurchases.length === 0) {
                html = `
                    <div class="empty-state" style="padding: 30px;">
                        <i class="bi bi-receipt" style="font-size: 32px; color: #94a3b8;"></i>
                        <p style="font-size: 13px; font-weight: 600; color: #64748b; margin-top: 8px;">Chưa có phiếu thu mua nguyên liệu nào với NCC này</p>
                    </div>`;
            } else {
                html = `
                    <div style="font-size: 11px; color: #64748b; margin-bottom: 10px;">
                        Tổng số giao dịch: <strong>${sup.RecentPurchases.length} phiếu</strong> | Tổng khối lượng: <strong>${Number(sup.TotalPurchasesKg).toLocaleString('vi-VN')} kg</strong>
                    </div>
                    <div class="table-wrapper">
                        <table class="data-table" style="font-size: 12px;">
                            <thead>
                                <tr>
                                    <th>Mã phiếu</th>
                                    <th>Ngày thu mua</th>
                                    <th style="text-align: right;">Khối lượng</th>
                                    <th style="text-align: right;">Thành tiền</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>`;
                sup.RecentPurchases.forEach(p => {
                    const dt = new Date(p.Date).toLocaleDateString('vi-VN');
                    html += `
                        <tr>
                            <td><code style="font-weight:700; color:#4f46e5;">${p.Code}</code></td>
                            <td>${dt}</td>
                            <td style="text-align: right; font-weight: 600;">${Number(p.Quantity).toLocaleString('vi-VN')} kg</td>
                            <td style="text-align: right; font-weight: 700; color: #0f172a;">${Number(p.TotalAmount).toLocaleString('vi-VN')} đ</td>
                            <td><span class="badge" style="background:#eef2ff; color:#4338ca; border-radius:20px; font-size:10px; padding:2px 7px;">${p.Status}</span></td>
                        </tr>`;
                });
                html += `</tbody></table></div>`;
            }
            document.getElementById('historyModalBody').innerHTML = html;
            openModal('modalHistory');
        }

        function viewCustomerHistory(id, code, name) {
            const cus = customersData.find(c => c.CustomerId === id);
            document.getElementById('historyModalTitle').innerHTML =
                `<i class="bi bi-clock-history" style="color: #059669; margin-right: 6px;"></i> Lịch sử đơn hàng: <strong>${code} - ${name}</strong>`;

            let html = '';
            if (!cus || !cus.RecentOrders || cus.RecentOrders.length === 0) {
                html = `
                    <div class="empty-state" style="padding: 30px;">
                        <i class="bi bi-box-seam" style="font-size: 32px; color: #94a3b8;"></i>
                        <p style="font-size: 13px; font-weight: 600; color: #64748b; margin-top: 8px;">Chưa có đơn đặt hàng nào từ khách hàng này</p>
                    </div>`;
            } else {
                html = `
                    <div style="font-size: 11px; color: #64748b; margin-bottom: 10px;">
                        Tổng số đơn: <strong>${cus.RecentOrders.length} đơn</strong> | Tổng khối lượng: <strong>${Number(cus.TotalOrderedKg).toLocaleString('vi-VN')} kg</strong>
                    </div>
                    <div class="table-wrapper">
                        <table class="data-table" style="font-size: 12px;">
                            <thead>
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Ngày đặt</th>
                                    <th style="text-align: right;">Khối lượng</th>
                                    <th style="text-align: right;">Đơn giá</th>
                                    <th style="text-align: right;">Tổng tiền</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>`;
                cus.RecentOrders.forEach(o => {
                    const dt = new Date(o.OrderDate).toLocaleDateString('vi-VN');
                    html += `
                        <tr>
                            <td><code style="font-weight:700; color:#059669;">${o.OrderCode}</code></td>
                            <td>${dt}</td>
                            <td style="text-align: right; font-weight: 600;">${Number(o.Quantity).toLocaleString('vi-VN')} kg</td>
                            <td style="text-align: right;">${Number(o.UnitPrice).toLocaleString('vi-VN')} đ</td>
                            <td style="text-align: right; font-weight: 700; color: #0f172a;">${Number(o.TotalAmount).toLocaleString('vi-VN')} đ</td>
                            <td><span class="badge" style="background:#ecfdf5; color:#065f46; border-radius:20px; font-size:10px; padding:2px 7px;">${o.Status}</span></td>
                        </tr>`;
                });
                html += `</tbody></table></div>`;
            }
            document.getElementById('historyModalBody').innerHTML = html;
            openModal('modalHistory');
        }

        // Close on escape or outside click
        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('show');
                }
            });
        });
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal-overlay.show').forEach(m => m.classList.remove('show'));
            }
        });
    </script>
}
