@model BATT_PPMS.Pages.Personnel.IndexModel
@using BATT_PPMS.Pages.Personnel
@using BATT_PPMS.Helpers
@using System.Globalization
@{
    var editing = Model.IsEditingPlan;
    var shifts = editing ? new[] { Model.EditShift! } : IndexModel.ProductionShifts;
    var today = Model.Today;
}

<form method="post" asp-page-handler="@(editing ? "EditPlan" : "CreatePlan")" class="labor-form"
      asp-route-PlanDate="@(!editing ? Model.DisplayDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : null)"
      asp-route-ShiftFilter="@(!editing ? Model.ShiftFilter : null)"
      asp-route-StatusFilter="@(!editing ? Model.StatusFilter : null)"
      asp-route-SearchTerm="@(!editing ? Model.SearchTerm : null)"
      data-today="@today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
      data-scheduled-url="@(!editing ? Url.Page("./Index", "ScheduledShifts") : null)">
    @if (editing) {
        <input asp-for="EditShift" type="hidden" />
    }
    <div class="labor-form-body">
        @if (!editing && Model.Create && !string.IsNullOrEmpty(Model.ErrorMessage)) {
            <p class="labor-message labor-message-error" role="alert" tabindex="-1" data-plan-error>
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i> @Model.ErrorMessage
            </p>
        }
        <div class="labor-form-date">
            <div>
                <label asp-for="NewPlanDate">Ngày sản xuất</label>
                <input asp-for="NewPlanDate" type="date" asp-format="{0:yyyy-MM-dd}"
                       min="@(!editing ? today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : null)"
                       max="2100-12-31" readonly="@editing" data-plan-date required />
            </div>
            @if (!editing) {
                <nav class="labor-shift-index" aria-label="Đến ca cần phân công">
                    @for (var i = 0; i < shifts.Count; i++) {
                        <a href="#labor-form-shift-@i">@shifts[i]</a>
                    }
                </nav>
            }
        </div>
        @if (!editing) {
            <p class="labor-message labor-message-error" role="status" data-plan-lookup-error hidden>Không tải được lịch ca. Hãy chọn lại ngày sản xuất.</p>
        }

        @for (var i = 0; i < shifts.Count; i++) {
            var shift = shifts[i];
            var shiftInput = Model.ShiftInputs[i];
            var scheduled = !editing && Model.ExistingCreateShifts.Contains(shift, StringComparer.OrdinalIgnoreCase);
            var mode = editing ? shiftInput.Mode ?? IndexModel.ShiftMode.Work : shiftInput.SelectedMode;
            var workersByStage = shiftInput.StaffByStage;
            <section class="labor-form-shift" aria-labelledby="labor-form-shift-@i" data-plan-shift="@shift">
                @if (!editing) {
                    <input type="hidden" name="ShiftInputs[@i].Included" value="false" />
                }
                <header>
                    <div>
                        <h2 id="labor-form-shift-@i">@shift</h2>
                        <span><i class="bi bi-clock" aria-hidden="true"></i> @IndexModel.ShiftHours(shift)</span>
                    </div>
                    @if (!editing) {
                        <div data-plan-existing hidden="@(!scheduled)">
                            <a class="labor-button" asp-page="./Index" asp-route-PlanDate="@today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                               asp-route-EditShift="@shift" aria-label="Chỉnh sửa @shift" data-plan-edit
                               hidden="@(Model.NewPlanDate != today)">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Chỉnh sửa
                            </a>
                            <span data-plan-readonly hidden="@(Model.NewPlanDate == today)">Đã có lịch</span>
                        </div>
                    }
                    <div class="labor-shift-choice" data-plan-choice hidden="@scheduled">
                        <label asp-for="ShiftInputs[i].Mode">Lịch @shift.ToLowerInvariant()</label>
                        <select asp-for="ShiftInputs[i].Mode" data-plan-mode disabled="@scheduled">
                            @if (!editing) {
                                <option value="" hidden selected="@(mode == IndexModel.ShiftMode.Skip)">Chọn lịch ca</option>
                            }
                            <option value="Work" selected="@(mode == IndexModel.ShiftMode.Work)">Phân công</option>
                            <option value="Off" selected="@(mode == IndexModel.ShiftMode.Off)" disabled="@(Model.NewPlanDate != today)">Nghỉ</option>
                        </select>
                    </div>
                </header>
                <fieldset class="labor-form-fields" data-plan-fields aria-labelledby="labor-form-shift-@i" hidden="@scheduled" disabled="@scheduled">
                    <div class="labor-form-quantities">
                        <div>
                            <label asp-for="ShiftInputs[i].ExpectedMaterialKg">Nguyên liệu tiêu thụ dự kiến cho 1 ca (kg)</label>
                            <input asp-for="ShiftInputs[i].ExpectedMaterialKg" type="number" min="0.01" max="9999999999.99" step="0.01" data-plan-quantity />
                        </div>
                        <div>
                            <label asp-for="ShiftInputs[i].ExpectedFinishedKg">Thành phẩm dự kiến (kg)</label>
                            <input asp-for="ShiftInputs[i].ExpectedFinishedKg" type="number" min="0.01" max="9999999999.99" step="0.01" data-plan-quantity />
                        </div>
                    </div>
                    <div class="labor-form-stages">
                        @for (var stageIndex = 0; stageIndex < IndexModel.ProductionStages.Count; stageIndex++) {
                            var stage = IndexModel.ProductionStages[stageIndex];
                            var fieldName = $"ShiftInputs[{i}].Stage{stageIndex + 1}StaffIds";
                            <div class="labor-stage-row">
                                <strong>@stage.Name</strong>
                                <details class="plan-staff-picker" data-staff-picker>
                                    <summary>
                                        <span data-staff-caption>Chọn công nhân</span>
                                        <span class="plan-staff-count" data-staff-count hidden></span>
                                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                    </summary>
                                    <div class="plan-staff-options" role="group" aria-label="@stage.Name, @shift">
                                        @foreach (var worker in Model.AvailableStaff) {
                                            var isSelected = workersByStage[stageIndex].Contains(worker.UserId);
                                            var isActiveStaff = worker.Status == StatusConstants.Active && worker.Role.RoleName == RoleConstants.Staff;
                                            if (!isSelected && !isActiveStaff) { continue; }
                                            <label class="plan-staff-option">
                                                <input type="checkbox" name="@fieldName" value="@worker.UserId"
                                                       checked="@isSelected" data-worker-name="@worker.FullName" />
                                                <span>@worker.FullName <small>@worker.Username</small></span>
                                            </label>
                                        }
                                        @if (Model.AvailableStaff.Count == 0) { <p>Chưa có công nhân đang hoạt động.</p> }
                                    </div>
                                </details>
                            </div>
                        }
                    </div>
                </fieldset>
                <fieldset class="labor-form-note" data-plan-note hidden="@scheduled" disabled="@scheduled">
                    <label asp-for="ShiftInputs[i].Note">Ghi chú</label>
                    <textarea asp-for="ShiftInputs[i].Note" maxlength="1000" rows="2"></textarea>
                </fieldset>
            </section>
        }
    </div>

    <footer class="labor-form-footer">
        @if (editing) {
            <a class="labor-button" asp-page="./Index" asp-route-PlanDate="@Model.NewPlanDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
               asp-route-ShiftFilter="@Model.EditShift">Hủy</a>
        } else {
            <button class="labor-button" type="button" data-plan-close>Hủy</button>
        }
        <button class="labor-button labor-primary" type="submit" disabled="@(!editing && Model.ExistingCreateShifts.Count == shifts.Count)">
            <i class="bi bi-check2-circle" aria-hidden="true"></i> @(editing ? "Lưu chỉnh sửa" : "Lưu phân công công việc")
        </button>
    </footer>
</form>
