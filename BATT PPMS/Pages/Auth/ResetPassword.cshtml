@page
@model BATT_PPMS.Pages.Auth.ResetPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Đặt lại mật khẩu - BATT PPMS";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-entry.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reset-password.css" asp-append-version="true" />
</head>
<body class="auth-entry auth-entry--login auth-entry--reset">
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-logo">
                <span class="login-brand-mark" aria-label="BATT">BATT</span>
                <p class="auth-brand-name">BATT PPMS</p>
                <h1>Đặt lại mật khẩu</h1>
                <p class="reset-subtitle">Nhập mã OTP qua tin nhắn và đặt mật khẩu mới</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success" role="status">
                    <i class="bi bi-check-circle alert-icon" aria-hidden="true"></i>
                    <span>@Model.SuccessMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle alert-icon" aria-hidden="true"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <div class="verification-summary">
                <div class="summary-item">
                    <span class="summary-label">Số điện thoại nhận mã:</span>
                    <span class="summary-value">@Model.MaskedPhone</span>
                </div>
            </div>

            <form method="post" asp-page-handler="ResetPassword">

                <div class="form-group">
                    <label asp-for="OtpCode">Mã OTP SMS (6 số) <span class="required">*</span></label>
                    <input asp-for="OtpCode" id="OtpCode" class="form-control reset-otp"
                           maxlength="6" inputmode="numeric" autocomplete="one-time-code" placeholder="Nhập mã gồm 6 số" required autofocus />
                    <span asp-validation-for="OtpCode" class="text-danger"></span>
                    <small class="form-hint">Kiểm tra tin nhắn trên điện thoại để nhận mã xác thực</small>
                </div>

                <div class="form-group">
                    <label asp-for="NewPassword">Mật khẩu mới <span class="required">*</span></label>
                    <input asp-for="NewPassword" type="password" class="form-control"
                           placeholder="Ít nhất 6 ký tự" required />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới <span class="required">*</span></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control"
                           placeholder="Nhập lại mật khẩu mới" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-login">
                    Hoàn tất đặt lại mật khẩu
                </button>
            </form>

            <div class="otp-actions-row">
                <form method="post" asp-page-handler="ResendOtp" style="display:inline;">
                    <button type="submit" class="btn-link-action">
                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Gửi lại mã qua SMS
                    </button>
                </form>
                <a asp-page="/Auth/ForgotPassword" class="btn-link-action">Nhập số điện thoại khác</a>
            </div>

            <div class="auth-footer-action">
                <a asp-page="/Auth/Login" class="auth-back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i> Quay lại đăng nhập</a>
            </div>
        </div>
    </div>
</body>
</html>
