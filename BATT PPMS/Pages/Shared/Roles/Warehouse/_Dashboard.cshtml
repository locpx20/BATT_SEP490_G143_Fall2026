@model BATT_PPMS.Pages.Dashboard.IndexModel
@using System.Globalization
@{
    var overview = Model.WarehouseOverview!;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
}
<div class="warehouse-overview">
    <header class="page-header"><h1 class="page-title"><i class="bi bi-grid" aria-hidden="true"></i> Tổng quan vận hành</h1></header>
    <div class="wo-stock-grid">
        <section class="wo-stock-card" aria-labelledby="rawStockTitle">
            <header><h2 id="rawStockTitle">Tồn kho nguyên liệu</h2><i class="bi bi-box" aria-hidden="true"></i></header>
            <div class="wo-stock-value"><strong>@overview.RawStockKg.ToString("N2",vi)</strong><span>kg</span></div>
            <p>Tổng khối lượng nguyên liệu hiện có</p>
        </section>
        <section class="wo-stock-card" aria-labelledby="finishedStockTitle">
            <header><h2 id="finishedStockTitle">Tồn kho thành phẩm</h2><i class="bi bi-stack" aria-hidden="true"></i></header>
            <div class="wo-stock-value"><strong>@overview.FinishedStockKg.ToString("N2",vi)</strong><span>kg</span></div>
            <p>@overview.FinishedLots.ToString("N0",vi) lô thành phẩm còn tồn</p>
        </section>
    </div>
    <section class="wo-history" aria-labelledby="warehouseHistoryTitle">
        <header class="wo-history-head"><h2 id="warehouseHistoryTitle"><i class="bi bi-clock-history" aria-hidden="true"></i> Lịch sử nhập / xuất kho</h2></header>
        <form method="get" class="wo-filters">
            <div class="wo-filter"><label for="movementFrom">Từ ngày</label><input id="movementFrom" type="date" name="MovementFrom" value="@Model.MovementFrom?.ToString("yyyy-MM-dd")" /></div>
            <div class="wo-filter"><label for="movementTo">Đến ngày</label><input id="movementTo" type="date" name="MovementTo" value="@Model.MovementTo?.ToString("yyyy-MM-dd")" /></div>
            <div class="wo-filter"><label for="movementDirection">Giao dịch</label><select id="movementDirection" name="MovementDirection"><option value="">Tất cả</option><option value="in" selected="@(Model.MovementDirection=="in")">Nhập kho</option><option value="out" selected="@(Model.MovementDirection=="out")">Xuất kho</option></select></div>
            <div class="wo-filter"><label for="movementGroup">Nhóm hàng</label><select id="movementGroup" name="MovementGroup"><option value="">Tất cả</option><option value="raw" selected="@(Model.MovementGroup=="raw")">Nguyên liệu</option><option value="finished" selected="@(Model.MovementGroup=="finished")">Thành phẩm</option></select></div>
            <button class="btn btn-primary" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> Lọc lịch sử</button>
        </form>
        @if(Model.WarehouseFilterError!=null){<p class="wo-filter-error" role="alert">@Model.WarehouseFilterError</p>}
        <div class="wo-table-scroll" role="region" aria-label="Lịch sử nhập xuất kho" tabindex="0">
            <table class="wo-table" aria-labelledby="warehouseHistoryTitle">
                <thead><tr><th scope="col">Thời gian</th><th scope="col">Giao dịch</th><th scope="col">Nhóm hàng</th><th scope="col">Mã phiếu / đơn</th><th scope="col">Nguyên liệu / Mã LOT</th><th scope="col" class="wo-quantity">Số lượng</th><th scope="col">Người xác nhận</th></tr></thead>
                <tbody>
                @foreach(var movement in overview.Movements){
                    <tr><td><time datetime="@movement.OccurredAt.ToString("yyyy-MM-ddTHH:mm:ss")">@movement.OccurredAt.ToString("dd/MM/yyyy")<small>@movement.OccurredAt.ToString("HH:mm")</small></time></td><td><span class="wo-direction @(movement.Incoming?"in":"out")"><i class="bi @(movement.Incoming?"bi-arrow-down-left":"bi-arrow-up-right")" aria-hidden="true"></i> @(movement.Incoming?"Nhập kho":"Xuất kho")</span></td><td>@movement.Group</td><td class="wo-reference">@movement.Reference</td><td class="wo-item">@movement.Item</td><td class="wo-quantity"><strong>@movement.Quantity.ToString("N2",vi)</strong> @movement.Unit</td><td>@movement.Actor</td></tr>
                }
                @if(overview.Movements.Count==0){<tr><td colspan="7" class="wo-empty">Chưa có giao dịch nhập / xuất kho phù hợp.</td></tr>}
                </tbody>
            </table>
        </div>
        <partial name="~/Pages/Shared/_AdminPagination.cshtml" model='new BATT_PPMS.Helpers.AdminPaginationViewModel(overview.Pagination,"/Dashboard/Index",new(){["MovementFrom"]=Model.MovementFrom?.ToString("yyyy-MM-dd"),["MovementTo"]=Model.MovementTo?.ToString("yyyy-MM-dd"),["MovementDirection"]=Model.MovementDirection,["MovementGroup"]=Model.MovementGroup})' />
    </section>
</div>
