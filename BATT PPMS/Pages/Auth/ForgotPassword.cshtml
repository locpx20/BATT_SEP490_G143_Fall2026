@page
@model BATT_PPMS.Pages.Auth.ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Đặt lại mật khẩu - BATT PPMS";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-entry.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reset-password.css" asp-append-version="true" />
</head>
<body class="auth-entry auth-entry--login auth-entry--forgot auth-entry--reset">
    <main class="login-wrapper">
        <div class="login-card">
            <div class="login-logo">
                <span class="login-brand-mark" aria-label="BATT">BATT</span>
                <p class="auth-brand-name">BATT PPMS</p>
                <h1>Đặt lại mật khẩu</h1>
                <p class="reset-subtitle">Nhập số điện thoại, mã OTP và mật khẩu mới</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle alert-icon" aria-hidden="true"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success" role="status"><i class="bi bi-check-circle alert-icon" aria-hidden="true"></i><span>@Model.SuccessMessage</span></div>
            }

            <form method="post">
                <div class="form-group">
                    <label for="AccountIdentifier">Số điện thoại đã đăng ký</label>
                    <input type="tel" id="AccountIdentifier" name="AccountIdentifier" class="form-control" inputmode="tel"
                           value="@Model.AccountIdentifier"
                           placeholder="Nhập số điện thoại" autocomplete="tel" required autofocus />
                </div>

                <button type="submit" class="btn-login">
                    <span>Gửi mã xác thực</span>
                </button>
            </form>

            <form method="post" asp-page-handler="Reset" class="reset-complete-form">
                <div class="form-group">
                    <label for="OtpCode">Mã OTP SMS (6 số)</label>
                    <input class="form-control reset-otp" id="OtpCode" name="OtpCode" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="Nhập mã gồm 6 số" required />
                </div>
                <div class="form-group">
                    <label for="NewPassword">Mật khẩu mới</label>
                    <input class="form-control" id="NewPassword" name="NewPassword" type="password" minlength="6" maxlength="100" autocomplete="new-password" placeholder="Ít nhất 6 ký tự" required />
                </div>
                <div class="form-group">
                    <label for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                    <input class="form-control" id="ConfirmPassword" name="ConfirmPassword" type="password" minlength="6" maxlength="100" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" required />
                </div>
                <button type="submit" class="btn-login">Hoàn tất đặt lại mật khẩu</button>
            </form>

            <div class="auth-footer-action">
                <a asp-page="/Auth/Login" class="auth-back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Quay lại đăng nhập</a>
            </div>
        </div>
    </main>
</body>
</html>
