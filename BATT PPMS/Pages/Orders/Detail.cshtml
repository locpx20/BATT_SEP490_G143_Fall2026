@page
@model BATT_PPMS.Pages.Orders.DetailModel
@{
    ViewData["Title"] = "Chi tiết Đơn hàng";
    ViewData["ActivePage"] = "OrderList";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Chi tiết Đơn hàng #@Model.Order?.OrderCode</h1>
    </div>
    <div class="page-actions">
        <a href="/Orders/Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
        @if (Model.Order?.Status == "Pending")
        {
            <a href="/Orders/Edit?id=@Model.Order.OrderId" class="btn btn-primary" id="btn-edit-order"><i class="bi bi-pencil"></i> Chỉnh sửa</a>
        }
    </div>
</div>
<div class="card">
    <div class="card-body">
        <p><em>TODO: Hiển thị chi tiết đơn hàng, nút Duyệt / Từ chối (cho Manager/Owner), và lịch sử thay đổi.</em></p>
    </div>
</div>
