@page
@model BATT_PPMS.Pages.Auth.FirstLoginPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đổi mật khẩu lần đầu - BATT PPMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-entry.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/first-login-password.css" asp-append-version="true" />
</head>
<body class="auth-entry auth-entry--login first-login-page">
    <main class="login-wrapper first-login-card">
        <div class="login-card">
            <div class="login-logo">
                <span class="login-brand-mark" aria-label="BATT">BATT</span>
                <p class="auth-brand-name">BATT PPMS</p>
                <h1>Đổi mật khẩu lần đầu</h1>
            </div>
            @if (Model.ErrorMessage != null)
            {
                <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
            }
            <form method="post">
                <div class="form-group">
                    <label class="form-label" for="new-password">Mật khẩu mới</label>
                    <input class="form-control" id="new-password" name="NewPassword" type="password" required minlength="6" maxlength="100" autocomplete="new-password" aria-describedby="password-hint" />
                    <p id="password-hint" class="form-hint">Ít nhất 6 ký tự, khác mật khẩu khởi tạo.</p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="confirm-password">Xác nhận mật khẩu mới</label>
                    <input class="form-control" id="confirm-password" name="ConfirmPassword" type="password" required minlength="6" maxlength="100" autocomplete="new-password" />
                </div>
                <button class="btn-login" type="submit"><i class="bi bi-check-lg" aria-hidden="true"></i>Lưu mật khẩu và tiếp tục</button>
                <a asp-page="/Auth/Logout" class="first-login-signout">Đăng xuất</a>
            </form>
        </div>
    </main>
</body>
</html>
