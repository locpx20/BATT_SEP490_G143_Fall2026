@page
@using BATT_PPMS.Helpers
@using BATT_PPMS.Pages.Orders
@model BATT_PPMS.Pages.Orders.DeleteModel
@{
    ViewData["Title"] = "Hủy yêu cầu bán hàng";
    ViewData["ActivePage"] = "OrderList";
    var o = Model.Order;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Hủy yêu cầu bán hàng</h1>
        <p class="page-subtitle">Các lô đã giữ chỗ cho yêu cầu này sẽ được giải phóng.</p>
    </div>
    <a href="/Orders/Detail?id=@o.OrderId" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="alert alert-warning" style="border-radius:12px;">
    <i class="bi bi-exclamation-triangle-fill" style="margin-right:8px;"></i>
    Bạn có chắc chắn muốn hủy yêu cầu <strong>@o.OrderCode</strong>?
</div>

<div class="card">
    <div class="card-body">
        <div class="form-grid">
            <div class="form-group"><span class="form-label">Mã yêu cầu</span><div><strong>@o.OrderCode</strong></div></div>
            <div class="form-group"><span class="form-label">Loại thành phẩm</span><div>@SalesFlow.GradeLabel(o.Grade)</div></div>
            <div class="form-group"><span class="form-label">Số lượng</span><div>@SalesFlow.Bags(o.Quantity) bao (@o.Quantity.ToString("N0") kg)</div></div>
            <div class="form-group"><span class="form-label">Trạng thái</span>
                <div><span class="badge @OrderWorkflow.Badge(o.Status)">@OrderWorkflow.Label(o.Status)</span></div>
            </div>
        </div>

        <form method="post" style="display:flex;gap:8px;margin-top:20px;">
            <button type="submit" class="btn btn-danger" id="btn-confirm-delete"><i class="bi bi-x-circle"></i> Xác nhận hủy</button>
            <a href="/Orders/Detail?id=@o.OrderId" class="btn btn-secondary">Không hủy</a>
        </form>
    </div>
</div>
