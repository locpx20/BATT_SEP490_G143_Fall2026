@page
@model BATT_PPMS.Pages.Admin.AuditLogs.IndexModel
@{
    ViewData["Title"] = "Nhật ký Kiểm toán Hệ thống (Audit Logs)";
    ViewData["ActivePage"] = "AuditLogs";
}

<!-- Header -->
<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title fs-3 fw-bold text-dark mb-1">
            <i class="bi bi-shield-check text-primary me-2"></i>Nhật ký Kiểm toán Hệ thống (Audit Logs)
        </h1>
        <p class="text-muted mb-0">Ghi nhận bất biến mọi thay đổi trạng thái, giao dịch vật lý, phê duyệt và người thực hiện</p>
    </div>
    <div class="page-actions">
        <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 fw-medium">
            <i class="bi bi-clock-history me-1"></i> Ghi nhận tự động (Bất biến)
        </span>
    </div>
</div>

<!-- Thanh Tìm kiếm & Lọc -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="Keyword" class="form-control border-start-0 ps-0"
                           placeholder="Tìm theo hành động, người thực hiện, mã hồ sơ..." value="@Model.Keyword" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="ModuleFilter" class="form-select">
                    <option value="all">-- Tất cả đối tượng nghiệp vụ --</option>
                    <option value="Kho vận" selected="@(Model.ModuleFilter == "Kho vận")">Kho vận &amp; Xuất xưởng</option>
                    <option value="Thu mua" selected="@(Model.ModuleFilter == "Thu mua")">Thu mua nguyên liệu</option>
                    <option value="QC" selected="@(Model.ModuleFilter == "QC")">Kiểm tra chất lượng (QC)</option>
                    <option value="Tài khoản" selected="@(Model.ModuleFilter == "Tài khoản")">Quản trị tài khoản &amp; Bảo mật</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">
                    <i class="bi bi-filter"></i> Lọc
                </button>
                @if (!string.IsNullOrEmpty(Model.Keyword) || (!string.IsNullOrEmpty(Model.ModuleFilter) && Model.ModuleFilter != "all"))
                {
                    <a asp-page="/Admin/AuditLogs/Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng Nhật ký Audit Logs -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #f8fafc; font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b;">
                    <tr>
                        <th class="ps-4 py-3" style="width: 160px;">Thời gian</th>
                        <th class="py-3" style="width: 200px;">Người thực hiện</th>
                        <th class="py-3" style="width: 220px;">Hành động</th>
                        <th class="py-3" style="width: 130px;">Mã hồ sơ</th>
                        <th class="py-3" style="width: 220px;">Chuyển trạng thái</th>
                        <th class="py-3 pe-4">Chi tiết nghiệp vụ &amp; Lý do</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (!Model.LogEntries.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Không có bản ghi kiểm toán nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model.LogEntries)
                        {
                            <tr>
                                <!-- Thời gian -->
                                <td class="ps-4">
                                    <span class="small font-monospace text-secondary">
                                        @log.Timestamp.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </td>

                                <!-- Người thực hiện -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-secondary bg-opacity-10 text-secondary d-flex align-items-center justify-content-center"
                                             style="width: 28px; height: 28px; font-size: 12px; font-weight: 700;">
                                            @(log.Actor.Length > 0 ? log.Actor[0].ToString().ToUpper() : "U")
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark small">@log.Actor</div>
                                            <span class="badge bg-light text-muted border px-1" style="font-size: 10px;">
                                                @log.ActorRole
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Hành động -->
                                <td>
                                    <div class="fw-bold small text-dark">@log.Action</div>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 10px;">
                                        @log.Module
                                    </span>
                                </td>

                                <!-- Mã hồ sơ -->
                                <td>
                                    <span class="badge font-monospace px-2 py-1" style="background-color: #f1f5f9; color: #475569; font-size: 11.5px; border: 1px solid #cbd5e1;">
                                        @log.RecordCode
                                    </span>
                                </td>

                                <!-- Chuyển trạng thái -->
                                <td>
                                    <span class="badge font-monospace px-2 py-1" style="background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-size: 11px;">
                                        @log.StatusTransition
                                    </span>
                                </td>

                                <!-- Chi tiết -->
                                <td class="pe-4">
                                    <span class="small text-secondary" style="line-height: 1.4;">
                                        @log.Details
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
