@page
@using BATT_PPMS.Helpers
@using BATT_PPMS.Pages.Orders
@model BATT_PPMS.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Yêu cầu bán hàng";
    ViewData["ActivePage"] = "OrderList";
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success" style="border-radius:12px;">
        <i class="bi bi-check-circle-fill" style="margin-right:8px;"></i><span>@Model.SuccessMessage</span>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" style="border-radius:12px;">
        <i class="bi bi-exclamation-triangle-fill" style="margin-right:8px;"></i><span>@Model.ErrorMessage</span>
    </div>
}

<div class="page-header">
    <div>
        <h1 class="page-title">@(Model.IsOwnerView ? "Duyệt yêu cầu bán hàng" : "Yêu cầu bán hàng")</h1>
        <p class="page-subtitle">@Model.TotalCount yêu cầu@(string.IsNullOrWhiteSpace(Model.SearchTerm) && string.IsNullOrWhiteSpace(Model.Status) ? "" : " phù hợp bộ lọc")@(Model.PendingCount > 0 ? $" · {Model.PendingCount} yêu cầu chờ Owner duyệt" : "")</p>
    </div>
    @if (Model.CanManage)
    {
        <div class="page-actions">
            <a href="/Orders/Create" class="btn btn-primary" id="btn-create-order">
                <i class="bi bi-plus-lg"></i> Tạo yêu cầu bán
            </a>
        </div>
    }
</div>

<div class="card">
    <div class="card-header">
        <form method="get" class="filter-bar" style="margin-bottom:0;flex:1;">
            <div style="position:relative;">
                <i class="bi bi-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:#96a298;"></i>
                <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" style="padding-left:36px;"
                       placeholder="Tìm theo mã yêu cầu hoặc khách hàng..." id="searchOrder" />
            </div>
            <select class="form-control" style="width:auto;" name="Status" id="filterStatus" onchange="this.form.submit()">
                <option value="">Tất cả trạng thái</option>
                @foreach (var s in OrderWorkflow.AllStatuses)
                {
                    <option value="@s" selected="@(Model.Status == s)">@OrderWorkflow.Label(s)</option>
                }
            </select>
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Lọc</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.Status))
            {
                <a href="/Orders/Index" class="btn btn-secondary">Xóa lọc</a>
            }
        </form>
    </div>

    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Mã yêu cầu</th>
                    <th>Loại</th>
                    <th>Số lượng</th>
                    <th>Khách hàng</th>
                    <th>Tổng tiền</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr>
                        <td colspan="9">
                            <div class="empty-state">
                                <i class="bi bi-clipboard-x"></i>
                                <h3>Không có yêu cầu bán nào</h3>
                                @if (Model.CanManage)
                                {
                                    <p>Nhấn "Tạo yêu cầu bán" để bắt đầu</p>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @{ var rowNo = (Model.PageNumber - 1) * IndexModel.PageSize; }
                @foreach (var order in Model.Orders)
                {
                    rowNo++;
                    <tr>
                        <td>@rowNo</td>
                        <td><strong>@order.OrderCode</strong></td>
                        <td>@SalesFlow.GradeLabel(order.Grade)</td>
                        <td>@SalesFlow.Bags(order.Quantity) bao<br /><span class="form-hint">@order.Quantity.ToString("N0") kg</span></td>
                        <td>@(order.Customer?.CustomerName ?? "—")</td>
                        <td>@(order.UnitPrice.HasValue ? order.TotalAmount.ToString("N0") + " ₫" : "—")</td>
                        <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        @{ var stage = OrderWorkflow.Stage(order); }
                        <td><span class="badge @stage.Badge">@stage.Label</span></td>
                        <td style="white-space:nowrap;">
                            <a href="/Orders/Detail?id=@order.OrderId" class="btn btn-sm btn-outline" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                            @if (Model.CanManage && OrderWorkflow.CanModify(order.Status))
                            {
                                <a href="/Orders/Edit?id=@order.OrderId" class="btn btn-sm btn-outline" title="Chỉnh sửa"><i class="bi bi-pencil"></i></a>
                                <a href="/Orders/Delete?id=@order.OrderId" class="btn btn-sm btn-outline" title="Hủy yêu cầu" style="color:#94473e;"><i class="bi bi-x-circle"></i></a>
                            }
                            @if (Model.IsOwnerView && order.Status == StatusConstants.Pending)
                            {
                                <a href="/Orders/Detail?id=@order.OrderId" class="btn btn-sm btn-primary" title="Duyệt yêu cầu">Duyệt</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="pagination" style="padding:14px;">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <a class="page-link @(p == Model.PageNumber ? "active" : "")"
                   href="/Orders/Index?PageNumber=@p&SearchTerm=@Uri.EscapeDataString(Model.SearchTerm ?? "")&Status=@Uri.EscapeDataString(Model.Status ?? "")">@p</a>
            }
        </div>
    }
</div>
