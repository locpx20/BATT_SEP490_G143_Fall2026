@using BATT_PPMS.Models
@using BATT_PPMS.Services
@model (ProductionQualityRequest Request, ProductionQcResult? Result)
@{
    var q = Model.Request;
    var result = Model.Result;
    var inspection = q.Inspection;
    var detailId = $"qc-details-{inspection.InspectionId}";
}
<div class="modal fade closeout-modal qc-modal qc-detail-modal" id="@detailId" tabindex="-1" aria-labelledby="@(detailId + "-title")" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <section class="modal-content">
            <header class="modal-header qc-centered-header">
                <h2 id="@(detailId + "-title")" class="modal-title"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Chi tiết phiếu QC</h2>
                <button type="button" class="closeout-modal-close" data-bs-dismiss="modal" aria-label="Đóng">×</button>
            </header>
            <div class="modal-body qc-detail-body">
                <section class="qc-lot-summary" aria-label="Thông tin lô thành phẩm">
                    <div class="qc-detail-overview">
                        <div class="qc-detail-lot">
                            <span>Mã lô</span>
                            <code>@inspection.Batch.BagNumber</code>
                        </div>
                        <div class="qc-detail-badges">
                            @if (inspection.Result != null) {
                                <span class="closeout-status @(inspection.Result == "Pass" ? "completed" : "fail")">
                                    <i class="bi @(inspection.Result == "Pass" ? "bi-check-circle" : "bi-x-circle")" aria-hidden="true"></i>
                                    @ProductionFlow.Label(inspection.Result)
                                </span>
                            }
                            @if (result != null) {
                                <span class="closeout-status qc-grade">Hàng loại @result.Grade</span>
                            }
                            @if (inspection.Result == null) {
                                <span class="closeout-status">@ProductionFlow.QcStatusLabel(inspection.Status)</span>
                            }
                        </div>
                    </div>
                    <div class="qc-fields qc-detail-summary-fields">
                        <div><span>Ngày / ca sản xuất</span><strong>@inspection.Batch.ProductionDate.ToString("dd/MM/yyyy") · @(q.Assignment.Shift ?? "Chưa ghi nhận ca")</strong></div>
                        <div><span>Mã phiếu QC</span><code>@inspection.InspectionCode</code></div>
                    </div>
                </section>
                <fieldset class="qc-result-section">
                    <legend>Thông tin kiểm tra</legend>
                    <dl class="qc-details qc-detail-metadata">
                        <div><dt>Người gửi</dt><dd>@(inspection.RequestedByNavigation?.FullName ?? "—")</dd></div>
                        <div><dt>Nhân viên QC</dt><dd>@(inspection.InspectedByNavigation?.FullName ?? "—")</dd></div>
                        <div><dt>Thời điểm kiểm tra</dt><dd>@(inspection.InspectDate?.ToString("HH:mm dd/MM/yyyy") ?? "—")</dd></div>
                        <div><dt>Trạng thái</dt><dd>@ProductionFlow.QcStatusLabel(inspection.Status)</dd></div>
                    </dl>
                </fieldset>
                @if (result != null) {
                    <fieldset class="qc-result-section">
                        <legend>Chỉ tiêu kiểm tra</legend>
                        <dl class="qc-details qc-detail-measurements">
                            <div><dt>Màu sắc viên</dt><dd>@result.PelletColor</dd></div>
                            <div><dt>Độ dài viên</dt><dd>@result.PelletLengthMm.ToString("0.##") mm</dd></div>
                            <div><dt>Độ nén</dt><dd>@result.Compaction</dd></div>
                            <div><dt>Độ tro</dt><dd>@result.AshPercent.ToString("0.##")%</dd></div>
                            <div><dt>Tạp chất</dt><dd>@(result.HasImpurities ? "Có" : "Không")</dd></div>
                            <div class="qc-wide"><dt>Mô tả hình thức viên</dt><dd>@result.PelletDescription</dd></div>
                        </dl>
                    </fieldset>
                }
                @if (!string.IsNullOrWhiteSpace(inspection.Note)) {
                    <fieldset class="qc-result-section">
                        <legend>Ghi chú và kết luận</legend>
                        <p class="qc-detail-note">@inspection.Note</p>
                    </fieldset>
                }
            </div>
            @if (q.ResultImage != null) {
                <footer class="modal-footer qc-detail-footer">
                    <a class="closeout-button secondary" asp-page="/QC/Index" asp-page-handler="Image" asp-route-requestId="@q.RequestId" target="_blank" rel="noopener">
                        <i class="bi bi-image" aria-hidden="true"></i> Xem ảnh kết quả
                    </a>
                </footer>
            }
        </section>
    </div>
</div>
