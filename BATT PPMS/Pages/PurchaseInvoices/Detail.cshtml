@section Scripts {
    <script>
        function openPmModal(id) { document.getElementById(id).classList.add('open'); }
        function closePmModal(id) { document.getElementById(id).classList.remove('open'); }

        var defaultRemainingQty = @Model.RemainingQuantity.ToString("0.##", CultureInfo.InvariantCulture);
        var plannedTotalQty = @Model.PlannedQuantity.ToString("0.##", CultureInfo.InvariantCulture);
        var currentIrUnitPrice = 0;

        function openCreateNewReceiptModal() {
            document.getElementById('editReceiptIdInput').value = '';
            document.getElementById('createReceiptModalTitle').innerText = 'Tạo phiếu mua hàng (Purchase Order)';
            document.getElementById('createReceiptSubmitBtn').innerText = 'Gửi phiếu mua hàng chờ Manager duyệt';
            var qtyInput = document.getElementById('weighedQuantityInput');
            if (qtyInput) {
                qtyInput.max = defaultRemainingQty;
                qtyInput.value = '';
            }
            var qtyHint = document.getElementById('weighedQuantityHint');
            if (qtyHint) {
                qtyHint.innerText = 'kg (Còn lại tối đa: ' + Number(defaultRemainingQty).toLocaleString('vi-VN') + ' / ' + Number(plannedTotalQty).toLocaleString('vi-VN') + ' kg)';
            }
            var scaleInput = document.getElementById('scalePhotoInput');
            if (scaleInput) scaleInput.required = true;
            var star = document.getElementById('scalePhotoReqStar');
            if (star) star.style.display = '';
            openPmModal('createReceiptModal');
        }

        function openEditReceiptModal(receiptId, code, supplierId, qty, price) {
            document.getElementById('editReceiptIdInput').value = receiptId;
            document.getElementById('createReceiptModalTitle').innerText = 'Sửa & Gửi lại đơn mua ' + code;
            document.getElementById('createReceiptSubmitBtn').innerText = 'Cập nhật & Gửi lại Manager duyệt';
            document.getElementById('supplierIdSelect').value = supplierId;
            var maxEditQty = Number(defaultRemainingQty) + Number(qty);
            var qtyInput = document.getElementById('weighedQuantityInput');
            if (qtyInput) {
                qtyInput.max = maxEditQty;
                qtyInput.value = qty;
            }
            var qtyHint = document.getElementById('weighedQuantityHint');
            if (qtyHint) {
                qtyHint.innerText = 'kg (Tối đa cho phép: ' + maxEditQty.toLocaleString('vi-VN') + ' / ' + Number(plannedTotalQty).toLocaleString('vi-VN') + ' kg)';
            }
            document.getElementById('actualPriceInput').value = price;
            var scaleInput = document.getElementById('scalePhotoInput');
            if (scaleInput) scaleInput.required = false;
            var star = document.getElementById('scalePhotoReqStar');
            if (star) star.style.display = 'none';
            openPmModal('createReceiptModal');
        }

        function openRejectOrderModal(receiptId, code) {
            document.getElementById('rejectOrderReceiptId').value = receiptId;
            document.getElementById('rejectOrderCode').innerText = code;
            openPmModal('rejectOrderModal');
        }

        function openCreateInboundRequestModal(receiptId, code, supplierName, remainingQtyRaw, totalOrderQtyText, priceRaw, priceText) {
            document.getElementById('irReceiptIdInput').value = receiptId;
            document.getElementById('irModalCodeText').innerText = code;
            document.getElementById('irCodeInput').value = code;
            document.getElementById('irSupplierInput').value = supplierName;
            currentIrUnitPrice = parseFloat(priceRaw) || 0;

            var qtyInput = document.getElementById('irDeliveryQtyInput');
            var remNum = parseFloat(remainingQtyRaw) || 0;
            if (qtyInput) {
                qtyInput.max = remNum;
                qtyInput.value = remNum;
            }
            var qtyHint = document.getElementById('irQtyHint');
            if (qtyHint) {
                qtyHint.innerText = 'Còn lại của ' + code + ': ' + remNum.toLocaleString('vi-VN') + ' / ' + totalOrderQtyText + ' kg (có thể chia làm nhiều đợt IR)';
            }
            document.getElementById('irPriceInput').value = priceText + ' VNĐ / kg';
            updateIrTotalPreview();

            var dtInput = document.getElementById('irDeliveryTimeInput');
            if (dtInput && !dtInput.value) {
                var now = new Date();
                var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
                dtInput.value = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate()) + 'T' + pad(now.getHours()) + ':' + pad(now.getMinutes());
            }
            openPmModal('createInboundRequestModal');
            var plateInput = document.getElementById('irLicensePlateInput');
            if (plateInput) plateInput.focus();
        }

        function updateIrTotalPreview() {
            var q = parseFloat(document.getElementById('irDeliveryQtyInput').value) || 0;
            var total = Math.round(q * currentIrUnitPrice);
            var totalHint = document.getElementById('irTotalHint');
            if (totalHint) {
                totalHint.innerText = 'Thành tiền đợt giao này: ' + total.toLocaleString('vi-VN') + ' VNĐ';
            }
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') document.querySelectorAll('.pm-overlay.open').forEach(function (m) { m.classList.remove('open'); });
        });

        // Hỗ trợ dán ảnh trực tiếp (Ctrl+V) vào Ảnh minh chứng / hàng hóa
        document.addEventListener('paste', function (e) {
            var modal = document.getElementById('createReceiptModal');
            if (!modal || !modal.classList.contains('open')) return;
            var items = e.clipboardData && e.clipboardData.items;
            if (!items) return;
            for (var i = 0; i < items.length; i++) {
                if (items[i].type.indexOf('image') !== -1) {
                    var file = items[i].getAsFile();
                    if (file) {
                        var dt = new DataTransfer();
                        dt.items.add(file);
                        var scaleInput = document.getElementById('scalePhotoInput');
                        if (scaleInput) {
                            scaleInput.files = dt.files;
                        }
                    }
                    break;
                }
            }
        });

        // Xem chi tiết Phiếu mua hàng (PO - Bảng 1)
        document.querySelectorAll('.po-detail-link').forEach(function (a) {
            a.addEventListener('click', function () {
                var d = a.dataset;
                document.getElementById('podCode').innerText = d.code;
                document.getElementById('podSupplier').innerText = d.supplier;
                document.getElementById('podStatus').innerText = d.status;
                document.getElementById('podQty').innerText = d.qty + ' kg';
                document.getElementById('podPrice').innerText = d.price + ' VNĐ/kg';
                document.getElementById('podTotal').innerText = d.total + ' VNĐ';
                document.getElementById('podReqIr').innerText = d.reqIr + ' kg (' + d.irCount + ' phiếu IR)';
                document.getElementById('podIrCodes').innerText = d.irCodes || 'Chưa tạo IR';
                document.getElementById('podRecIr').innerText = d.recIr + ' kg';
                document.getElementById('podBy').innerText = d.by;
                document.getElementById('podAt').innerText = d.at;

                var rejWrap = document.getElementById('podRejectionWrap');
                if (d.rejection) {
                    rejWrap.style.display = '';
                    document.getElementById('podRejection').innerText = d.rejection;
                } else {
                    rejWrap.style.display = 'none';
                }

                document.getElementById('podScale').src = d.scale;
                document.getElementById('podScaleLink').href = d.scale;
                var invWrap = document.getElementById('podInvoiceWrap');
                if (d.invoice) {
                    invWrap.style.display = '';
                    document.getElementById('podInvoice').src = d.invoice;
                    document.getElementById('podInvoiceLink').href = d.invoice;
                } else {
                    invWrap.style.display = 'none';
                }
                openPmModal('poDetailModal');
            });
        });

        // Xem chi tiết Yêu cầu nhập kho (IR - Bảng 2)
        document.querySelectorAll('.ir-detail-link').forEach(function (a) {
            a.addEventListener('click', function () {
                var d = a.dataset;
                document.getElementById('irdCode').innerText = d.irCode;
                document.getElementById('irdIrCode').innerText = d.irCode;
                document.getElementById('irdPoCode').innerText = d.poCode;
                document.getElementById('irdSupplier').innerText = d.supplier;
                document.getElementById('irdStatus').innerText = d.status;
                document.getElementById('irdDeliveryQty').innerText = d.deliveryQty + ' kg';
                document.getElementById('irdImportedQty').innerText = d.importedQty ? (d.importedQty + ' kg') : 'Chưa cân tại kho';
                document.getElementById('irdPrice').innerText = d.price + ' VNĐ/kg';
                document.getElementById('irdTotal').innerText = d.total + ' VNĐ';
                document.getElementById('irdLicensePlate').innerText = d.licensePlate || '—';
                document.getElementById('irdDriverName').innerText = d.driverName || '—';
                document.getElementById('irdDeliveryTime').innerText = d.deliveryTime || '—';
                document.getElementById('irdByAt').innerText = d.by + ' · ' + d.at;

                var importCodeEl = document.getElementById('irdImportCode');
                if (d.importCode && d.importCode !== 'Chưa lập') {
                    var pnkUrl = '/Inventory/Index?Tab=raw&ViewMode=imports&SearchTerm=' + encodeURIComponent(d.importCode);
                    importCodeEl.innerHTML = '<a href="' + pnkUrl + '" style="color: #1a4332; text-decoration: underline; display: inline-flex; align-items: center; gap: 4px;" title="Mở Phiếu nhập kho ' + d.importCode + '"><span>' + d.importCode + '</span><i class="bi bi-box-arrow-up-right" style="font-size: 11px;"></i></a>';
                } else {
                    importCodeEl.innerText = 'Chưa lập';
                }
                document.getElementById('irdImportByApproved').innerText = (d.importBy || '—') + ' / ' + (d.approvedBy || '—');

                var noteWrap = document.getElementById('irdNoteWrap');
                if (d.note) {
                    noteWrap.style.display = '';
                    document.getElementById('irdNote').innerText = d.note;
                } else {
                    noteWrap.style.display = 'none';
                }

                var rejWrap = document.getElementById('irdRejectionWrap');
                if (d.rejection) {
                    rejWrap.style.display = '';
                    document.getElementById('irdRejection').innerText = d.rejection;
                } else {
                    rejWrap.style.display = 'none';
                }

                document.getElementById('irdScale').src = d.scale;
                document.getElementById('irdScaleLink').href = d.scale;
                var invWrap = document.getElementById('irdInvoiceWrap');
                if (d.invoice) {
                    invWrap.style.display = '';
                    document.getElementById('irdInvoice').src = d.invoice;
                    document.getElementById('irdInvoiceLink').href = d.invoice;
                } else {
                    invWrap.style.display = 'none';
                }
                openPmModal('irDetailModal');
            });
        });
    </script>
}

@section Styles {
    <style>
        .pm-overlay {
            position: fixed; inset: 0;
            background: rgba(15, 23, 42, .5);
            backdrop-filter: blur(3px);
            z-index: 1000;
            display: none;
            align-items: center; justify-content: center;
            padding: 16px;
            overflow-y: auto;
        }
        .pm-overlay.open { display: flex; }
        .pm-dialog {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            width: 100%; max-width: 560px;
            max-height: calc(100vh - 32px);
            display: flex;
            flex-direction: column;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, .15), 0 8px 10px -6px rgba(0, 0, 0, .1);
            margin: auto;
            overflow: hidden;
        }
        .pm-dialog > form {
            display: flex;
            flex-direction: column;
            max-height: calc(100vh - 32px);
            margin: 0;
        }
        .pm-dialog.pm-lg { max-width: 660px; }
        .pm-head {
            display: flex; align-items: center; justify-content: space-between;
            padding: 16px 22px; border-bottom: 1px solid #f1f5f9;
            flex-shrink: 0;
        }
        .pm-title { font-size: 16px; font-weight: 700; color: #1e293b; margin: 0; }
        .pm-close {
            width: 30px; height: 30px; border: none; background: none; border-radius: 8px;
            font-size: 18px; color: #64748b; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
        }
        .pm-close:hover { background: #f1f5f9; }
        .pm-body {
            padding: 18px 22px;
            overflow-y: auto;
            flex: 1 1 auto;
        }
        .pm-foot {
            display: flex; justify-content: flex-end; gap: 10px;
            padding: 12px 22px; border-top: 1px solid #f1f5f9;
            background: #ffffff;
            flex-shrink: 0;
        }
        .pm-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 14px;
        }
        .pm-grid > div { min-width: 0; }
        .pm-grid .pm-full { grid-column: 1 / -1; min-width: 0; }
        .pm-label { display: block; font-size: 13px; font-weight: 600; color: #1e293b; margin-bottom: 5px; }
        .pm-input {
            width: 100%; height: 40px; padding: 0 12px;
            border: 1px solid #cbd5e1; border-radius: 8px;
            font-size: 13.5px; color: #0f172a; background: #ffffff;
            box-sizing: border-box;
            max-width: 100%;
        }
        textarea.pm-input {
            height: auto;
            min-height: 76px;
            padding: 10px 12px;
            line-height: 1.45;
            resize: vertical;
        }
        .pm-input:focus { outline: none; border-color: #193f35; box-shadow: 0 0 0 3px rgba(25, 63, 53, .12); }
        .pm-input[readonly] { background: #f4f2ea; font-weight: 600; cursor: not-allowed; }
        .pm-hint { font-size: 12px; color: #64748b; margin-top: 4px; display: block; }
        .pm-btn-cancel {
            background: #ffffff; border: 1px solid #cbd5e1; color: #475569;
            border-radius: 8px; padding: 8px 18px; font-size: 13px; font-weight: 500; cursor: pointer;
        }
        .pm-btn-primary {
            background: #193f35; color: #ffffff; border: none;
            border-radius: 8px; padding: 8px 20px; font-size: 13px; font-weight: 600; cursor: pointer;
        }
    </style>
}
