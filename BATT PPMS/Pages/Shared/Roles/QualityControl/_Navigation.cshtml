@model string
@{ var status = Context.Request.Query["StatusFilter"].ToString(); }
<div class="owner-nav-section">
    <div class="owner-nav-label">Kiểm soát chất lượng</div>
    <a class="nav-item @(Model == "QC" && status != "Completed" ? "active" : "")" href="/QC/Index"><i class="bi bi-patch-check" aria-hidden="true"></i><span>Yêu cầu kiểm tra</span></a>
    <a class="nav-item @(Model == "QC" && status == "Completed" ? "active" : "")" href="/QC/Index?StatusFilter=Completed"><i class="bi bi-clipboard-check" aria-hidden="true"></i><span>Kết quả đã kiểm tra</span></a>
</div>
