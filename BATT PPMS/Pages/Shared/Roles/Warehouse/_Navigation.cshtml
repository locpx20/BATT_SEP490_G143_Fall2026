@model BATT_PPMS.Helpers.WarehouseNavigationModel
@{
    var tab = Context.Request.Query["tab"].ToString();
    var viewMode = Context.Request.Query["ViewMode"].ToString();
    var isImportsView = string.Equals(viewMode, "imports", StringComparison.OrdinalIgnoreCase);
    var inventoryRaw = Model.ActivePage == "Inventory" && tab != "finished";
    var requestsActive = inventoryRaw && !isImportsView;
    var pnkActive = inventoryRaw && isImportsView;
    var usageActive = Model.ActivePage == "MaterialUsage";
    var finishedStockActive = Model.ActivePage == "Inventory" && tab == "finished";
    var finishedReceiptsActive = Model.ActivePage == "Warehouse" && tab != "plans";
}
<div class="warehouse-inbox-nav" data-warehouse-inbox>
<div class="owner-nav-section">
    <a class="nav-item @(Model.ActivePage == "Dashboard" ? "active" : "")" href="/Dashboard/Index"><i class="bi bi-grid" aria-hidden="true"></i><span>Tổng quan vận hành</span></a>
    <a class="nav-item @(Model.ActivePage == "Warehouse" && tab == "plans" ? "active" : "")" href="/Warehouse/Index?tab=plans"><i class="bi bi-calendar-week" aria-hidden="true"></i><span>Lịch phân công lao động</span><span class="warehouse-pending-count" data-warehouse-count="plans" hidden="@(Model.Counts.Plans == 0)" aria-label="@Model.Counts.Plans thông báo chưa đọc">@Model.Counts.Plans</span></a>
</div>
<div class="owner-nav-section">
    <div class="owner-nav-label">Tồn kho</div>
    <details class="owner-nav-details warehouse-nav-group" open="@(inventoryRaw || usageActive)">
        <summary class="nav-item"><i class="bi bi-box" aria-hidden="true"></i><span>Kho nguyên liệu</span><span class="warehouse-pending-count" data-warehouse-count="total" hidden="@(Model.Counts.Total == 0)" aria-label="@Model.Counts.Total phiếu nguyên liệu chờ xử lý">@Model.Counts.Total</span><i class="bi bi-chevron-down" aria-hidden="true"></i></summary>
        <a class="nav-item @(requestsActive ? "active" : "")" href="/Inventory/Index?tab=raw&amp;ViewMode=requests"><i class="bi bi-inbox" aria-hidden="true"></i><span>Yêu cầu nhập kho (IR)</span><span class="warehouse-pending-count" data-warehouse-count="imports" hidden="@(Model.Counts.Imports == 0)" aria-label="@Model.Counts.Imports phiếu nhập kho nguyên liệu chờ xử lý">@Model.Counts.Imports</span></a>
        <a class="nav-item @(pnkActive ? "active" : "")" href="/Inventory/Index?tab=raw&amp;ViewMode=imports"><i class="bi bi-file-earmark-check" aria-hidden="true"></i><span>Phiếu nhập kho (PNK)</span></a>
        <a class="nav-item @(usageActive ? "active" : "")" href="/Warehouse/Consumption"><i class="bi bi-box-arrow-up" aria-hidden="true"></i><span>Phiếu tiêu hao nguyên liệu</span><span class="warehouse-pending-count" data-warehouse-count="consumption" hidden="@(Model.Counts.Consumption == 0)" aria-label="@Model.Counts.Consumption phiếu tiêu hao nguyên liệu chờ xử lý">@Model.Counts.Consumption</span></a>
    </details>
    <details class="owner-nav-details warehouse-nav-group" open="@(finishedStockActive || finishedReceiptsActive)">
        <summary class="nav-item">
            <i class="bi bi-stack" aria-hidden="true"></i><span>Kho thành phẩm</span>
            <span class="warehouse-pending-count" data-warehouse-count="finishedTotal" hidden="@(Model.Counts.FinishedTotal == 0)" aria-label="@Model.Counts.FinishedTotal mục kho thành phẩm cần xem hoặc xử lý">@Model.Counts.FinishedTotal</span>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
        </summary>
        <a class="nav-item @(finishedStockActive ? "active" : "")" aria-current="@(finishedStockActive ? "page" : null)" href="/Inventory/Index?tab=finished">
            <i class="bi bi-boxes" aria-hidden="true"></i><span>Tổng kho</span>
            <span class="warehouse-pending-count" data-warehouse-count="finishedStock" hidden="@(Model.Counts.FinishedStock == 0)" aria-label="@Model.Counts.FinishedStock thông báo kho thành phẩm chưa đọc">@Model.Counts.FinishedStock</span>
        </a>
        <a class="nav-item @(finishedReceiptsActive ? "active" : "")" aria-current="@(finishedReceiptsActive ? "page" : null)" href="/Warehouse/Index?tab=receipts">
            <i class="bi bi-box-arrow-in-down" aria-hidden="true"></i><span>Nhập kho thành phẩm</span>
            <span class="warehouse-pending-count" data-warehouse-count="finishedReceipts" hidden="@(Model.Counts.FinishedReceipts == 0)" aria-label="@Model.Counts.FinishedReceipts phiếu nhập thành phẩm chờ xử lý">@Model.Counts.FinishedReceipts</span>
        </a>
    </details>
</div>
</div>
