@model string
@{ var ap = Model; }
<!-- CORE group (Staff) -->
            <div class="nav-group" id="grp-s-core">
                <button class="nav-group-header @(ap=="Dashboard"?"active":"")" onclick="toggleGroup('s-core')">
                    <span>Quản trị &amp; Thu mua</span>
                    <i class="bi bi-chevron-down nav-chevron @(ap=="Dashboard"?"rotated":"")" id="chevron-s-core"></i>
                </button>
                <div class="nav-group-items @(ap=="Dashboard"?"open":"")" id="items-s-core">
                    <a class="nav-item @(ap=="Dashboard"?"active":"")" href="/Dashboard/Index">
                        <i class="bi bi-speedometer2"></i><span>Tổng quan Điều hành</span>
                    </a>
                </div>
            </div>

            <!-- PRODUCTION group (Staff) -->
            <div class="nav-group" id="grp-s-prod">
                <button class="nav-group-header @(ap is "Personnel" or "ShiftReport" ? "active" : "")" onclick="toggleGroup('s-prod')">
                    <span>Quy trình Sản xuất</span>
                    <i class="bi bi-chevron-down nav-chevron @(ap is "Personnel" or "ShiftReport" ? "rotated" : "")" id="chevron-s-prod"></i>
                </button>
                <div class="nav-group-items @(ap is "Personnel" or "ShiftReport" ? "open" : "")" id="items-s-prod">
                    <a class="nav-item @(ap=="Personnel"?"active":"")" href="/Personnel/Index">
                        <i class="bi bi-calendar-week"></i><span>Kế hoạch Sản xuất</span>
                    </a>
                    <a class="nav-item @(ap=="ShiftReport"?"active":"")" href="/ShiftReports/Index">
                        <i class="bi bi-clipboard-data"></i><span>Báo cáo Ca Sản xuất</span>
                    </a>
                </div>
            </div>

            <!-- EQUIPMENT group (Staff) -->
            <div class="nav-group" id="grp-s-equip">
                <button class="nav-group-header @(ap is "BrokenReport" or "Maintenance" or "Machines" ? "active" : "")" onclick="toggleGroup('s-equip')">
                    <span>Máy móc &amp; Cơ điện</span>
                    <i class="bi bi-chevron-down nav-chevron @(ap is "BrokenReport" or "Maintenance" ? "rotated" : "")" id="chevron-s-equip"></i>
                </button>
                <div class="nav-group-items @(ap is "BrokenReport" or "Maintenance" or "Machines" ? "open" : "")" id="items-s-equip">
                    <a class="nav-item @(ap is "BrokenReport" or "Maintenance" ? "active" : "")" href="/Maintenance/Index">
                        <i class="bi bi-wrench-adjustable"></i><span>Sự cố &amp; Bảo trì Cơ điện</span>
                    </a>
                    <a class="nav-item @(ap == "Machines" ? "active" : "")" href="/Machines/Index">
                        <i class="bi bi-cpu"></i><span>Danh mục Máy móc</span>
                    </a>
                </div>
            </div>
<partial name="~/Pages/Shared/_AccountNavigation.cshtml" model="Model" />
