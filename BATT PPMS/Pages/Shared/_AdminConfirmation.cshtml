<dialog class="admin-confirmation" id="adminConfirmation" aria-labelledby="adminConfirmationTitle" aria-describedby="adminConfirmationMessage">
    <div class="admin-confirmation-content">
        <span class="admin-confirmation-icon" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
        <h2 id="adminConfirmationTitle">Xác nhận thao tác</h2>
        <p id="adminConfirmationMessage"></p>
    </div>
    <div class="admin-confirmation-actions">
        <button type="button" class="btn btn-secondary" data-admin-confirm-cancel autofocus>Hủy bỏ</button>
        <button type="button" class="btn btn-primary" data-admin-confirm-accept>Xác nhận</button>
    </div>
</dialog>
