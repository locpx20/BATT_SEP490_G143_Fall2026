@page
@model BATT_PPMS.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["ActivePage"] = "Profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="profile-page">
<div class="page-header">
    <div>
        <h1 class="page-title"><i class="bi bi-person-circle heading-icon" aria-hidden="true"></i>Hồ sơ cá nhân</h1>
        <p class="page-subtitle">Xem và cập nhật thông tin cá nhân</p>
    </div>
</div>

<div class="card profile-card">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
        }
        @if (Model.User != null)
        {
            <div class="profile-identity">
                <div class="profile-avatar" aria-hidden="true">
                    <i class="bi bi-person-circle"></i>
                </div>
                <div>
                    <h2>@Model.User.FullName</h2>
                    <span class="profile-role">@Model.RoleDisplayName</span>
                </div>
            </div>

            <form method="post">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label" for="inp-username">Tên đăng nhập</label>
                        <input class="form-control" id="inp-username" type="text" value="@Model.User.Username" readonly />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="inp-fullname">Họ và tên</label>
                        <input class="form-control" type="text" name="FullName"
                               value="@Model.User.FullName" required maxlength="100" autocomplete="name" id="inp-fullname" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="inp-phone">Số điện thoại</label>
                        <input class="form-control" type="tel" name="Phone"
                               value="@Model.User.Phone" maxlength="20" autocomplete="tel" id="inp-phone" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="inp-role">Vai trò</label>
                        <input class="form-control" type="text" value="@Model.RoleDisplayName" id="inp-role" readonly />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" id="btn-save-profile">
                        <i class="bi bi-check-lg"></i> Lưu thay đổi
                    </button>
                    <a href="/Profile/ChangePassword" class="btn btn-secondary">
                        <i class="bi bi-shield-lock"></i> Đổi mật khẩu
                    </a>
                </div>
            </form>
        }
    </div>
</div>
</div>
