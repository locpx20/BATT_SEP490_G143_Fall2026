@page
@model BATT_PPMS.Pages.Profile.ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["ActivePage"] = "ChangePassword";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="profile-page">
<div class="page-header">
    <div>
        <h1 class="page-title"><i class="bi bi-shield-lock heading-icon" aria-hidden="true"></i>Đổi mật khẩu</h1>
        <p class="page-subtitle">Cập nhật mật khẩu đăng nhập của bạn</p>
    </div>
</div>

<div class="card profile-card">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
        }
        <form method="post">
            <div class="form-grid">
            <div class="form-group">
                <label class="form-label" for="inp-current-pw">Mật khẩu hiện tại <span style="color:var(--danger)" aria-hidden="true">*</span></label>
                <input class="form-control" type="password" name="CurrentPassword"
                       required autocomplete="current-password" id="inp-current-pw" placeholder="Nhập mật khẩu hiện tại" />
            </div>
            <div class="form-group">
                <label class="form-label" for="inp-new-pw">Mật khẩu mới <span style="color:var(--danger)" aria-hidden="true">*</span></label>
                <input class="form-control" type="password" name="NewPassword"
                       required autocomplete="new-password" id="inp-new-pw" placeholder="Nhập mật khẩu mới" />
            </div>
            <div class="form-group">
                <label class="form-label" for="inp-confirm-pw">Xác nhận mật khẩu mới <span style="color:var(--danger)" aria-hidden="true">*</span></label>
                <input class="form-control" type="password" name="ConfirmPassword"
                       required autocomplete="new-password" id="inp-confirm-pw" placeholder="Nhập lại mật khẩu mới" />
            </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" id="btn-change-pw">
                    <i class="bi bi-shield-check" aria-hidden="true"></i> Đổi mật khẩu
                </button>
                <a href="/Profile/Index" class="btn btn-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Quay lại hồ sơ</a>
            </div>
        </form>
    </div>
</div>
</div>
