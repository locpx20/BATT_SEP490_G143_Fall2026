@page
@model BATT_PPMS.Pages.Orders.CreateModel
@{
    ViewData["Title"] = "Tạo đơn hàng mới";
    ViewData["ActivePage"] = "OrderList";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tạo đơn hàng mới</h1>
        <p class="page-subtitle">Điền đầy đủ thông tin để tạo đơn hàng</p>
    </div>
    <a href="/Orders/Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="post">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Khách hàng <span style="color:red">*</span></label>
                    <select class="form-control" name="Order.CustomerId" required id="sel-customer">
                        <option value="">-- Chọn khách hàng --</option>
                        @foreach (var c in Model.Customers)
                        {
                            <option value="@c.CustomerId">@c.CustomerName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Sản phẩm / Hàng hoá <span style="color:red">*</span></label>
                    <select class="form-control" name="Order.ItemId" required id="sel-item">
                        <option value="">-- Chọn sản phẩm --</option>
                        @foreach (var i in Model.Items)
                        {
                            <option value="@i.InventoryId">@i.ItemName (@i.ItemCode)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Số lượng <span style="color:red">*</span></label>
                    <input class="form-control" type="number" name="Order.Quantity" min="1" required id="inp-quantity" />
                </div>
                <div class="form-group">
                    <label class="form-label">Đơn giá (₫) <span style="color:red">*</span></label>
                    <input class="form-control" type="number" name="Order.UnitPrice" min="0" step="0.01" required id="inp-price" />
                </div>
                <div class="form-group">
                    <label class="form-label">Ngày đặt hàng <span style="color:red">*</span></label>
                    <input class="form-control" type="datetime-local" name="Order.OrderDate" required id="inp-date" />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" id="btn-submit-order">
                    <i class="bi bi-check-lg"></i> Tạo đơn hàng
                </button>
                <a href="/Orders/Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
