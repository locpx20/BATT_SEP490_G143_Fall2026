@model BATT_PPMS.Helpers.AdminPaginationViewModel
@{
    var window = Model.Window;
    string? PageUrl(int number)
    {
        var values = new Microsoft.AspNetCore.Routing.RouteValueDictionary();
        foreach (var filter in Model.Filters) values[filter.Key] = filter.Value;
        var url = Url.Page(Model.PageName, values);
        return url == null ? null : Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
            url, "pageNumber", number.ToString(System.Globalization.CultureInfo.InvariantCulture));
    }
}
<div class="admin-pagination">
    <span>Hiển thị @window.FirstItem–@window.LastItem trong @window.TotalCount mục</span>
    <nav aria-label="Phân trang danh sách">
        @if (window.CurrentPage > 1)
        {
            <a href="@PageUrl(window.CurrentPage - 1)" aria-label="Trang trước">Trước</a>
        }
        else
        {
            <span class="disabled" aria-disabled="true">Trước</span>
        }
        <span class="page-position" aria-live="polite">Trang @window.CurrentPage / @window.TotalPages</span>
        @if (window.CurrentPage < window.TotalPages)
        {
            <a href="@PageUrl(window.CurrentPage + 1)" aria-label="Trang sau">Sau</a>
        }
        else
        {
            <span class="disabled" aria-disabled="true">Sau</span>
        }
    </nav>
</div>
