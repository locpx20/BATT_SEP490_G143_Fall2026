@page
@model BATT_PPMS.Pages.Deliveries.IndexModel
@{
    ViewData["Title"] = "Giao hang / Boc hang";
    ViewData["ActivePage"] = "Delivery";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Giao hàng / Bốc hàng</h1>
        <p class="page-subtitle">Quản lý thông tin giao hàng cho các đơn hàng đã duyệt</p>
    </div>
    <div class="page-actions">
        <a href="/Deliveries/Create" class="btn btn-primary" id="btn-create-delivery">
            <i class="bi bi-plus-lg"></i> Tạo phiếu giao hàng
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="empty-state">
            <i class="bi bi-truck"></i>
            <h3>Chưa có phiếu giao hàng</h3>
            <p>TODO: Hiển thị danh sách giao hàng, biển số xe, tài xế, ngày bốc hàng</p>
        </div>
    </div>
</div>
