@page
@model BATT_PPMS.Pages.Auth.RegisterModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký tài khoản - BATT PPMS";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrapper auth-register-wrapper">
        <div class="login-card">
            <div class="login-logo">
                <span class="logo-icon">🏭</span>
                <h1>Đăng ký tài khoản</h1>
                <p>Hệ thống Quản lý Kế hoạch &amp; Sản xuất BATT PPMS</p>
                <div class="zalo-service-pill">
                    <span class="zalo-badge-icon">✉️</span>
                    <span>Xác thực qua Email</span>
                </div>
            </div>

            <!-- Thanh tiến trình các bước -->
            <div class="auth-steps">
                <div class="step-item @(Model.Step == 1 ? "active" : "completed")">
                    <span class="step-number">1</span>
                    <span class="step-title">Thông tin tài khoản</span>
                </div>
                <div class="step-line @(Model.Step == 2 ? "active" : "")"></div>
                <div class="step-item @(Model.Step == 2 ? "active" : "")">
                    <span class="step-number">2</span>
                    <span class="step-title">Xác thực Email OTP</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success">
                    <span class="alert-icon">✓</span>
                    <span>@Model.SuccessMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    <span class="alert-icon">⚠</span>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            @if (Model.Step == 1)
            {
                <!-- BƯỚC 1: NHẬP THÔNG TIN TÀI KHOẢN VÀ CHỌN ROLE -->
                <form method="post" asp-page-handler="SendOtp">
                    <input type="hidden" name="Step" value="1" />

                    <div class="form-row-2">
                        <div class="form-group">
                            <label asp-for="Input.Username">Tên đăng nhập <span class="required">*</span></label>
                            <input asp-for="Input.Username" class="form-control" placeholder="vd: nguyenvan_a" required autofocus />
                            <span asp-validation-for="Input.Username" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.FullName">Họ và tên <span class="required">*</span></label>
                            <input asp-for="Input.FullName" class="form-control" placeholder="vd: Nguyễn Văn A" required />
                            <span asp-validation-for="Input.FullName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label asp-for="Input.RoleId">Vai trò trong hệ thống (Role) <span class="required">*</span></label>
                            <select asp-for="Input.RoleId" class="form-control" required>
                                <option value="">-- Chọn vai trò của bạn --</option>
                                @foreach (var role in Model.Roles)
                                {
                                    <option value="@role.RoleId">@role.RoleName</option>
                                }
                            </select>
                            <span asp-validation-for="Input.RoleId" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.Email">Địa chỉ Email <span class="required">*</span></label>
                            <input asp-for="Input.Email" type="email" class="form-control" placeholder="vd: nguyenvana@gmail.com" required />
                            <small class="form-hint">Mã OTP xác thực sẽ được gửi đến email này</small>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label asp-for="Input.Password">Mật khẩu <span class="required">*</span></label>
                            <input asp-for="Input.Password" type="password" class="form-control" placeholder="Ít nhất 6 ký tự" required />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.ConfirmPassword">Xác nhận mật khẩu <span class="required">*</span></label>
                            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu" required />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn-login btn-zalo-primary">
                        <span>Tiếp tục &amp; Gửi mã OTP qua Email</span>
                        <span class="btn-arrow">→</span>
                    </button>
                </form>
            }
            else
            {
                <!-- BƯỚC 2: NHẬP MÃ OTP EMAIL -->
                <form method="post" asp-page-handler="VerifyAndRegister">
                    <input type="hidden" name="Step" value="2" />
                    <!-- Lưu giữ thông tin bước 1 -->
                    <input type="hidden" asp-for="Input.Username" />
                    <input type="hidden" asp-for="Input.FullName" />
                    <input type="hidden" asp-for="Input.RoleId" />
                    <input type="hidden" asp-for="Input.Email" />
                    <input type="hidden" asp-for="Input.Password" />
                    <input type="hidden" asp-for="Input.ConfirmPassword" />

                    @{
                        var selectedRole = Model.Roles.FirstOrDefault(r => r.RoleId == Model.Input.RoleId)?.RoleName ?? "Đã chọn";
                    }

                    <div class="verification-summary">
                        <div class="summary-item">
                            <span class="summary-label">Tài khoản:</span>
                            <span class="summary-value">@Model.Input.Username (@Model.Input.FullName)</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Vai trò:</span>
                            <span class="summary-value" style="color: #60a5fa; font-weight: 700;">@selectedRole</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Email nhận mã:</span>
                            <span class="summary-value highlight-phone">@Model.Input.Email</span>
                        </div>
                    </div>

                    <div class="form-group otp-group">
                        <label for="OtpCode">Nhập mã OTP 6 số từ email của bạn</label>
                        <input type="text" id="OtpCode" name="OtpCode" class="form-control otp-input"
                               maxlength="6" placeholder="• • • • • •" required autofocus />
                        <span class="form-hint">Kiểm tra hộp thư đến tại <strong>@Model.Input.Email</strong> (kể cả thư mục Spam)</span>
                    </div>

                    <button type="submit" class="btn-login btn-success-action">
                        ✓ Xác nhận &amp; Hoàn tất đăng ký
                    </button>
                </form>

                <div class="otp-actions-row">
                    <form method="post" asp-page-handler="ResendOtp" style="display:inline;">
                        <input type="hidden" asp-for="Input.Username" />
                        <input type="hidden" asp-for="Input.FullName" />
                        <input type="hidden" asp-for="Input.RoleId" />
                        <input type="hidden" asp-for="Input.Email" />
                        <input type="hidden" asp-for="Input.Password" />
                        <input type="hidden" asp-for="Input.ConfirmPassword" />
                        <button type="submit" class="btn-link-action">
                            🔄 Chưa nhận được? Gửi lại mã qua Email
                        </button>
                    </form>
                    <a asp-page="/Auth/Register" class="btn-link-action text-muted">← Nhập lại thông tin</a>
                </div>
            }

            <div class="auth-footer-action">
                <p>Đã có tài khoản? <a asp-page="/Auth/Login" class="link-register">Đăng nhập tại đây</a></p>
            </div>
        </div>
    </div>
</body>
</html>
