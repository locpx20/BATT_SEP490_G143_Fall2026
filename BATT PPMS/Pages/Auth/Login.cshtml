@page
@model BATT_PPMS.Pages.Auth.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập Hệ thống Nội bộ - BATT PPMS";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-entry.css" asp-append-version="true" />
</head>
<body class="auth-entry auth-entry--login">
    <main class="login-wrapper">
        <div class="login-card">
            <div class="login-logo">
                <span class="login-brand-mark" aria-label="BATT">BATT</span>
                <p class="auth-brand-name">BATT PPMS</p>
                <h1>Đăng nhập</h1>
            </div>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success" role="status">
                    <i class="bi bi-check-circle alert-icon" aria-hidden="true"></i>
                    <span>@Model.SuccessMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle alert-icon" aria-hidden="true"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form method="post" autocomplete="on">
                <div class="form-group">
                    <label for="phone">Số điện thoại</label>
                    <input type="tel" id="phone" name="Phone" class="form-control" inputmode="tel" autocomplete="username"
                           value="@Model.Phone" placeholder="Nhập số điện thoại" required autofocus />
                </div>
                <div class="form-group">
                    <div class="form-label-row">
                        <label for="password">Mật khẩu</label>
                        <a asp-page="/Auth/ForgotPassword" class="form-link-subtle">Quên mật khẩu?</a>
                    </div>
                    <input type="password" id="password" name="Password" class="form-control"
                           placeholder="Nhập mật khẩu" autocomplete="current-password" required />
                </div>

                <button type="submit" class="btn-login">
                    <span>Đăng nhập</span>
                </button>
            </form>

        </div>
    </main>
</body>
</html>
