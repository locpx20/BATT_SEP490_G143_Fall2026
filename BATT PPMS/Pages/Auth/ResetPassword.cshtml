@page
@model BATT_PPMS.Pages.Auth.ResetPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Đặt lại mật khẩu - BATT PPMS";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-logo">
                <span class="logo-icon">🔄</span>
                <h1>Đặt lại mật khẩu</h1>
                <p>Nhập mã OTP đã nhận qua Email và thiết lập mật khẩu mới</p>
                <div class="zalo-service-pill">
                    <span class="zalo-badge-icon">✉️</span>
                    <span>Xác thực qua Email</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success">
                    <span class="alert-icon">✓</span>
                    <span>@Model.SuccessMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    <span class="alert-icon">⚠</span>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <div class="verification-summary">
                <div class="summary-item">
                    <span class="summary-label">Tài khoản:</span>
                    <span class="summary-value">@Model.Username</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Email nhận mã:</span>
                    <span class="summary-value highlight-phone">@Model.MaskedEmail</span>
                </div>
            </div>

            <form method="post" asp-page-handler="ResetPassword">
                <input type="hidden" asp-for="Username" />

                <div class="form-group otp-group">
                    <label asp-for="OtpCode">Mã OTP Email (6 số) <span class="required">*</span></label>
                    <input asp-for="OtpCode" id="OtpCode" class="form-control otp-input"
                           maxlength="6" placeholder="• • • • • •" required autofocus />
                    <span asp-validation-for="OtpCode" class="text-danger"></span>
                    <small class="form-hint">Kiểm tra hộp thư email để nhận mã xác thực</small>
                </div>

                <div class="form-group">
                    <label asp-for="NewPassword">Mật khẩu mới <span class="required">*</span></label>
                    <input asp-for="NewPassword" type="password" class="form-control"
                           placeholder="Ít nhất 6 ký tự" required />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới <span class="required">*</span></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control"
                           placeholder="Nhập lại mật khẩu mới" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-login btn-success-action">
                    ✓ Hoàn tất đặt lại mật khẩu
                </button>
            </form>

            <div class="otp-actions-row">
                <form method="post" asp-page-handler="ResendOtp" style="display:inline;">
                    <input type="hidden" asp-for="Username" />
                    <button type="submit" class="btn-link-action">
                        🔄 Gửi lại mã qua Email
                    </button>
                </form>
                <a asp-page="/Auth/ForgotPassword" class="btn-link-action text-muted">← Nhập email khác</a>
            </div>

            <div class="auth-divider">
                <span>hoặc</span>
            </div>

            <div class="auth-footer-action">
                <p><a asp-page="/Auth/Login" class="link-register">← Trở về màn hình Đăng nhập</a></p>
            </div>
        </div>
    </div>
</body>
</html>
