@page
@model BATT_PPMS.Pages.PurchaseInvoices.DetailModel
@using System.Globalization
@{
    ViewData["Title"] = $"Yêu cầu thu mua {Model.InvoiceCode}";
    ViewData["ActivePage"] = "PurchaseInvoice";
    var vi = new CultureInfo("vi-VN");

    string BadgeStyle(string type) => type switch
    {
        "pending" or "wait_approval" => "background: #fffbeb; color: #b45309; border: 1px solid #fef3c7;",
        "warehouse" or "procuring" => "background: #ebf5ff; color: #1e40af; border: 1px solid #dbeafe;",
        "received" or "completed" => "background: #f0fdf4; color: #15803d; border: 1px solid #dcfce7;",
        "expired" => "background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1;",
        _ => "background: #fef2f2; color: #b91c1c; border: 1px solid #fee2e2;"
    };
    var labelStyle = "font-size: 12px; color: #64748b; margin-bottom: 2px;";
    var valueStyle = "font-size: 14px; font-weight: 700; color: #1e293b;";
    var cardStyle = "background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; margin-bottom: 16px;";
}

<div style="max-width: 1400px; margin: 0 auto;">
    <div style="font-size: 13px; color: #718096; margin-bottom: 8px;">
        <span style="color: #a0aec0;">BATT PPMS</span>
        <span style="margin: 0 6px; color: #cbd5e1;">/</span>
        <a href="/PurchaseInvoices/Index" style="color: #718096; text-decoration: none;">Danh sách yêu cầu thu mua</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" style="border-radius: 10px; font-size: 13px;">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" style="border-radius: 10px; font-size: 13px;">@Model.ErrorMessage</div>
    }

    <h1 style="font-size: 24px; font-weight: 700; color: #1a202c; margin-bottom: 20px;">Yêu cầu thu mua @Model.InvoiceCode</h1>

    <div style="display: grid; grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr); gap: 16px; align-items: start;">
        <!-- Cột trái -->
        <div>
            <!-- Thông tin yêu cầu thu mua -->
            <div style="@cardStyle">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                    <h2 style="font-size: 16px; font-weight: 600; margin: 0;">Yêu cầu thu mua @Model.InvoiceCode</h2>
                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 9999px; font-size: 12px; font-weight: 500; @BadgeStyle(Model.StatusType)">
                        <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span>@Model.StatusText
                    </span>
                </div>
                <div class="pm-grid">
                    <div><div style="@labelStyle">Khối lượng cần mua</div><div style="@valueStyle">@Model.PlannedQuantity.ToString("N0", vi) kg</div></div>
                    <div><div style="@labelStyle">Giá trần</div><div style="@valueStyle">@Model.CeilingPrice.ToString("N0", vi) VNĐ / kg</div></div>
                    <div><div style="@labelStyle">Đã cân cộng dồn</div><div style="@valueStyle">@Model.WeighedTotal.ToString("N0", vi) kg</div></div>
                    <div><div style="@labelStyle">Người tạo</div><div style="@valueStyle">@Model.CreatorName</div></div>
                    <div><div style="@labelStyle">Thời điểm tạo</div><div style="@valueStyle">@Model.CreatedAt.ToString("HH:mm dd/MM/yyyy")</div></div>
                    <div class="pm-full">
                        <div style="@labelStyle">Nhân viên được phân công &amp; Ghi chú thu mua</div>
                        @if (Model.StaffAssignments.Any())
                        {
                            <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 4px;">
                                @foreach (var sa in Model.StaffAssignments)
                                {
                                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px 10px;">
                                        <span style="font-size: 13.5px; font-weight: 700; color: #1e293b;">@sa.FullName</span>
                                        @if (!string.IsNullOrWhiteSpace(sa.Note))
                                        {
                                            <span style="font-size: 12px; color: #166534; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px; padding: 2px 8px;">
                                                Ghi chú: @sa.Note
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="font-size: 12px; color: #94a3b8;">(Không có ghi chú riêng)</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="@valueStyle">@Model.AssignedName</div>
                        }
                    </div>
                    <div class="pm-full">
                        <div style="@labelStyle">Hạn hiệu lực yêu cầu thu mua (hết ngày lập phiếu)</div>
                        <div style="font-size: 13px; font-weight: 700; color: @(Model.IsExpired ? "#b91c1c" : "#15803d");">
                            23:59 @Model.ExpiresAt.ToString("dd/MM/yyyy") @(Model.IsExpired ? "— Đã hết hạn" : "— Còn hiệu lực trong ngày")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Phiếu mua hàng -->
            <div style="@cardStyle">
                <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 4px;">Phiếu mua hàng (Purchase Order &amp; Inbound Request)</h2>
                <div style="font-size: 12px; color: #64748b; margin-bottom: 14px;">
                    @Model.WeighedTotal.ToString("N0", vi) kg qua @Model.Receipts.Count phiếu mua hàng.
                </div>

                @if (!Model.Receipts.Any())
                {
                    <div style="text-align: center; padding: 24px; color: #94a3b8; font-size: 13px;">Chưa có phiếu mua hàng nào.</div>
                }
                @for (int i = 0; i < Model.Receipts.Count; i++)
                {
                    var r = Model.Receipts[i];
                    <div style="padding: 14px 0; @(i > 0 ? "border-top: 1px solid #f1f5f9;" : "")">
                        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                <span style="display: inline-flex; align-items: center; background: #faf4e8; border: 1px solid #ecdcc0; border-left: 4px solid #c88a2e; border-radius: 4px; padding: 3px 8px; font-family: ui-monospace, Consolas, monospace; font-size: 12px; font-weight: 700; color: #6d4d12;">@r.Code</span>
                                @if (!string.IsNullOrEmpty(r.ImportCode))
                                {
                                    <span style="display: inline-flex; align-items: center; background: #eef6f0; border: 1px solid #cde2d3; border-left: 4px solid #1a4332; border-radius: 4px; padding: 3px 8px; font-family: ui-monospace, Consolas, monospace; font-size: 12px; font-weight: 700; color: #1a4332;" title="Mã Phiếu nhập kho nguyên liệu">
                                        @r.ImportCode
                                    </span>
                                }
                                <span style="display: inline-flex; align-items: center; gap: 4px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 2px 8px; font-size: 12px; color: #334155;">
                                    <i class="bi bi-person-fill" style="color: #64748b;"></i>
                                    <span>Người tạo: <strong style="color: #1e293b;">@r.CreatedByName</strong></span>
                                    <span style="color: #94a3b8;">· @r.CreatedAt.ToString("HH:mm dd/MM/yyyy")</span>
                                </span>
                            </div>
                            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 9999px; font-size: 12px; font-weight: 500; @BadgeStyle(r.StatusType)">
                                <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span>@r.StatusText
                            </span>
                        </div>

                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px; flex-wrap: wrap; gap: 8px;">
                            <span style="font-size: 12px; color: #475569;">
                                @if (r.ImportedQuantity.HasValue)
                                {
                                    <strong style="color: #15803d;">KL cân thực tế: @r.ImportedQuantity.Value.ToString("N0", vi) kg</strong>
                                }
                                else
                                {
                                    <span>KL ước tính: <strong>@r.Quantity.ToString("N0", vi) kg</strong></span>
                                }
                                · @r.Price.ToString("N0", vi) VNĐ / kg (@r.SupplierName)
                            </span>
                            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                <a href="javascript:void(0)" class="receipt-link"
                                   data-id="@r.ReceiptId"
                                   data-code="@r.Code" data-supplier="@r.SupplierName"
                                   data-qty="@((r.ImportedQuantity ?? r.Quantity).ToString("N0", vi))"
                                   data-qty-label="@(r.ImportedQuantity.HasValue ? "Khối lượng cân thực tế (tại kho)" : "Khối lượng ước tính")"
                                   data-price="@r.Price.ToString("N0", vi)"
                                   data-total="@(((r.ImportedQuantity ?? r.Quantity) * r.Price).ToString("N0", vi))" data-by="@r.CreatedByName"
                                   data-at="@r.CreatedAt.ToString("HH:mm dd/MM/yyyy")" data-status="@r.StatusText"
                                   data-rejection="@(r.RejectionReason ?? "")"
                                   data-import-code="@(r.ImportCode ?? "Chưa lập")"
                                   data-import-by="@(r.ImportedByName ?? "—")"
                                   data-approved-by="@(r.ApprovedByName ?? "—")"
                                   data-approved-at="@(r.ApprovedAt?.ToString("HH:mm dd/MM/yyyy") ?? "—")"
                                   data-scale="@r.ScalePhoto" data-invoice="@r.InvoicePhoto"
                                   title="Xem chi tiết phiếu mua @r.Code"
                                   style="display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #1e293b; font-size: 14px; text-decoration: none;">
                                    <i class="bi bi-eye"></i>
                                </a>

                                @* BƯỚC 3 TRÊN SWIMLANE: Manager Approved? (Duyệt / Từ chối đơn mua) *@
                                @if (Model.CanManagerReviewOrder && r.RawStatus == "PendingOrderApproval")
                                {
                                    <form method="post" asp-page-handler="ApproveOrder" style="display: inline; margin: 0;">
                                        <input type="hidden" name="receiptId" value="@r.ReceiptId" />
                                        <button type="submit" style="background: #15803d; color: #fff; border: none; border-radius: 6px; padding: 4px 10px; font-size: 12px; font-weight: 600; cursor: pointer;">
                                            Duyệt
                                        </button>
                                    </form>
                                    <button type="button"
                                            onclick="openRejectOrderModal(@r.ReceiptId, '@r.Code')"
                                            style="background: #fff; color: #b91c1c; border: 1px solid #fecaca; border-radius: 6px; padding: 4px 10px; font-size: 12px; font-weight: 600; cursor: pointer;">
                                        Từ chối
                                    </button>
                                }

                                @* Nếu bị từ chối đơn mua (No -> Rejection Reason -> Create Purchase Order): cho phép Purchasing Staff sửa & gửi lại *@
                                @if (Model.CanCreateReceipt && r.RawStatus == "OrderRejected")
                                {
                                    <button type="button"
                                            onclick="openEditReceiptModal(@r.ReceiptId, '@r.Code', @r.SupplierId, '@r.Quantity.ToString("0.##", CultureInfo.InvariantCulture)', '@r.Price.ToString("0.##", CultureInfo.InvariantCulture)')"
                                            style="background: #1a4332; color: #fff; border: none; border-radius: 6px; padding: 4px 10px; font-size: 12px; font-weight: 600; cursor: pointer;">
                                        Sửa &amp; gửi lại
                                    </button>
                                }

                                @* BƯỚC 4 TRÊN SWIMLANE: Purchasing Staff -> Create Inbound Request *@
                                @if (Model.CanCreateInboundRequest && r.RawStatus == "OrderApproved")
                                {
                                    <form method="post" asp-page-handler="CreateInboundRequest" style="display: inline; margin: 0;">
                                        <input type="hidden" name="receiptId" value="@r.ReceiptId" />
                                        <button type="submit" style="background: #1e40af; color: #fff; border: none; border-radius: 6px; padding: 4px 10px; font-size: 12px; font-weight: 600; cursor: pointer;">
                                            Gửi yêu cầu nhập kho
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(r.RejectionReason))
                        {
                            <div style="margin-top: 8px; padding: 8px 12px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; font-size: 12px; color: #b91c1c;">
                                <strong>Lý do từ chối (Rejection Reason):</strong> @r.RejectionReason
                            </div>
                        }

                        @* BƯỚC CUỐI TRÊN SWIMLANE: Receive Goods Receipt information *@
                        @if (r.RawStatus == "Received" && !string.IsNullOrEmpty(r.ImportCode))
                        {
                            <div style="margin-top: 8px; padding: 8px 12px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; font-size: 12px; color: #166534;">
                                <strong>Thông tin Phiếu nhập kho nguyên liệu (@r.ImportCode):</strong>
                                Đã nhập kho <strong>@((r.ImportedQuantity ?? r.Quantity).ToString("N0", vi)) kg</strong>
                                · Thủ kho lập: <strong>@(r.ImportedByName ?? "—")</strong>
                                · Manager duyệt: <strong>@(r.ApprovedByName ?? "—")</strong> (@(r.ApprovedAt?.ToString("HH:mm dd/MM/yyyy") ?? "—"))
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Lịch sử thao tác -->
            <div style="@cardStyle">
                <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 14px;">Lịch sử thao tác</h2>
                @foreach (var t in Model.Timeline)
                {
                    <div style="display: flex; gap: 10px; align-items: flex-start; margin-bottom: 10px; font-size: 13px; color: #475569;">
                        <span style="width: 8px; height: 8px; border: 1px solid #94a3b8; border-radius: 50%; margin-top: 6px; flex-shrink: 0;"></span>
                        <span>@t.At.ToString("HH:mm dd/MM/yyyy") · @t.Text</span>
                    </div>
                }
            </div>
        </div>

        <!-- Cột phải: Thao tác -->
        <div style="@cardStyle background: #f8faf8;">
            <h2 style="font-size: 15px; font-weight: 600; margin-bottom: 14px;">Thao tác</h2>
            @if (Model.CanCreateReceipt)
            {
                @if (Model.RemainingQuantity > 0)
                {
                    <button type="button" onclick="openCreateNewReceiptModal()"
                            style="width: 100%; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 13px; font-weight: 600; padding: 10px; cursor: pointer;">
                        + Tạo phiếu mua hàng
                    </button>
                }
                else
                {
                    <div style="font-size: 12px; color: #166534; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 10px 12px;">
                        Đã tạo đủ 100% khối lượng cần mua của yêu cầu thu mua (@Model.PlannedQuantity.ToString("N0", vi) kg). Không thể tạo thêm phiếu mua hàng mới.
                    </div>
                }
                <div style="font-size: 11.5px; color: #64748b; margin-top: 8px;">
                    Quy trình chuẩn:<br />
                    1. Nhân viên thu mua tạo <strong>Phiếu mua hàng</strong><br />
                    2. Manager phê duyệt phiếu mua hàng (<strong>Duyệt / Từ chối</strong>)<br />
                    3. Nhân viên thu mua bấm <strong>Gửi yêu cầu nhập kho</strong> sang Kho<br />
                    4. Thủ kho đối chiếu &amp; lập <strong>Phiếu nhập kho nguyên liệu (PNK-26xxx)</strong><br />
                    5. Manager duyệt phiếu nhập kho &rarr; Hoàn tất nhập kho.
                </div>
            }
            else if (Model.IsExpired)
            {
                <div style="font-size: 12px; color: #b91c1c; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 10px 12px;">
                    Yêu cầu thu mua này đã hết hạn vào cuối ngày @Model.ExpiresAt.ToString("dd/MM/yyyy"), không thể tạo thêm phiếu mua hàng.
                </div>
            }
            else if (Model.CanManagerReviewOrder)
            {
                <div style="font-size: 12px; color: #475569; line-height: 1.6;">
                    <strong>Vai trò Quản lý (Manager):</strong><br />
                    • Chỉ <strong>Nhân viên thu mua (Purchasing Staff)</strong> được phân công mới tạo phiếu mua hàng.<br />
                    • Khi nhân viên gửi phiếu mua hàng, bạn có thể bấm <strong>Duyệt</strong> hoặc <strong>Từ chối</strong> ngay tại danh sách bên trái.
                </div>
            }
            else
            {
                <div style="font-size: 12px; color: #94a3b8;">Chỉ nhân viên thu mua được giao mới tạo phiếu mua hàng.</div>
            }
        </div>
    </div>
</div>

<!-- POPUP: TẠO / SỬA PHIẾU MUA HÀNG -->
@if (Model.CanCreateReceipt)
{
    <div class="pm-overlay" id="createReceiptModal" onclick="if (event.target === this) closePmModal('createReceiptModal')">
        <div class="pm-dialog pm-lg" role="dialog" aria-modal="true">
            <form method="post" asp-page-handler="CreateReceipt" asp-route-id="@Model.InvoiceId" enctype="multipart/form-data">
                <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />
                <input type="hidden" name="editReceiptId" id="editReceiptIdInput" value="" />
                <div class="pm-head">
                    <h5 class="pm-title" id="createReceiptModalTitle">Tạo phiếu mua hàng</h5>
                    <button type="button" class="pm-close" aria-label="Đóng" onclick="closePmModal('createReceiptModal')">&times;</button>
                </div>
                <div class="pm-body">
                    <div class="pm-grid">
                        <div>
                            <label class="pm-label">Yêu cầu thu mua được giao <span style="color: #e53e3e;">*</span></label>
                            <input type="text" class="pm-input" value="@Model.InvoiceCode" readonly tabindex="-1" />
                        </div>
                        <div>
                            <label class="pm-label">Nhà cung cấp <span style="color: #e53e3e;">*</span></label>
                            <select name="supplierId" id="supplierIdSelect" class="pm-input" required>
                                <option value="">Chọn...</option>
                                @foreach (var s in Model.Suppliers)
                                {
                                    <option value="@s.SupplierId">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="pm-label">Khối lượng ước tính <span style="color: #e53e3e;">*</span></label>
                            <input type="number" name="weighedQuantity" id="weighedQuantityInput" min="1" max="@Model.RemainingQuantity.ToString("0.##", CultureInfo.InvariantCulture)" step="any" placeholder="Vd: 5000" required class="pm-input" />
                            <span class="pm-hint" id="weighedQuantityHint">kg (Còn lại tối đa: @Model.RemainingQuantity.ToString("N0", vi) / @Model.PlannedQuantity.ToString("N0", vi) kg)</span>
                        </div>
                        <div>
                            <label class="pm-label">Giá mua thực tế <span style="color: #e53e3e;">*</span></label>
                            <input type="number" name="actualPrice" id="actualPriceInput" min="1" max="@Model.CeilingPrice.ToString("0.##", CultureInfo.InvariantCulture)" step="any" value="@Model.CeilingPrice.ToString("0.##", CultureInfo.InvariantCulture)" required class="pm-input" />
                            <span class="pm-hint">VNĐ / kg (tối đa giá trần @Model.CeilingPrice.ToString("N0", vi))</span>
                        </div>
                        <div>
                            <label class="pm-label">Ảnh minh chứng / hàng hóa <span id="scalePhotoReqStar" style="color: #e53e3e;">*</span></label>
                            <input type="file" name="scalePhoto" id="scalePhotoInput" accept="image/*" required class="pm-input" />
                            <span class="pm-hint">Có thể chọn tệp, kéo-thả ảnh vào ô này hoặc bấm Ctrl+V để dán ảnh</span>
                        </div>
                        <div>
                            <label class="pm-label">Hóa đơn (nếu có)</label>
                            <input type="file" name="invoicePhoto" id="invoicePhotoInput" accept="image/*" class="pm-input" />
                            <span class="pm-hint">Có thể chọn tệp hoặc kéo-thả ảnh vào ô này</span>
                        </div>
                    </div>
                </div>
                <div class="pm-foot">
                    <button type="button" class="pm-btn-cancel" onclick="closePmModal('createReceiptModal')">Hủy</button>
                    <button type="submit" class="pm-btn-primary" id="createReceiptSubmitBtn">Gửi đơn mua chờ Manager duyệt</button>
                </div>
            </form>
        </div>
    </div>
}

<!-- POPUP: NHẬP LÝ DO TỪ CHỐI ĐƠN MUA (REJECTION REASON - BƯỚC 3B) -->
@if (Model.CanManagerReviewOrder)
{
    <div class="pm-overlay" id="rejectOrderModal" onclick="if (event.target === this) closePmModal('rejectOrderModal')">
        <div class="pm-dialog" role="dialog" aria-modal="true" style="max-width: 480px;">
            <form method="post" asp-page-handler="RejectOrder" asp-route-id="@Model.InvoiceId">
                <input type="hidden" name="receiptId" id="rejectOrderReceiptId" />
                <div class="pm-head">
                    <h5 class="pm-title">Từ chối đơn mua <span id="rejectOrderCode" style="font-family: monospace;"></span></h5>
                    <button type="button" class="pm-close" aria-label="Đóng" onclick="closePmModal('rejectOrderModal')">&times;</button>
                </div>
                <div class="pm-body">
                    <label class="pm-label">Lý do từ chối (Rejection Reason) <span style="color: #e53e3e;">*</span></label>
                    <textarea name="rejectionReason" rows="3" required class="pm-input" placeholder="Nhập lý do từ chối để Nhân viên thu mua kiểm tra và chỉnh sửa lại đơn mua..."></textarea>
                </div>
                <div class="pm-foot">
                    <button type="button" class="pm-btn-cancel" onclick="closePmModal('rejectOrderModal')">Hủy</button>
                    <button type="submit" class="pm-btn-primary" style="background: #b91c1c;">Xác nhận từ chối</button>
                </div>
            </form>
        </div>
    </div>
}

<!-- POPUP: CHI TIẾT PHIẾU MUA HÀNG -->
<div class="pm-overlay" id="receiptDetailModal" onclick="if (event.target === this) closePmModal('receiptDetailModal')">
    <div class="pm-dialog pm-lg" role="dialog" aria-modal="true">
        <div class="pm-head">
            <h5 class="pm-title">Phiếu mua hàng <span id="rdCode" style="font-family: monospace;"></span></h5>
            <button type="button" class="pm-close" aria-label="Đóng" onclick="closePmModal('receiptDetailModal')">&times;</button>
        </div>
        <div class="pm-body">
            <div class="pm-grid" style="margin-bottom: 16px;">
                <div><div style="@labelStyle">Nhà cung cấp</div><div id="rdSupplier" style="@valueStyle"></div></div>
                <div><div style="@labelStyle">Trạng thái</div><div id="rdStatus" style="@valueStyle"></div></div>
                <div><div style="@labelStyle" id="rdQtyLabel">Khối lượng ước tính</div><div id="rdQty" style="@valueStyle"></div></div>
                <div><div style="@labelStyle">Giá mua thực tế (VNĐ/kg)</div><div id="rdPrice" style="@valueStyle"></div></div>
                <div><div style="@labelStyle">Thành tiền (VNĐ)</div><div id="rdTotal" style="@valueStyle"></div></div>
                <div><div style="@labelStyle">Người tạo</div><div id="rdBy" style="@valueStyle"></div></div>
                <div><div style="@labelStyle">Thời điểm tạo</div><div id="rdAt" style="@valueStyle"></div></div>
                <div><div style="@labelStyle">Phiếu nhập kho nguyên liệu</div><div id="rdImportCode" style="@valueStyle; color: #1a4332;"></div></div>
                <div><div style="@labelStyle">Thủ kho lập phiếu nhập</div><div id="rdImportBy" style="@valueStyle"></div></div>
                <div><div style="@labelStyle">Manager duyệt nhập kho</div><div id="rdApprovedBy" style="@valueStyle"></div></div>
                <div class="pm-full" id="rdRejectionWrap" style="display: none;">
                    <div style="padding: 8px 12px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; font-size: 12px; color: #b91c1c;">
                        <strong>Lý do từ chối (Rejection Reason):</strong> <span id="rdRejection"></span>
                    </div>
                </div>
            </div>
            <div class="pm-grid">
                <div><div style="@labelStyle">Ảnh xe cân tại xưởng</div><a id="rdScaleLink" target="_blank"><img id="rdScale" alt="Ảnh xe cân" style="width: 100%; border-radius: 8px; border: 1px solid #e2e8f0;" /></a></div>
                <div id="rdInvoiceWrap"><div style="@labelStyle">Hóa đơn</div><a id="rdInvoiceLink" target="_blank"><img id="rdInvoice" alt="Hóa đơn" style="width: 100%; border-radius: 8px; border: 1px solid #e2e8f0;" /></a></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openPmModal(id) { document.getElementById(id).classList.add('open'); }
        function closePmModal(id) { document.getElementById(id).classList.remove('open'); }

        var defaultRemainingQty = @Model.RemainingQuantity.ToString("0.##", CultureInfo.InvariantCulture);
        var plannedTotalQty = @Model.PlannedQuantity.ToString("0.##", CultureInfo.InvariantCulture);

        function openCreateNewReceiptModal() {
            document.getElementById('editReceiptIdInput').value = '';
            document.getElementById('createReceiptModalTitle').innerText = 'Tạo phiếu mua hàng';
            document.getElementById('createReceiptSubmitBtn').innerText = 'Gửi phiếu mua hàng chờ Manager duyệt';
            var qtyInput = document.getElementById('weighedQuantityInput');
            if (qtyInput) {
                qtyInput.max = defaultRemainingQty;
                qtyInput.value = '';
            }
            var qtyHint = document.getElementById('weighedQuantityHint');
            if (qtyHint) {
                qtyHint.innerText = 'kg (Còn lại tối đa: ' + Number(defaultRemainingQty).toLocaleString('vi-VN') + ' / ' + Number(plannedTotalQty).toLocaleString('vi-VN') + ' kg)';
            }
            var scaleInput = document.getElementById('scalePhotoInput');
            if (scaleInput) scaleInput.required = true;
            var star = document.getElementById('scalePhotoReqStar');
            if (star) star.style.display = '';
            openPmModal('createReceiptModal');
        }

        function openEditReceiptModal(receiptId, code, supplierId, qty, price) {
            document.getElementById('editReceiptIdInput').value = receiptId;
            document.getElementById('createReceiptModalTitle').innerText = 'Sửa & Gửi lại đơn mua ' + code;
            document.getElementById('createReceiptSubmitBtn').innerText = 'Cập nhật & Gửi lại Manager duyệt';
            document.getElementById('supplierIdSelect').value = supplierId;
            var maxEditQty = Number(defaultRemainingQty) + Number(qty);
            var qtyInput = document.getElementById('weighedQuantityInput');
            if (qtyInput) {
                qtyInput.max = maxEditQty;
                qtyInput.value = qty;
            }
            var qtyHint = document.getElementById('weighedQuantityHint');
            if (qtyHint) {
                qtyHint.innerText = 'kg (Tối đa cho phép: ' + maxEditQty.toLocaleString('vi-VN') + ' / ' + Number(plannedTotalQty).toLocaleString('vi-VN') + ' kg)';
            }
            document.getElementById('actualPriceInput').value = price;
            var scaleInput = document.getElementById('scalePhotoInput');
            if (scaleInput) scaleInput.required = false;
            var star = document.getElementById('scalePhotoReqStar');
            if (star) star.style.display = 'none';
            openPmModal('createReceiptModal');
        }

        function openRejectOrderModal(receiptId, code) {
            document.getElementById('rejectOrderReceiptId').value = receiptId;
            document.getElementById('rejectOrderCode').innerText = code;
            openPmModal('rejectOrderModal');
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') document.querySelectorAll('.pm-overlay.open').forEach(function (m) { m.classList.remove('open'); });
        });

        // Hỗ trợ dán ảnh trực tiếp (Ctrl+V) vào Ảnh xe cân tại xưởng
        document.addEventListener('paste', function (e) {
            var modal = document.getElementById('createReceiptModal');
            if (!modal || !modal.classList.contains('open')) return;
            var items = e.clipboardData && e.clipboardData.items;
            if (!items) return;
            for (var i = 0; i < items.length; i++) {
                if (items[i].type.indexOf('image') !== -1) {
                    var file = items[i].getAsFile();
                    if (file) {
                        var dt = new DataTransfer();
                        dt.items.add(file);
                        var scaleInput = document.getElementById('scalePhotoInput');
                        var invoiceInput = document.getElementById('invoicePhotoInput');
                        if (scaleInput && (!scaleInput.files || scaleInput.files.length === 0)) {
                            scaleInput.files = dt.files;
                        } else if (invoiceInput) {
                            invoiceInput.files = dt.files;
                        }
                    }
                    break;
                }
            }
        });

        document.querySelectorAll('.receipt-link').forEach(function (a) {
            a.addEventListener('click', function () {
                var d = a.dataset;
                document.getElementById('rdCode').innerText = d.code;
                document.getElementById('rdSupplier').innerText = d.supplier;
                document.getElementById('rdStatus').innerText = d.status;
                var qtyLbl = document.getElementById('rdQtyLabel');
                if (qtyLbl && d.qtyLabel) qtyLbl.innerText = d.qtyLabel;
                document.getElementById('rdQty').innerText = d.qty + ' kg';
                document.getElementById('rdPrice').innerText = d.price;
                document.getElementById('rdTotal').innerText = d.total;
                document.getElementById('rdBy').innerText = d.by;
                document.getElementById('rdAt').innerText = d.at;
                document.getElementById('rdImportCode').innerText = d.importCode || 'Chưa lập';
                document.getElementById('rdImportBy').innerText = d.importBy || '—';
                document.getElementById('rdApprovedBy').innerText = d.approvedBy || '—';

                var rejWrap = document.getElementById('rdRejectionWrap');
                if (d.rejection) {
                    rejWrap.style.display = '';
                    document.getElementById('rdRejection').innerText = d.rejection;
                } else {
                    rejWrap.style.display = 'none';
                }

                document.getElementById('rdScale').src = d.scale;
                document.getElementById('rdScaleLink').href = d.scale;
                var wrap = document.getElementById('rdInvoiceWrap');
                if (d.invoice) {
                    wrap.style.display = '';
                    document.getElementById('rdInvoice').src = d.invoice;
                    document.getElementById('rdInvoiceLink').href = d.invoice;
                } else {
                    wrap.style.display = 'none';
                }
                openPmModal('receiptDetailModal');
            });
        });
    </script>
}
