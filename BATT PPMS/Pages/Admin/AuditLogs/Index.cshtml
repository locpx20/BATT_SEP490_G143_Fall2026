@page
@model BATT_PPMS.Pages.Admin.AuditLogs.IndexModel
@{
    ViewData["Title"] = "Nhật ký Kiểm toán Hệ thống";
    ViewData["ActivePage"] = "AuditLogs";
}

<div class="space-y-6">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Nhật ký Kiểm toán Hệ thống (Audit Logs)</h1>
            <p class="page-subtitle">Ghi nhận bất biến mọi thay đổi trạng thái, giao dịch vật lý, phê duyệt và người thực hiện</p>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card" style="overflow: visible;">
        <div class="card-body" style="padding: 14px 18px;">
            <form method="get" class="filter-bar">
                <div class="search-wrapper">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@Model.SearchTerm"
                           class="form-control" style="padding-left: 34px;"
                           placeholder="Tìm theo hành động, người thực hiện, mã hồ sơ..." />
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 12px; color: #64748b; font-weight: 500; white-space: nowrap;">Đối tượng:</span>
                    <select name="entityFilter" class="form-control" style="width: auto; min-width: 200px;">
                        <option value="">Tất cả đối tượng</option>
                        <option value="Purchase" selected="@(Model.EntityFilter=="Purchase")">Thu mua (PURCHASE)</option>
                        <option value="Order" selected="@(Model.EntityFilter=="Order")">Đơn hàng (ORDER)</option>
                        <option value="QC" selected="@(Model.EntityFilter=="QC")">Kiểm tra KCS (QC)</option>
                        <option value="ShiftReport" selected="@(Model.EntityFilter=="ShiftReport")">Báo cáo ca (SHIFT_REPORT)</option>
                        <option value="Maintenance" selected="@(Model.EntityFilter=="Maintenance")">Sự cố máy (MAINTENANCE)</option>
                        <option value="User" selected="@(Model.EntityFilter=="User")">Quản trị người dùng (USER)</option>
                        <option value="Inventory" selected="@(Model.EntityFilter=="Inventory")">Kho hàng (INVENTORY)</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-secondary">
                    <i class="bi bi-funnel"></i> Lọc
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.EntityFilter))
                {
                    <a href="/Admin/AuditLogs/Index" class="btn btn-outline btn-sm">
                        <i class="bi bi-x"></i> Xóa lọc
                    </a>
                }
            </form>
        </div>
    </div>

    <!-- Audit Log Table -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title" style="font-size: 14px;">
                <i class="bi bi-clock-history" style="color: #4f46e5; margin-right: 6px;"></i>
                Nhật ký hoạt động
                <span style="font-size: 11px; font-weight: 600; background: #eef2ff; color: #4f46e5; padding: 2px 8px; border-radius: 20px; margin-left: 8px;">
                    @Model.TotalCount bản ghi
                </span>
            </h2>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th>Người thực hiện</th>
                        <th>Hành động</th>
                        <th>Đối tượng</th>
                        <th>Chuyển trạng thái</th>
                        <th>Chi tiết nghiệp vụ &amp; Lý do</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.AuditLogs.Any())
                    {
                        <tr>
                            <td colspan="6" class="empty-state">
                                <i class="bi bi-clock-history"></i>
                                <p style="font-size: 14px; font-weight: 600; color: #475569; margin-top: 8px;">Chưa có nhật ký nào</p>
                                <p style="font-size: 12px; color: #94a3b8;">Các hoạt động trong hệ thống sẽ được ghi lại tại đây</p>
                            </td>
                        </tr>
                    }
                    @foreach (var log in Model.AuditLogs)
                    {
                        <tr>
                            <td style="font-family: monospace; color: #64748b; white-space: nowrap; font-size: 12px;">
                                @log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                            <td style="white-space: nowrap;">
                                <span style="font-weight: 700; color: #0f172a; display: block; font-size: 12.5px;">@log.ActorName</span>
                                <span style="font-size: 10px; color: #94a3b8; font-family: monospace; font-weight: 600;">[@log.ActorRole]</span>
                            </td>
                            <td style="font-weight: 600; color: #1e293b; font-size: 12.5px;">@log.Action</td>
                            <td>
                                <div>
                                    <span style="font-family: monospace; font-weight: 700; color: #4f46e5; font-size: 12px;">@log.EntityCode</span>
                                    @if (!string.IsNullOrEmpty(log.EntityType))
                                    {
                                        <span style="display: block; font-size: 10px; color: #94a3b8; font-weight: 600; margin-top: 1px;">@log.EntityType</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(log.PreviousStatus) || !string.IsNullOrEmpty(log.NewStatus))
                                {
                                    <div style="display: flex; align-items: center; gap: 5px; font-family: monospace; font-size: 11px;">
                                        @if (!string.IsNullOrEmpty(log.PreviousStatus))
                                        {
                                            <span style="padding: 2px 6px; border-radius: 4px; background: #f1f5f9; color: #475569;">@log.PreviousStatus</span>
                                        }
                                        @if (!string.IsNullOrEmpty(log.PreviousStatus) && !string.IsNullOrEmpty(log.NewStatus))
                                        {
                                            <span style="color: #94a3b8;">→</span>
                                        }
                                        @if (!string.IsNullOrEmpty(log.NewStatus))
                                        {
                                            <span style="padding: 2px 6px; border-radius: 4px; background: #eef2ff; color: #4f46e5; font-weight: 700;">@log.NewStatus</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span style="color: #cbd5e1;">—</span>
                                }
                            </td>
                            <td style="max-width: 320px;">
                                <p style="font-size: 12px; color: #475569; line-height: 1.5; margin: 0;">@log.Details</p>
                                @if (!string.IsNullOrEmpty(log.Reason))
                                {
                                    <div style="margin-top: 5px; padding: 5px 8px; border-radius: 6px; background: #fffbeb; border: 1px solid #fde68a;">
                                        <span style="font-size: 11px; font-weight: 700; color: #92400e;">Lý do: </span>
                                        <span style="font-size: 11px; color: #78350f;">@log.Reason</span>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="pagination">
                @if (Model.CurrentPage > 1)
                {
                    <a href="?page=@(Model.CurrentPage-1)&search=@Model.SearchTerm&entityFilter=@Model.EntityFilter" class="page-link">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                }
                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    <a href="?page=@i&search=@Model.SearchTerm&entityFilter=@Model.EntityFilter"
                       class="page-link @(i == Model.CurrentPage ? "active" : "")">@i</a>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="?page=@(Model.CurrentPage+1)&search=@Model.SearchTerm&entityFilter=@Model.EntityFilter" class="page-link">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>
        }
        else
        {
            <div style="padding: 12px 20px; border-top: 1px solid #f1f5f9;">
                <span style="font-size: 11.5px; color: #94a3b8;">Hiển thị @Model.AuditLogs.Count / @Model.TotalCount bản ghi</span>
            </div>
        }
    </div>

</div>
