<!-- MODAL: BÁO CÁO SỰ CỐ MÁY MÓC / THIẾT BỊ (Production Staff) -->
@if (Model.CanReportFailure)
{
    <div class="modal fade" id="reportFailureModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 16px; border: 1px solid #e1e5da; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
                <form method="post" asp-page-handler="ReportFailure">
                    <div class="modal-header" style="border-bottom: 1px solid #efefe7; padding: 18px 24px;">
                        <div>
                            <h5 class="modal-title" style="font-size: 16px; font-weight: 800; color: #94473e;">
                                <i class="bi bi-exclamation-triangle-fill" style="margin-right: 8px;"></i>Báo cáo Sự cố Máy móc
                            </h5>
                            <p style="font-size: 12px; color: #7a887f; margin-bottom: 0;">Ghi nhận sự cố thiết bị dây chuyền sản xuất để điều động kỹ thuật viên</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body" style="padding: 24px;">
                        <div class="mb-3">
                            <label class="form-label" style="font-size: 12px; font-weight: 700; color: #243d35;">Thiết bị / Máy móc gặp sự cố <span style="color: #a55449;">*</span></label>
                            <select asp-for="FailureMachineId" class="form-select" required style="font-size: 12.5px; border-radius: 8px;">
                                <option value="0">-- Chọn máy móc dây chuyền --</option>
                                @foreach (var m in Model.AvailableMachines)
                                {
                                    <option value="@m.MachineId">@m.MachineCode - @m.MachineName (@m.ProcessName)</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" style="font-size: 12px; font-weight: 700; color: #243d35;">Mức độ nghiêm trọng <span style="color: #a55449;">*</span></label>
                            <select asp-for="FailureSeverity" class="form-select" style="font-size: 12.5px; border-radius: 8px;">
                                <option value="Critical">Khẩn cấp — Dừng toàn bộ chuyền sản xuất</option>
                                <option value="High" selected>Mức độ cao — Nguy cơ hỏng cụm máy chính</option>
                                <option value="Medium">Trung bình — Hoạt động rung giật, giảm tải</option>
                                <option value="Low">Thấp — Cần kiểm tra bảo dưỡng định kỳ</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" style="font-size: 12px; font-weight: 700; color: #243d35;">Hiện tượng / Triệu chứng hư hỏng <span style="color: #a55449;">*</span></label>
                            <textarea asp-for="FailureSymptoms" class="form-control" rows="3" required placeholder="Ví dụ: Rung lắc mạnh ở ổ bi chính trục lăn, nhiệt độ gối đỡ tăng quá 85°C..." style="font-size: 12px; border-radius: 10px;"></textarea>
                        </div>

                        <div>
                            <label class="form-label" style="font-size: 12px; font-weight: 700; color: #52675d;">Ghi chú thêm</label>
                            <textarea asp-for="FailureDescription" class="form-control" rows="2" placeholder="Thời điểm bắt đầu phát sinh, biện pháp sơ bộ đã xử lý..." style="font-size: 12px; border-radius: 8px;"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid #efefe7; padding: 14px 24px; display: flex; justify-content: flex-end; gap: 10px;">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 8px; font-size: 12px;">Hủy bỏ</button>
                        <button type="submit" class="btn btn-danger" style="border-radius: 8px; font-size: 12px; font-weight: 700;">
                            <i class="bi bi-send-exclamation"></i> Gửi báo cáo sự cố
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function openRequestDetailModal(id, code, equip, symptoms, priority, reporter, technician, reqDate, status, compNote, rejReason, canManage) {
            document.getElementById('modalReqCode').innerText = code;
            document.getElementById('modalReqEquipment').innerText = equip;
            document.getElementById('modalReqReporter').innerText = reporter;
            document.getElementById('modalReqDate').innerText = reqDate;
            document.getElementById('modalReqTechnician').innerText = technician && technician.trim() !== '' ? technician : 'Chưa phân công';
            document.getElementById('modalReqSymptoms').innerText = symptoms;

            // Priority badge
            var priBadge = document.getElementById('modalReqPriorityBadge');
            if (priority.toLowerCase() === 'critical') {
                priBadge.innerHTML = '<span class="badge" style="background: #f1e2da; color: #88473f; border: 1px solid #d6aaa0; font-size: 11px;">Nghiêm trọng</span>';
            } else if (priority.toLowerCase() === 'high') {
                priBadge.innerHTML = '<span class="badge" style="background: #f4ead8; color: #865b35; border: 1px solid #dec5a0; font-size: 11px;">Mức độ cao</span>';
            } else {
                priBadge.innerHTML = '<span class="badge" style="background: #efefe7; color: #52675d; border: 1px solid #e1e5da; font-size: 11px;">Bình thường</span>';
            }

            // Status badge
            var statBadge = document.getElementById('modalReqStatusBadge');
            var isPending = (status.toLowerCase() === 'pending' || status.toLowerCase() === 'reported');
            var isInProgress = (status.toLowerCase() === 'inprogress' || status.toLowerCase() === 'assigned');
            var isCompleted = (status.toLowerCase() === 'completed');
            var isRejected = (status.toLowerCase() === 'rejected');

            if (isCompleted) {
                statBadge.innerHTML = '<span class="badge" style="background: #e2eee4; color: #356e51; border: 1px solid #c6dbc9; font-size: 11px;">Đã hoàn thành</span>';
            } else if (isInProgress) {
                statBadge.innerHTML = '<span class="badge" style="background: #e1ebe2; color: #254e43; border: 1px solid #c7d8cc; font-size: 11px;">Đang sửa chữa</span>';
            } else if (isRejected) {
                statBadge.innerHTML = '<span class="badge" style="background: #f1e2da; color: #94473e; border: 1px solid #e4c8bf; font-size: 11px;">Đã từ chối</span>';
            } else {
                statBadge.innerHTML = '<span class="badge" style="background: #f2e9cb; color: #8e6a2c; border: 1px solid #e5d6a9; font-size: 11px;">Chờ tiếp nhận</span>';
            }

            // Complete note box
            var compBox = document.getElementById('modalReqCompleteBox');
            if (compNote && compNote.trim() !== '') {
                compBox.style.display = 'block';
                document.getElementById('modalReqCompletionNote').innerText = compNote;
            } else {
                compBox.style.display = 'none';
            }

            // Rejection reason box
            var rejBox = document.getElementById('modalReqRejectBox');
            if (rejReason && rejReason.trim() !== '') {
                rejBox.style.display = 'block';
                document.getElementById('modalReqRejectionReason').innerText = rejReason;
            } else {
                rejBox.style.display = 'none';
            }

            // Actions container
            var actionBtnContainer = document.getElementById('modalReqActionButtons');
            actionBtnContainer.innerHTML = '';
            if (canManage) {
                if (isPending) {
                    actionBtnContainer.innerHTML = `
                        <button type="button" class="btn btn-outline-danger" onclick="closeDetailAndOpenReject(${id}, '${code}')" style="border-radius: 8px; font-size: 12px; font-weight: 600;">
                            <i class="bi bi-x-circle"></i> Từ chối
                        </button>
                        <button type="button" class="btn btn-primary" onclick="closeDetailAndOpenAssign(${id}, '${code}', '${equip}', '${priority}')" style="border-radius: 8px; font-size: 12px; font-weight: 700;">
                            <i class="bi bi-person-plus"></i> Phân công Kỹ thuật
                        </button>
                    `;
                } else if (isInProgress) {
                    actionBtnContainer.innerHTML = `
                        <button type="button" class="btn btn-success" onclick="closeDetailAndOpenComplete(${id}, '${code}', '${equip}')" style="border-radius: 8px; font-size: 12px; font-weight: 700;">
                            <i class="bi bi-check2-circle"></i> Nghiệm thu Hoàn thành
                        </button>
                    `;
                }
            }

            var modal = new bootstrap.Modal(document.getElementById('requestDetailModal'));
            modal.show();
        }

        function closeDetailAndOpenAssign(id, code, equip, pri) {
            var detailModal = bootstrap.Modal.getInstance(document.getElementById('requestDetailModal'));
            if (detailModal) detailModal.hide();
            openAssignModal(id, code, equip, pri);
        }

        function closeDetailAndOpenComplete(id, code, equip) {
            var detailModal = bootstrap.Modal.getInstance(document.getElementById('requestDetailModal'));
            if (detailModal) detailModal.hide();
            openCompleteModal(id, code, equip);
        }

        function closeDetailAndOpenReject(id, code) {
            var detailModal = bootstrap.Modal.getInstance(document.getElementById('requestDetailModal'));
            if (detailModal) detailModal.hide();
            openRejectModal(id, code);
        }

        function openAssignModal(id, code, equip, priority) {
            document.getElementById('assignModalRequestId').value = id;
            document.getElementById('assignModalReqCode').innerText = code;
            document.getElementById('assignModalEquipment').innerText = equip;
            if (priority) {
                document.getElementById('assignModalPriority').value = priority;
            }
            var modal = new bootstrap.Modal(document.getElementById('assignStaffModal'));
            modal.show();
        }

        function openCompleteModal(id, code, equip) {
            document.getElementById('completeModalRequestId').value = id;
            document.getElementById('completeModalReqCode').innerText = code;
            document.getElementById('completeModalEquipment').innerText = equip;
            var modal = new bootstrap.Modal(document.getElementById('completeRequestModal'));
            modal.show();
        }

        function openRejectModal(id, code) {
            document.getElementById('rejectReqModalId').value = id;
            document.getElementById('rejectReqModalCode').innerText = code;
            var modal = new bootstrap.Modal(document.getElementById('rejectRequestModal'));
            modal.show();
        }

        function openReportFailureModal() {
            var modalEl = document.getElementById('reportFailureModal');
            if (modalEl) {
                var modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        }
    </script>
}
