@page
@model BATT_PPMS.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Quản trị Tài khoản & Phân quyền";
    ViewData["ActivePage"] = "Users";
}

<!-- Header -->
<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title fs-3 fw-bold text-dark mb-1">
            <i class="bi bi-person-gear text-primary me-2"></i>Quản trị Tài khoản &amp; Phân quyền
        </h1>
        <p class="text-muted mb-0">Quản lý tài khoản 8 vai trò hệ thống, chính sách bảo mật và trạng thái khóa/mở khóa</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary px-3 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
            <i class="bi bi-plus-lg me-1"></i> Tạo tài khoản người dùng
        </button>
    </div>
</div>

<!-- Banner Chính sách Cách ly Quản trị (Admin Isolation) -->
<div class="card border-0 mb-4 shadow-sm" style="background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%); border-left: 4px solid #2563eb !important;">
    <div class="card-body py-3 px-4">
        <div class="d-flex align-items-start gap-3">
            <div class="text-primary fs-3 mt-1">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <h6 class="fw-bold text-primary mb-1">Chính sách Cách ly Quản trị (Admin Isolation)</h6>
                <p class="text-secondary small mb-0" style="line-height: 1.5;">
                    Admin chỉ quản trị tài khoản người dùng và kiểm tra tính toàn vẹn hệ thống. Quyền Admin không bao gồm xem dữ liệu tài chính, doanh thu, giá bán hoặc thao tác phê duyệt nghiệp vụ sản xuất.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Alerts -->
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Thanh Tìm kiếm & Bộ lọc -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="Keyword" class="form-control border-start-0 ps-0"
                           placeholder="Tìm kiếm theo tên tài khoản, họ tên, email..." value="@Model.Keyword" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="RoleFilter" class="form-select">
                    <option value="">-- Tất cả vai trò --</option>
                    @foreach (var r in Model.RolesList)
                    {
                        <option value="@r.RoleId" selected="@(Model.RoleFilter == r.RoleId)">
                            @r.RoleName
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="StatusFilter" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Active" selected="@(Model.StatusFilter == "Active")">Đang hoạt động</option>
                    <option value="Locked" selected="@(Model.StatusFilter == "Locked")">Đã khóa</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">
                    <i class="bi bi-filter"></i> Lọc
                </button>
                @if (!string.IsNullOrEmpty(Model.Keyword) || Model.RoleFilter.HasValue || !string.IsNullOrEmpty(Model.StatusFilter))
                {
                    <a asp-page="/Admin/Users/Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách tài khoản -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #f8fafc; font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b;">
                    <tr>
                        <th class="ps-4 py-3" style="width: 160px;">Tài khoản</th>
                        <th class="py-3">Họ và tên</th>
                        <th class="py-3">Email</th>
                        <th class="py-3">Số điện thoại</th>
                        <th class="py-3">Vai trò nghiệp vụ</th>
                        <th class="py-3 text-center" style="width: 140px;">Trạng thái</th>
                        <th class="py-3 text-end pe-4" style="width: 260px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (!Model.UsersList.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Không tìm thấy tài khoản nào khớp với bộ lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model.UsersList)
                        {
                            var rName = user.Role?.RoleName ?? "Chưa gán";
                            bool isOwnerUser = rName.Equals("Owner", StringComparison.OrdinalIgnoreCase);
                            bool isActive = user.Status == "Active";

                            <tr>
                                <!-- Cột 1: Tài khoản -->
                                <td class="ps-4">
                                    <span class="badge font-monospace px-2 py-1" style="background-color: #f1f5f9; color: #334155; font-size: 12.5px; border: 1px solid #e2e8f0;">
                                        @user.Username
                                    </span>
                                </td>

                                <!-- Cột 2: Họ và tên -->
                                <td>
                                    <div class="fw-bold text-dark">@user.FullName</div>
                                </td>

                                <!-- Cột 3: Email -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(user.Email))
                                    {
                                        <span class="text-secondary small">@user.Email</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">—</span>
                                    }
                                </td>

                                <!-- Cột 4: Số điện thoại -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(user.Phone))
                                    {
                                        <span class="text-secondary small font-monospace">@user.Phone</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">—</span>
                                    }
                                </td>

                                <!-- Cột 5: Vai trò nghiệp vụ -->
                                <td>
                                    @{
                                        string roleBadgeStyle;
                                        string roleIcon;

                                        switch (rName.ToLower())
                                        {
                                            case "owner":
                                                roleBadgeStyle = "background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a;";
                                                roleIcon = "bi-star-fill";
                                                break;
                                            case "manager":
                                                roleBadgeStyle = "background-color: #ede9fe; color: #5b21b6; border: 1px solid #ddd6fe;";
                                                roleIcon = "bi-briefcase-fill";
                                                break;
                                            case "admin":
                                                roleBadgeStyle = "background-color: #fae8ff; color: #86198f; border: 1px solid #f5d0fe;";
                                                roleIcon = "bi-shield-shaded";
                                                break;
                                            case "qc staff":
                                                roleBadgeStyle = "background-color: #d1fae5; color: #065f46; border: 1px solid #a7f3d0;";
                                                roleIcon = "bi-patch-check-fill";
                                                break;
                                            case "purchasing staff":
                                                roleBadgeStyle = "background-color: #e0f2fe; color: #075985; border: 1px solid #bae6fd;";
                                                roleIcon = "bi-cart-check-fill";
                                                break;
                                            case "maintenance staff":
                                                roleBadgeStyle = "background-color: #ffedd5; color: #9a3412; border: 1px solid #fed7aa;";
                                                roleIcon = "bi-tools";
                                                break;
                                            default:
                                                roleBadgeStyle = "background-color: #f1f5f9; color: #475569; border: 1px solid #e2e8f0;";
                                                roleIcon = "bi-person-badge";
                                                break;
                                        }
                                    }
                                    <span class="badge d-inline-flex align-items-center gap-1 px-2 py-1" style="@roleBadgeStyle font-size: 12px; font-weight: 600;">
                                        <i class="bi @roleIcon"></i> @rName
                                    </span>
                                </td>

                                <!-- Cột 6: Trạng thái -->
                                <td class="text-center">
                                    @if (isActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill" style="font-size: 11.5px;">
                                            ● Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill" style="font-size: 11.5px;">
                                            ● Đã khóa
                                        </span>
                                    }
                                </td>

                                <!-- Cột 7: Thao tác -->
                                <td class="text-end pe-4">
                                    @if (isOwnerUser)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1" style="font-size: 11.5px;">
                                            <i class="bi bi-shield-fill-check me-1"></i>Bảo vệ (Owner)
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <!-- Khóa/Mở khóa -->
                                            <form method="post" asp-page-handler="ToggleStatus" style="display:inline;"
                                                  onsubmit="return confirm('Bạn có chắc muốn @(isActive ? "KHÓA" : "MỞ KHÓA") tài khoản @user.Username?');">
                                                <input type="hidden" name="userId" value="@user.UserId" />
                                                @if (isActive)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-danger px-2" title="Khóa tài khoản này">
                                                        <i class="bi bi-lock"></i> Khóa
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success px-2" title="Mở khóa tài khoản">
                                                        <i class="bi bi-unlock"></i> Mở
                                                    </button>
                                                }
                                            </form>

                                            <!-- Đổi vai trò -->
                                            <button type="button" class="btn btn-sm btn-outline-secondary px-2" title="Đổi vai trò nghiệp vụ"
                                                    data-bs-toggle="modal" data-bs-target="#editRoleModal-@user.UserId">
                                                <i class="bi bi-person-gear"></i> Vai trò
                                            </button>

                                            <!-- Đặt lại mật khẩu -->
                                            <button type="button" class="btn btn-sm btn-outline-warning px-2" title="Đặt lại mật khẩu"
                                                    data-bs-toggle="modal" data-bs-target="#resetPassModal-@user.UserId">
                                                <i class="bi bi-key"></i> Đổi MK
                                            </button>
                                        </div>

                                        <!-- Modal Đổi vai trò -->
                                        <div class="modal fade" id="editRoleModal-@user.UserId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered text-start">
                                                <div class="modal-content border-0 shadow">
                                                    <form method="post" asp-page-handler="UpdateRole">
                                                        <input type="hidden" name="userId" value="@user.UserId" />
                                                        <div class="modal-header bg-light">
                                                            <h5 class="modal-title fw-bold">
                                                                <i class="bi bi-person-gear me-2 text-primary"></i>Phân quyền vai trò: @user.Username
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body p-4">
                                                            <div class="mb-3">
                                                                <label class="form-label text-muted small fw-bold">Họ và tên nhân sự</label>
                                                                <input type="text" class="form-control bg-light" value="@user.FullName" disabled />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Chọn vai trò mới <span class="text-danger">*</span></label>
                                                                <select name="newRoleId" class="form-select" required>
                                                                    @foreach (var r in Model.RolesList)
                                                                    {
                                                                        <option value="@r.RoleId" selected="@(r.RoleId == user.RoleId)">
                                                                            @r.RoleName
                                                                        </option>
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer bg-light">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                            <button type="submit" class="btn btn-primary fw-semibold">Lưu thay đổi</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Modal Đặt lại mật khẩu -->
                                        <div class="modal fade" id="resetPassModal-@user.UserId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered text-start">
                                                <div class="modal-content border-0 shadow">
                                                    <form method="post" asp-page-handler="ResetPassword">
                                                        <input type="hidden" name="userId" value="@user.UserId" />
                                                        <div class="modal-header bg-light">
                                                            <h5 class="modal-title fw-bold">
                                                                <i class="bi bi-key-fill me-2 text-warning"></i>Đặt lại mật khẩu: @user.Username
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body p-4">
                                                            <p class="text-secondary small mb-3">
                                                                Cấp mật khẩu mới trực tiếp cho nhân viên <strong>@user.FullName</strong> (@user.Username):
                                                            </p>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Mật khẩu mới (tối thiểu 6 ký tự) <span class="text-danger">*</span></label>
                                                                <input type="text" name="newPassword" class="form-control" value="123456" required minlength="6" />
                                                                <small class="text-muted">Gợi ý: <code>123456</code></small>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer bg-light">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                            <button type="submit" class="btn btn-warning fw-semibold">Xác nhận đặt lại</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Tạo Tài Khoản Người Dùng Mới (Giống hệt batt-ppms.ai.studio) -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form method="post" asp-page-handler="CreateUser">
                <div class="modal-header border-bottom py-3 px-4" style="background-color: #f8fafc;">
                    <h5 class="modal-title fw-bold text-dark fs-5">
                        <i class="bi bi-person-plus-fill me-2 text-primary"></i>Cấp Tài khoản Người dùng Mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.5px; color: #475569;">
                            Tên đăng nhập <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="username" class="form-control" placeholder="vd: nguyenvan_a" required autofocus />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.5px; color: #475569;">
                            Vai trò được cấp <span class="text-danger">*</span>
                        </label>
                        <select name="roleId" class="form-select" required>
                            @foreach (var r in Model.RolesList)
                            {
                                <option value="@r.RoleId">@r.RoleName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.5px; color: #475569;">
                            Họ và tên nhân viên <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="fullName" class="form-control" placeholder="vd: Nguyễn Văn A" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.5px; color: #475569;">
                            Email công ty
                        </label>
                        <input type="email" name="email" class="form-control" placeholder="vd: a.nv@battenergy.vn" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.5px; color: #475569;">
                            Số điện thoại
                        </label>
                        <input type="tel" name="phone" class="form-control" placeholder="vd: 0903.xxx.xxx" />
                    </div>

                    <!-- Mật khẩu mặc định ẩn bên dưới kèm thông báo -->
                    <input type="hidden" name="password" value="123456" />

                    <!-- Khung ghi chú mật khẩu mặc định -->
                    <div class="p-3 rounded-2" style="background-color: #f8fafc; border: 1px dashed #cbd5e1;">
                        <div class="d-flex align-items-center gap-2 text-muted small">
                            <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                            <span>Mật khẩu khởi tạo ban đầu là <strong>123456</strong>. Người dùng có thể tự thay đổi mật khẩu trong mục Hồ sơ cá nhân sau khi đăng nhập.</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4" style="background-color: #f8fafc;">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Xác nhận Tạo tài khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
