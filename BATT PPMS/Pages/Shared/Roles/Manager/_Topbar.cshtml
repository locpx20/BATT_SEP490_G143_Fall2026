@model BATT_PPMS.Helpers.RoleHeaderViewModel
<div class="role-switch-badge" title="Chuyển đổi vai trò">
                    <i class="bi bi-person-gear"></i>
                    <span>Đổi vai trò: <strong>@Model.RoleDisplay</strong></span>
                    <i class="bi bi-chevron-down"></i>
                </div>
<div class="topbar-bell-btn" title="Thông báo">
                <i class="bi bi-bell"></i>
            </div>

            <div class="topbar-user">
                <div class="user-avatar-circle">@Model.Initials</div>
                <div class="d-none d-sm-block">
                    <div class="user-display-name">@Model.FullName</div>
                    <div class="user-display-role">@Model.RoleDisplay</div>
                </div>
                <i class="bi bi-chevron-down user-chevron"></i>
            </div>

            <a href="/Auth/Logout" class="btn-logout" title="Đăng xuất">
                <i class="bi bi-box-arrow-right"></i>
            </a>
